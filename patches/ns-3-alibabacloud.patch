+void
+LogicalProcess::ProcessOneRoundWithFaultBarrier ()
+{
+  NS_LOG_FUNCTION (this);
+
+  // Fault barriers are public-LP events that intentionally precede private
+  // events at the same timestamp.  Keep the established inclusive rule for
+  // both lookahead and ordinary-public bounds; use a strict bound only when
+  // the dedicated fault timestamp is the bound that stops this LP.
+  MtpInterface::SetSystem (m_systemId);
+  Time ordinaryGrantedTime =
+      Min (MtpInterface::GetSmallestTime () + m_lookAhead,
+           MtpInterface::GetNextPublicTime ());
+  Time faultBarrierTime = MtpInterface::GetNextFaultBarrierTime ();
+  bool stoppedByFaultBarrier = faultBarrierTime <= ordinaryGrantedTime;
+  Time grantedTime = stoppedByFaultBarrier ? faultBarrierTime : ordinaryGrantedTime;
+
+  auto start = std::chrono::system_clock::now ();
+
+  while ((stoppedByFaultBarrier && Next () < grantedTime) ||
+         (!stoppedByFaultBarrier && Next () <= grantedTime))
+    {
+      Scheduler::Event next = m_events->RemoveNext ();
+      m_eventCount++;
+      NS_LOG_LOGIC ("handle " << next.key.m_ts);
+
+      m_currentTs = next.key.m_ts;
+      m_currentContext = next.key.m_context;
+      m_currentUid = next.key.m_uid;
+
+      next.impl->Invoke ();
+      next.impl->Unref ();
+    }
+
+  auto end = std::chrono::system_clock::now ();
+  m_executionTime = std::chrono::duration_cast<std::chrono::nanoseconds> (end - start).count ();
+}
