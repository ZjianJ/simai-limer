@@ -0,0 +1,74 @@
+#ifndef LIMER_CONGESTION_SIGNAL_H
+#define LIMER_CONGESTION_SIGNAL_H
+
+#include <cstdint>
+
+namespace ns3 {
+
+enum LimerCongestionSignalType : uint8_t {
+  LIMER_SIGNAL_ECN_MARK = 1,
+  LIMER_SIGNAL_CNP_ACK_EMIT = 2,
+  LIMER_SIGNAL_CNP_ACK_RX = 3,
+  LIMER_SIGNAL_QP_RATE_DECREASE = 4,
+  LIMER_SIGNAL_PFC_PAUSE_SEND = 5,
+  LIMER_SIGNAL_PFC_PAUSE_RECEIVE = 6,
+  LIMER_SIGNAL_PFC_RESUME_SEND = 7,
+  LIMER_SIGNAL_PFC_RESUME_RECEIVE = 8,
+};
+
+// A mechanism event emitted only at the real data-plane state transition.
+// Validity bits keep zero representable and prevent consumers from inventing
+// unavailable queue/QP context.
+struct LimerCongestionSignalEvent {
+  uint64_t timestamp_ns = 0;
+  uint8_t event_type = 0;
+  uint32_t node_id = 0;
+  uint32_t node_type = 0;
+  uint32_t port_id = 0;
+  bool has_trigger_out_port = false;
+  uint32_t trigger_out_port = 0;
+  uint16_t pg = 0;
+
+  bool has_flow = false;
+  uint32_t flow_src = 0;
+  uint32_t flow_dst = 0;
+  uint16_t flow_sport = 0;
+  uint16_t flow_dport = 0;
+  bool has_packet_tuple = false;
+  uint32_t packet_sip = 0;
+  uint32_t packet_dip = 0;
+  uint16_t packet_sport = 0;
+  uint16_t packet_dport = 0;
+
+  bool has_queue_state = false;
+  uint64_t queue_bytes = 0;
+  bool has_threshold_state = false;
+  bool has_shared_state = false;
+  bool has_headroom_state = false;
+  uint64_t shared_used_bytes = 0;
+  uint64_t threshold_low_bytes = 0;
+  uint64_t threshold_high_bytes = 0;
+  uint64_t headroom_bytes = 0;
+
+  uint32_t signal_before = 0;
+  uint32_t signal_after = 0;
+  uint32_t pause_time = 0;
+  bool has_rate = false;
+  uint64_t old_rate_bps = 0;
+  uint64_t new_rate_bps = 0;
+  uint32_t cc_mode = 0;
+};
+
+typedef void (*LimerCongestionSignalSink)(
+    const LimerCongestionSignalEvent&, void*);
+
+bool RegisterLimerCongestionSignalSink(
+    LimerCongestionSignalSink sink, void* context);
+bool ClearLimerCongestionSignalSink(
+    LimerCongestionSignalSink sink, void* context);
+bool HasLimerCongestionSignalSink();
+void EmitLimerCongestionSignal(const LimerCongestionSignalEvent& event);
+
+}  // namespace ns3
+
+#endif
diff --git a/simulation/src/point-to-point/model/limer-route-choice.cc b/simulation/src/point-to-point/model/limer-route-choice.cc
new file mode 100644
index 0000000..705fa20
--- /dev/null
+++ b/simulation/src/point-to-point/model/limer-route-choice.cc
@@ -0,0 +1,108 @@
+#include "limer-route-choice.h"
+
+#include <atomic>
+#include <mutex>
+
+namespace ns3 {
+namespace {
+
+std::atomic<LimerRouteChoiceSink> g_limerRouteChoiceSink(nullptr);
+std::atomic<void*> g_limerRouteChoiceContext(nullptr);
+std::atomic<uint64_t> g_limerRouteChoiceMaxEvents(0);
+std::atomic<uint64_t> g_limerRouteChoiceSeen(0);
+std::atomic<uint64_t> g_limerRouteChoiceRecorded(0);
+std::atomic<uint64_t> g_limerRouteChoiceDeduplicated(0);
+std::atomic<uint64_t> g_limerRouteChoiceOverflow(0);
+std::mutex g_limerRouteChoiceRegistrationMutex;
+
+}  // namespace
+
+bool RegisterLimerRouteChoiceSink(
+    LimerRouteChoiceSink sink, void* context, uint64_t max_events) {
+  if (sink == nullptr || max_events == 0 || max_events > 10000000ULL) {
+    return false;
+  }
+  std::lock_guard<std::mutex> guard(g_limerRouteChoiceRegistrationMutex);
+  if (g_limerRouteChoiceSink.load(std::memory_order_acquire) != nullptr) {
+    return false;
+  }
+  g_limerRouteChoiceMaxEvents.store(max_events, std::memory_order_relaxed);
+  g_limerRouteChoiceSeen.store(0, std::memory_order_relaxed);
+  g_limerRouteChoiceRecorded.store(0, std::memory_order_relaxed);
+  g_limerRouteChoiceDeduplicated.store(0, std::memory_order_relaxed);
+  g_limerRouteChoiceOverflow.store(0, std::memory_order_relaxed);
+  g_limerRouteChoiceContext.store(context, std::memory_order_relaxed);
+  g_limerRouteChoiceSink.store(sink, std::memory_order_release);
+  return true;
+}
+
+bool ClearLimerRouteChoiceSink(LimerRouteChoiceSink sink, void* context) {
+  std::lock_guard<std::mutex> guard(g_limerRouteChoiceRegistrationMutex);
+  if (sink == nullptr ||
+      g_limerRouteChoiceSink.load(std::memory_order_acquire) != sink ||
+      g_limerRouteChoiceContext.load(std::memory_order_acquire) != context) {
+    return false;
+  }
+  // Simulator workers are quiescent before the frontend clears the sink.
+  // Publish the null sink first so no subsequent emitter can consume the
+  // context that is about to be cleared.
+  g_limerRouteChoiceSink.store(nullptr, std::memory_order_release);
+  g_limerRouteChoiceContext.store(nullptr, std::memory_order_release);
+  return true;
+}
+
+bool HasLimerRouteChoiceSink() {
+  return g_limerRouteChoiceSink.load(std::memory_order_acquire) != nullptr;
+}
+
+void EmitLimerRouteChoice(const LimerRouteChoiceEvent& event) {
+  LimerRouteChoiceSink sink =
+      g_limerRouteChoiceSink.load(std::memory_order_acquire);
+  if (sink == nullptr) return;
+  void* context = g_limerRouteChoiceContext.load(std::memory_order_acquire);
+  sink(event, context);
+}
+
+LimerRouteChoiceCounters GetLimerRouteChoiceCounters() {
+  return LimerRouteChoiceCounters{
+      g_limerRouteChoiceMaxEvents.load(std::memory_order_relaxed),
+      g_limerRouteChoiceSeen.load(std::memory_order_relaxed),
+      g_limerRouteChoiceRecorded.load(std::memory_order_relaxed),
+      g_limerRouteChoiceDeduplicated.load(std::memory_order_relaxed),
+      g_limerRouteChoiceOverflow.load(std::memory_order_relaxed)};
+}
+
+bool EmitLimerRouteChoiceOnce(
+    std::set<LimerRouteChoiceKey>* observed,
+    const LimerRouteChoiceEvent& event) {
+  if (observed == nullptr || !HasLimerRouteChoiceSink()) return false;
+  g_limerRouteChoiceSeen.fetch_add(1, std::memory_order_relaxed);
+  const LimerRouteChoiceKey key = LimerRouteChoiceKey::From(event);
+  if (observed->find(key) != observed->end()) {
+    g_limerRouteChoiceDeduplicated.fetch_add(1, std::memory_order_relaxed);
+    return false;
+  }
+
+  uint64_t recorded =
+      g_limerRouteChoiceRecorded.load(std::memory_order_relaxed);
+  const uint64_t cap =
+      g_limerRouteChoiceMaxEvents.load(std::memory_order_relaxed);
+  while (recorded < cap &&
+         !g_limerRouteChoiceRecorded.compare_exchange_weak(
+             recorded, recorded + 1, std::memory_order_relaxed,
+             std::memory_order_relaxed)) {
+  }
+  if (recorded >= cap) {
+    g_limerRouteChoiceOverflow.fetch_add(1, std::memory_order_relaxed);
+    LimerRouteChoiceEvent overflow = event;
+    overflow.evidence_overflow = true;
+    EmitLimerRouteChoice(overflow);
+    return false;
+  }
+
+  observed->insert(key);
+  EmitLimerRouteChoice(event);
+  return true;
+}
+
+}  // namespace ns3
diff --git a/simulation/src/point-to-point/model/limer-route-choice.h b/simulation/src/point-to-point/model/limer-route-choice.h
new file mode 100644
index 0000000..c6beb9d
--- /dev/null
+++ b/simulation/src/point-to-point/model/limer-route-choice.h
@@ -0,0 +1,192 @@
+#ifndef LIMER_ROUTE_CHOICE_H
+#define LIMER_ROUTE_CHOICE_H
+
+#include <cstdint>
+#include <set>
+#include <tuple>
+#include <vector>
+
+namespace ns3 {
+
+enum LimerRouteDirection : uint8_t {
+  LIMER_ROUTE_DATA = 1,
+  LIMER_ROUTE_ACK = 2,
+  LIMER_ROUTE_NACK = 3,
+};
+
+static const uint16_t LIMER_ROUTE_BACKGROUND_SPORT_MIN = 49152;
+static const uint16_t LIMER_ROUTE_BACKGROUND_SPORT_MAX = 65535;
+
+inline uint32_t LimerNodeIdFromIpv4(uint32_t address) {
+  return (address >> 8) & 0xffff;
+}
+
+// One decision made by the live forwarding path.  packet_* is the exact wire
+// tuple consumed by the switch hash.  flow_* is the normalized sender QP
+// identity, so reverse ACK/NACK choices can be joined to the same schedule.
+struct LimerRouteChoiceEvent {
+  uint64_t timestamp_ns = 0;
+  uint32_t node_id = 0;
+  uint32_t node_type = 0;
+  uint32_t packet_sip = 0;
+  uint32_t packet_dip = 0;
+  uint16_t packet_sport = 0;
+  uint16_t packet_dport = 0;
+  uint16_t pg = 0;
+  uint8_t l3_protocol = 0;
+  uint8_t direction = 0;
+  uint32_t flow_src = 0;
+  uint32_t flow_dst = 0;
+  uint16_t flow_sport = 0;
+  uint16_t flow_dport = 0;
+  uint32_t ecmp_seed = 0;
+  uint32_t ecmp_hash = 0;
+  uint32_t candidate_count = 0;
+  uint32_t bucket = 0;
+  uint32_t egress_port = 0;
+  // Internal control record.  It is delivered to the registered sink when
+  // the global evidence cap is exhausted and must never be serialized as a
+  // normal route-selection row.
+  bool evidence_overflow = false;
+};
+
+struct LimerRouteChoiceCounters {
+  uint64_t max_events = 0;
+  uint64_t seen = 0;
+  uint64_t recorded = 0;
+  uint64_t deduplicated = 0;
+  uint64_t overflow = 0;
+};
+
+struct LimerRouteChoiceKey {
+  uint32_t packet_sip;
+  uint32_t packet_dip;
+  uint16_t packet_sport;
+  uint16_t packet_dport;
+  uint16_t pg;
+  uint8_t l3_protocol;
+  uint8_t direction;
+  uint32_t flow_src;
+  uint32_t flow_dst;
+  uint16_t flow_sport;
+  uint16_t flow_dport;
+  uint32_t ecmp_seed;
+  uint32_t ecmp_hash;
+  uint32_t candidate_count;
+  uint32_t bucket;
+  uint32_t egress_port;
+
+  static LimerRouteChoiceKey From(const LimerRouteChoiceEvent& event) {
+    return {
+        event.packet_sip, event.packet_dip,
+        event.packet_sport, event.packet_dport, event.pg,
+        event.l3_protocol, event.direction,
+        event.flow_src, event.flow_dst,
+        event.flow_sport, event.flow_dport,
+        event.ecmp_seed, event.ecmp_hash, event.candidate_count,
+        event.bucket, event.egress_port};
+  }
+
+  bool operator<(const LimerRouteChoiceKey& other) const {
+    return std::tie(
+               packet_sip, packet_dip, packet_sport, packet_dport, pg,
+               l3_protocol, direction, flow_src, flow_dst, flow_sport,
+               flow_dport, ecmp_seed, ecmp_hash, candidate_count, bucket,
+               egress_port) <
+           std::tie(
+               other.packet_sip, other.packet_dip, other.packet_sport,
+               other.packet_dport, other.pg, other.l3_protocol,
+               other.direction, other.flow_src, other.flow_dst,
+               other.flow_sport, other.flow_dport, other.ecmp_seed,
+               other.ecmp_hash, other.candidate_count, other.bucket,
+               other.egress_port);
+  }
+};
+
+struct LimerEcmpSelection {
+  bool ok = false;
+  uint32_t candidate_count = 0;
+  uint32_t bucket = 0;
+  uint32_t egress_port = 0;
+};
+
+// Populate the wire and normalized-flow portions of a route event.  DATA
+// carries the sender QP tuple directly.  ACK/NACK is generated by ReceiveUdp
+// with reversed IPs and swapped ports, so its dport is the original reserved
+// source port.  Returning false means this is not background RDMA traffic.
+inline bool LimerClassifyBackgroundRoute(
+    uint8_t l3_protocol, uint32_t packet_sip, uint32_t packet_dip,
+    uint16_t packet_sport, uint16_t packet_dport, uint16_t pg,
+    LimerRouteChoiceEvent* event) {
+  if (event == nullptr) return false;
+  if (l3_protocol == 0x11) {
+    if (packet_sport < LIMER_ROUTE_BACKGROUND_SPORT_MIN) {
+      return false;
+    }
+    event->direction = LIMER_ROUTE_DATA;
+    event->flow_src = LimerNodeIdFromIpv4(packet_sip);
+    event->flow_dst = LimerNodeIdFromIpv4(packet_dip);
+    event->flow_sport = packet_sport;
+    event->flow_dport = packet_dport;
+  } else if (l3_protocol == 0xFC || l3_protocol == 0xFD) {
+    if (packet_dport < LIMER_ROUTE_BACKGROUND_SPORT_MIN) {
+      return false;
+    }
+    event->direction =
+        l3_protocol == 0xFC ? LIMER_ROUTE_ACK : LIMER_ROUTE_NACK;
+    event->flow_src = LimerNodeIdFromIpv4(packet_dip);
+    event->flow_dst = LimerNodeIdFromIpv4(packet_sip);
+    event->flow_sport = packet_dport;
+    event->flow_dport = packet_sport;
+  } else {
+    return false;
+  }
+  event->packet_sip = packet_sip;
+  event->packet_dip = packet_dip;
+  event->packet_sport = packet_sport;
+  event->packet_dport = packet_dport;
+  event->pg = pg;
+  event->l3_protocol = l3_protocol;
+  return true;
+}
+
+// This helper is used by the actual forwarding path.  Tests exercise the
+// exact same bucket-to-vector-order operation rather than reimplementing it.
+inline LimerEcmpSelection LimerSelectEcmp(
+    uint32_t hash, const std::vector<int>& candidates) {
+  LimerEcmpSelection selection;
+  if (candidates.empty()) return selection;
+  selection.candidate_count = static_cast<uint32_t>(candidates.size());
+  selection.bucket = hash % selection.candidate_count;
+  const int egress = candidates[selection.bucket];
+  if (egress < 0) return selection;
+  selection.egress_port = static_cast<uint32_t>(egress);
+  selection.ok = true;
+  return selection;
+}
+
+typedef void (*LimerRouteChoiceSink)(const LimerRouteChoiceEvent&, void*);
+
+// Explicit registration keeps the point-to-point DSO independent of frontend
+// symbols.  Registration occurs before Simulator::Run and is immutable while
+// MTP worker threads emit choices.
+bool RegisterLimerRouteChoiceSink(
+    LimerRouteChoiceSink sink, void* context,
+    uint64_t max_events = 1000000);
+bool ClearLimerRouteChoiceSink(LimerRouteChoiceSink sink, void* context);
+bool HasLimerRouteChoiceSink();
+void EmitLimerRouteChoice(const LimerRouteChoiceEvent& event);
+LimerRouteChoiceCounters GetLimerRouteChoiceCounters();
+
+// The caller owns synchronization for observed.  Across every node-local set,
+// this records at most the cap supplied at sink registration.  A duplicate is
+// counted but neither stored nor emitted.  The first over-cap observation is
+// emitted as an evidence_overflow control record so the sink can persist its
+// fatal summary before terminating the run.
+bool EmitLimerRouteChoiceOnce(
+    std::set<LimerRouteChoiceKey>* observed,
+    const LimerRouteChoiceEvent& event);
+
+}  // namespace ns3
+
+#endif  // LIMER_ROUTE_CHOICE_H
