+void
+MtpInterface::ScheduleFaultBarrierEvent (Time const &delay, EventImpl *event)
+{
+  // Unlike Simulator::Schedule(), this narrow API enters MTP directly.  Make
+  // sure the selected SimulatorImpl (and therefore the initial public LP)
+  // exists even when a fault is the first event registered by an application.
+  const Time now = Simulator::Now ();
+  NS_ASSERT_MSG (event != nullptr, "Cannot schedule a null fault-barrier event");
+  NS_ASSERT_MSG (delay >= TimeStep (0), "Fault-barrier delay must be non-negative");
+  NS_ASSERT_MSG (g_systems != nullptr && GetSystem () == &g_systems[0],
+                 "Fault barriers must be registered from the public LP");
+
+  CriticalSection cs;
+  Time eventTime = now + delay;
+  FaultBarrierKey key (eventTime.GetTimeStep (), g_faultBarrierSequence++);
+  g_faultBarrierEvents.emplace (key, event);
+  RefreshNextFaultBarrierTime ();
+}
+
+void
+MtpInterface::RefreshNextFaultBarrierTime ()
+{
+  const uint64_t next = g_faultBarrierEvents.empty ()
+                            ? Time::Max ().GetTimeStep ()
+                            : g_faultBarrierEvents.begin ()->first.first;
+  g_nextFaultBarrierTimeStep.store (next, std::memory_order_release);
+}
+
+void
+MtpInterface::ClearFaultBarrierEvents ()
+{
+  CriticalSection cs;
+  for (auto &entry : g_faultBarrierEvents)
+    {
+      entry.second->Cancel ();
+      entry.second->Unref ();
+    }
+  g_faultBarrierEvents.clear ();
+  g_faultBarrierSequence = 0;
+  RefreshNextFaultBarrierTime ();
+}
