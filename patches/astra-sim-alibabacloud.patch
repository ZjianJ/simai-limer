+
+#ifndef LIMER_TRAINING_SOURCE_PORT_ALLOCATOR_H
+#define LIMER_TRAINING_SOURCE_PORT_ALLOCATOR_H
+
+#include <cstdint>
+#include <functional>
+#include <limits>
+#include <map>
+#include <mutex>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace limer {
+
+// Bounded source-port allocator for Astra/SimAI training QPs.
+//
+// A reservation remains active from SendFlow (before RdmaClient starts) until
+// RdmaHw has removed the completed QP from every egress group and m_qpMap.
+// Consequently a wrapped cursor can reuse a port only after Release(), never
+// merely because entry::qp_finish erased its flow-tag lookup.
+class TrainingSourcePortAllocator {
+ public:
+  struct Allocation {
+    bool ok = false;
+    uint16_t port = 0;
+    bool reused = false;
+    bool first_reuse_for_pair = false;
+    uint64_t allocation_ordinal = 0;
+    std::string error;
+  };
+
+  struct Snapshot {
+    uint64_t total_allocations = 0;
+    uint64_t total_releases = 0;
+    uint64_t total_reuses = 0;
+    uint64_t active_reservations = 0;
+    uint64_t peak_active_reservations = 0;
+    uint64_t pair_count = 0;
+    uint64_t pairs_with_reuse = 0;
+    uint64_t max_pair_allocations = 0;
+    uint64_t max_pair_reuses = 0;
+    uint64_t external_conflicts = 0;
+    uint64_t exhaustions = 0;
+    uint64_t invariant_errors = 0;
+    bool has_allocated_port = false;
+    uint16_t min_allocated_port = 0;
+    uint16_t max_allocated_port = 0;
+  };
+
+  TrainingSourcePortAllocator(uint32_t first_port,
+                              uint32_t end_port_exclusive)
+      : first_port_(first_port), end_port_exclusive_(end_port_exclusive) {}
+
+  // external_conflict is evaluated while the allocator mutex is held.  The
+  // ns-3 caller additionally holds MTP's explicit global critical section so
+  // this check and insertion into sender_src_port_map form one transaction.
+  Allocation Reserve(uint32_t src, uint32_t dst, uint16_t pg,
+                     const std::function<bool(uint16_t)>& external_conflict) {
+    std::lock_guard<std::mutex> guard(mu_);
+    Allocation result;
+    if (!ValidRange()) {
+      IncrementSaturating(invariant_errors_);
+      result.error = RangeError();
+      return result;
+    }
+
+    PairState& state = pairs_[PairKey(src, dst)];
+    if (!state.initialized) {
+      state.initialized = true;
+      state.next_port = first_port_;
+      state.ever_used.assign(end_port_exclusive_ - first_port_, 0);
+    }
+
+    const uint32_t capacity = end_port_exclusive_ - first_port_;
+    for (uint32_t inspected = 0; inspected < capacity; ++inspected) {
+      const uint32_t candidate_u32 = state.next_port;
+      Advance(state);
+      const uint16_t candidate = static_cast<uint16_t>(candidate_u32);
+      if (state.active.count(candidate) != 0) continue;
+      if (external_conflict && external_conflict(candidate)) {
+        if (external_conflicts_ == std::numeric_limits<uint64_t>::max()) {
+          IncrementSaturating(invariant_errors_);
+          result.error = "training source-port external-conflict counter overflow";
+          return result;
+        }
+        ++external_conflicts_;
+        continue;
+      }
+
+      const uint32_t candidate_offset = candidate_u32 - first_port_;
+      const bool reused = state.ever_used[candidate_offset] != 0;
+      if (state.allocations == std::numeric_limits<uint64_t>::max() ||
+          total_allocations_ == std::numeric_limits<uint64_t>::max() ||
+          active_reservations_ == std::numeric_limits<uint64_t>::max() ||
+          (reused &&
+           (state.reuses == std::numeric_limits<uint64_t>::max() ||
+            total_reuses_ == std::numeric_limits<uint64_t>::max()))) {
+        IncrementSaturating(invariant_errors_);
+        std::ostringstream message;
+        message << "training source-port allocator counter overflow for src="
+                << src << " dst=" << dst << " sport=" << candidate
+                << " pg=" << pg;
+        result.error = message.str();
+        return result;
+      }
+      state.ever_used[candidate_offset] = 1;
+      state.active.emplace(candidate, pg);
+      ++state.allocations;
+      ++total_allocations_;
+      ++active_reservations_;
+      if (active_reservations_ > peak_active_reservations_)
+        peak_active_reservations_ = active_reservations_;
+      if (reused) {
+        ++state.reuses;
+        ++total_reuses_;
+      }
+      if (!has_allocated_port_) {
+        has_allocated_port_ = true;
+        min_allocated_port_ = candidate;
+        max_allocated_port_ = candidate;
+      } else {
+        if (candidate < min_allocated_port_) min_allocated_port_ = candidate;
+        if (candidate > max_allocated_port_) max_allocated_port_ = candidate;
+      }
+
+      result.ok = true;
+      result.port = candidate;
+      result.reused = reused;
+      result.first_reuse_for_pair = reused && state.reuses == 1;
+      result.allocation_ordinal = state.allocations;
+      return result;
+    }
+
+    std::ostringstream message;
+    message << "training source-port interval exhausted for src=" << src
+            << " dst=" << dst << " pg=" << pg << " interval=["
+            << first_port_ << ',' << end_port_exclusive_ << ") capacity="
+            << capacity << " active_for_pair=" << state.active.size();
+    result.error = message.str();
+    IncrementSaturating(exhaustions_);
+    return result;
+  }
+
+  // Release is intentionally strict: a duplicate, foreign, or wrong-PG
+  // release is a lifecycle bug and must not silently make a live QP reusable.
+  bool Release(uint32_t src, uint32_t dst, uint16_t port, uint16_t pg,
+               std::string* error) {
+    std::lock_guard<std::mutex> guard(mu_);
+    const uint64_t key = PairKey(src, dst);
+    typename std::map<uint64_t, PairState>::iterator pair = pairs_.find(key);
+    if (pair == pairs_.end()) {
+      IncrementSaturating(invariant_errors_);
+      SetReleaseError(src, dst, port, pg, "unknown (src,dst) pair", error);
+      return false;
+    }
+    typename std::map<uint16_t, uint16_t>::iterator active =
+        pair->second.active.find(port);
+    if (active == pair->second.active.end()) {
+      IncrementSaturating(invariant_errors_);
+      SetReleaseError(src, dst, port, pg, "port is not active", error);
+      return false;
+    }
+    if (active->second != pg) {
+      IncrementSaturating(invariant_errors_);
+      std::ostringstream reason;
+      reason << "protection group differs: reserved_pg=" << active->second;
+      SetReleaseError(src, dst, port, pg, reason.str(), error);
+      return false;
+    }
+    if (active_reservations_ == 0) {
+      IncrementSaturating(invariant_errors_);
+      SetReleaseError(src, dst, port, pg,
+                      "global active counter underflow", error);
+      return false;
+    }
+    if (total_releases_ == std::numeric_limits<uint64_t>::max()) {
+      IncrementSaturating(invariant_errors_);
+      SetReleaseError(src, dst, port, pg, "release counter overflow", error);
+      return false;
+    }
+    pair->second.active.erase(active);
+    --active_reservations_;
+    ++total_releases_;
+    return true;
+  }
+
+  Snapshot GetSnapshot() const {
+    std::lock_guard<std::mutex> guard(mu_);
+    Snapshot snapshot;
+    snapshot.total_allocations = total_allocations_;
+    snapshot.total_releases = total_releases_;
+    snapshot.total_reuses = total_reuses_;
+    snapshot.active_reservations = active_reservations_;
+    snapshot.peak_active_reservations = peak_active_reservations_;
+    snapshot.pair_count = pairs_.size();
+    for (const auto& item : pairs_) {
+      const PairState& state = item.second;
+      if (state.reuses > 0) ++snapshot.pairs_with_reuse;
+      if (state.allocations > snapshot.max_pair_allocations)
+        snapshot.max_pair_allocations = state.allocations;
+      if (state.reuses > snapshot.max_pair_reuses)
+        snapshot.max_pair_reuses = state.reuses;
+    }
+    snapshot.external_conflicts = external_conflicts_;
+    snapshot.exhaustions = exhaustions_;
+    snapshot.invariant_errors = invariant_errors_;
+    snapshot.has_allocated_port = has_allocated_port_;
+    snapshot.min_allocated_port = min_allocated_port_;
+    snapshot.max_allocated_port = max_allocated_port_;
+    return snapshot;
+  }
+
+  void RecordInvariantError() {
+    std::lock_guard<std::mutex> guard(mu_);
+    IncrementSaturating(invariant_errors_);
+  }
+
+  uint32_t Capacity() const {
+    return ValidRange() ? end_port_exclusive_ - first_port_ : 0;
+  }
+
+ private:
+  struct PairState {
+    bool initialized = false;
+    uint32_t next_port = 0;
+    uint64_t allocations = 0;
+    uint64_t reuses = 0;
+    std::map<uint16_t, uint16_t> active;  // sport -> protection group
+    // One byte per candidate port (39,152 bytes with the production range),
+    // rather than one heap node per historical allocation.
+    std::vector<uint8_t> ever_used;
+  };
+
+  bool ValidRange() const {
+    return first_port_ <= 65535 && end_port_exclusive_ <= 65536 &&
+           first_port_ < end_port_exclusive_;
+  }
+
+  std::string RangeError() const {
+    std::ostringstream message;
+    message << "invalid training source-port interval [" << first_port_ << ','
+            << end_port_exclusive_ << "); require 0<=first<end<=65536";
+    return message.str();
+  }
+
+  static uint64_t PairKey(uint32_t src, uint32_t dst) {
+    return (static_cast<uint64_t>(src) << 32) | static_cast<uint64_t>(dst);
+  }
+
+  void Advance(PairState& state) const {
+    if (state.next_port + 1 >= end_port_exclusive_)
+      state.next_port = first_port_;
+    else
+      ++state.next_port;
+  }
+
+  static void SetReleaseError(uint32_t src, uint32_t dst, uint16_t port,
+                              uint16_t pg, const std::string& reason,
+                              std::string* error) {
+    if (error == nullptr) return;
+    std::ostringstream message;
+    message << "invalid training source-port release: src=" << src
+            << " dst=" << dst << " sport=" << port << " pg=" << pg
+            << ": " << reason;
+    *error = message.str();
+  }
+
+  static void IncrementSaturating(uint64_t& value) {
+    if (value != std::numeric_limits<uint64_t>::max()) ++value;
+  }
+
+  const uint32_t first_port_;
+  const uint32_t end_port_exclusive_;
+  mutable std::mutex mu_;
+  std::map<uint64_t, PairState> pairs_;
+  uint64_t total_allocations_ = 0;
+  uint64_t total_releases_ = 0;
+  uint64_t total_reuses_ = 0;
+  uint64_t active_reservations_ = 0;
+  uint64_t peak_active_reservations_ = 0;
+  uint64_t external_conflicts_ = 0;
+  uint64_t exhaustions_ = 0;
+  uint64_t invariant_errors_ = 0;
+  bool has_allocated_port_ = false;
+  uint16_t min_allocated_port_ = 0;
+  uint16_t max_allocated_port_ = 0;
+};
+
+}  // namespace limer
+
+#endif  // LIMER_TRAINING_SOURCE_PORT_ALLOCATOR_H
