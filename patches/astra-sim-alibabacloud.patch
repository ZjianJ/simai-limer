+  // LIMER fault injection support: resolve a link_id (from link_map.csv,
+  // same table built in BuildLinkMap()) to the ns-3 device on its "src"
+  // side, and the link's configured (pre-fault) bandwidth. Used by
+  // FaultInjector below so it never has to re-derive node/port from a
+  // link_id itself.
+  // A point-to-point link has two NetDevice endpoints (one per node), both
+  // normally configured with the same DataRate at topology setup (see
+  // common.h's SetupNetwork(), which sets the attribute once before
+  // qbb.Install() creates both). Changing only one side's DataRate at
+  // runtime desyncs the two directions, so fault injection must touch
+  // both - this returns both, keyed the same way BuildLinkMap() stores
+  // them (src = the lower-numbered node id).
+  std::pair<ns3::Ptr<ns3::QbbNetDevice>, ns3::Ptr<ns3::QbbNetDevice>> GetBothDevicesForLink(const std::string& link_id) {
+    for (auto& e : links_) {
+      if (e.link_id == link_id) {
+        auto srcDev = ns3::DynamicCast<ns3::QbbNetDevice>(nodes_->Get(e.src_node)->GetDevice(e.src_port));
+        auto dstDev = ns3::DynamicCast<ns3::QbbNetDevice>(nodes_->Get(e.dst_node)->GetDevice(e.dst_port));
+        return {srcDev, dstDev};
+      }
+    }
+    return {nullptr, nullptr};
+  }
+  uint64_t GetConfiguredBandwidthBps(const std::string& link_id) {
+    for (auto& e : links_) {
+      if (e.link_id == link_id) return e.bandwidth_bps;
+    }
+    return 0;
+  }
+
+  // Ground-truth execution evidence.  This sidecar is intentionally separate
+  // from inference telemetry and must never be joined into model features.
+  // It records the simulator callback time so evaluators need not assume that
+  // the requested schedule time was actually applied.
+  void RecordFaultTransition(const std::string& fault_id,
+                             const std::string& fault_type,
+                             const std::string& link_id,
+                             const std::string& transition,
+                             uint64_t scheduled_ns,
+                             const std::string& parameter_before,
+                             const std::string& parameter_after,
+                             const std::string& mechanism,
+                             const std::string& rng_stream,
+                             const std::string& status) {
+    if (!enabled_) return;
+#ifdef NS3_MTP
+    MtpInterface::explicitCriticalSection cs;
+#endif
+    AppendRow(fault_application_stream_, {
+        run_id_, fault_id, fault_type, link_id, transition, U(scheduled_ns),
+        U(ns3::Simulator::Now().GetNanoSeconds()), parameter_before,
+        parameter_after, mechanism, rng_stream, status});
+#ifdef NS3_MTP
+    cs.ExitSection();
+#endif
+  }
