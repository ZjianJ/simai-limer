+
+  void RecordCollectiveFinish(int flow_id, int rank_id, uint64_t world_size) {
+    if (!enabled_) return;
+#ifdef NS3_MTP
+    MtpInterface::explicitCriticalSection cs;
+#endif
+    auto it = pending_.find(flow_id);
+    if (it != pending_.end()) {
+      uint64_t finish_ns = ns3::Simulator::Now().GetNanoSeconds();
+      const PendingFlow& pf = it->second;
+      // This ns3-frontend hook does not carry workload layer/iteration
+      // context, so those two columns remain explicitly unavailable.
+      AppendRow(coll_stream_, {
+          run_id_, std::to_string(flow_id), Empty(), Empty(), "ALLREDUCE",
+          "NcclFlowModel", std::to_string(rank_id), U(world_size),
+          U(pf.msg_size), U(pf.start_ns), U(finish_ns),
+          U(finish_ns - pf.start_ns), "ok"});
+      pending_.erase(it);
+    }
+#ifdef NS3_MTP
+    cs.ExitSection();
+#endif
+  }
