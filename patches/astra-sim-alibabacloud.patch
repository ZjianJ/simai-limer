index 0000000..c9a7999
--- /dev/null
+++ b/astra-sim-alibabacloud/astra-sim/network_frontend/ns3/collective_causal_time.h
@@ -0,0 +1,41 @@
+#ifndef LIMER_COLLECTIVE_CAUSAL_TIME_H
+#define LIMER_COLLECTIVE_CAUSAL_TIME_H
+
+#include <cstdint>
+
+namespace limer {
+
+// MTP logical processes have independent local clocks.  The callback that
+// observes the last ready rank can therefore run at a local timestamp that is
+// slightly behind a ready callback already recorded by another LP.  Keep the
+// maximum ready timestamp for the current attempt and clamp COMMIT to it.
+inline uint64_t CollectiveReadyMaximum(uint64_t previous_max_ready_ns,
+                                       uint64_t ready_timestamp_ns) {
+  return previous_max_ready_ns < ready_timestamp_ns
+             ? ready_timestamp_ns
+             : previous_max_ready_ns;
+}
+
+inline uint64_t CollectiveCommitTimestamp(uint64_t current_timestamp_ns,
+                                          uint64_t max_ready_timestamp_ns) {
+  return current_timestamp_ns < max_ready_timestamp_ns
+             ? max_ready_timestamp_ns
+             : current_timestamp_ns;
+}
+
+// The transaction record and the application release must use the same
+// causal timestamp.  In an MTP run the callback that acquires the global
+// commit gate last can have an LP-local clock behind another rank's READY
+// timestamp.  Logging a clamped COMMIT but releasing with ScheduleNow would
+// let the next collective begin before the recorded commit.  Return the
+// non-negative delay needed to release at the clamped timestamp instead.
+inline uint64_t CollectiveCommitDelay(uint64_t current_timestamp_ns,
+                                      uint64_t commit_timestamp_ns) {
+  return current_timestamp_ns < commit_timestamp_ns
+             ? commit_timestamp_ns - current_timestamp_ns
+             : 0;
+}
+
+}  // namespace limer
+
+#endif  // LIMER_COLLECTIVE_CAUSAL_TIME_H
