+  void Close() {
+    if (!enabled_ || closed_) return;
+    Flush();
+    CloseCsv(switch_stream_, switch_path_);
+    CloseCsv(nic_stream_, nic_path_);
+    CloseCsv(coll_stream_, coll_path_);
+    CloseCsv(alarm_stream_, alarm_path_);
+    CloseCsv(recovery_stream_, recovery_path_);
+    CloseCsv(rdma_stream_, rdma_path_);
+    CloseCsv(collective_tx_stream_, collective_tx_path_);
+    CloseCsv(fault_application_stream_, fault_application_path_);
+    CloseCsv(lifecycle_stream_, lifecycle_path_);
+    closed_ = true;
