+Tick UsageTracker::clamp_observed_tick(Tick observed_tick) {
+  if (observed_tick < last_tick) {
+    const Tick regression = last_tick - observed_tick;
+    if (regression > kMaxToleratedClockRegressionTicks) {
+      std::cerr << "UsageTracker clock regression exceeds bounded MTP "
+                   "tolerance: regression_ticks="
+                << regression
+                << ", tolerance_ticks="
+                << kMaxToleratedClockRegressionTicks << std::endl;
+      std::abort();
+    }
+    clock_regression_count++;
+    max_clock_regression = std::max(max_clock_regression, regression);
+    return last_tick;
+  }
+  return observed_tick;
