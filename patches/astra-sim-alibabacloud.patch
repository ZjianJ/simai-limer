+  void Enqueue(unsigned src,std::function<void()> launch) {
+    {
+      std::lock_guard<std::mutex> lock(mu);
+      pending[src].push_back(std::move(launch));
+      if(policy->Censored()) RecordQueue(src,"ENQUEUE",0);
+    }
+    Pump(src);
+  }
+  void Register(unsigned src,unsigned dst,unsigned port,int flow,uint64_t offset,uint64_t total) {
+    std::lock_guard<std::mutex> lock(mu);
+    auto key=std::make_tuple(src,dst,port);
+    NS_ABORT_MSG_IF(metadata.count(key),"duplicate split metadata key");
+    metadata[key]={flow,offset,total};
+  }
+  void Pump(unsigned src) {
