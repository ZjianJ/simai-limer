+  void Complete(ns3::Ptr<ns3::RdmaQueuePair> q) {
+    if (!Enabled()) return;
+    auto key=std::make_tuple(q->GetSrc(),q->GetDest(),q->sport);
+    {
+      std::lock_guard<std::mutex> lock(mu);
+      auto it=bindings.find(key); if(it==bindings.end()) return;
+      unsigned r=it->second;
+      NS_ABORT_MSG_IF(q->m_activeNicIdx!=r+2,"chunk escaped its assigned rail");
+      if(policy->ChunkFeedback()) {
+        uint64_t now=ns3::Simulator::Now().GetNanoSeconds();
+        NS_ABORT_MSG_IF(!q->m_hasFirstTxTimestamp || now<=q->m_firstTxTimestampNs,
+            "chunk feedback requires real first TX and ACK completion timestamps");
+        uint64_t elapsed=now-q->m_firstTxTimestampNs;
+        policy->ChunkComplete(q->GetSrc(),r,q->GetInitialSize(),elapsed);
+        if(policy->Censored()) {
+          ObserveCensored(q,key,r,now,true);
+          policy->censored_last_ack[{q->GetSrc(),r}]=now;
+          UpdateCensored(q->GetSrc(),now,"ACK");
+        }
+        if(policy->Adaptive()) {
+          policy->wait_model.Observe(q->GetSrc(),r,q->GetInitialSize(),launch_load.at(key),elapsed);
+          UpdateWait(q->GetSrc(),now,"ACK");
+        }
+        if(policy->name=="B9") {
+          policy->ResetAgeCaps(q->GetSrc());
+          std::array<ns3::Ptr<ns3::RdmaQueuePair>,2> witness;
+          for(const auto& item:live_chunks[q->GetSrc()]) {
+            auto other=item.second;
+            if(other==q || other->IsFinished() || !other->m_hasFirstTxTimestamp ||
+                now<=other->m_firstTxTimestampNs) continue;
+            unsigned rail=bindings.at(item.first);
+            double bound=other->GetInitialSize()*8e9/(now-other->m_firstTxTimestampNs);
+            if(bound<policy->age_cap[{q->GetSrc(),rail}]) witness[rail]=other;
+            policy->AgeSample(q->GetSrc(),rail,other->GetInitialSize(),now-other->m_firstTxTimestampNs);
+          }
+          for(unsigned rail=0;rail<2;++rail) {
+            auto w=witness[rail];
+            ages<<now<<','<<q->GetSrc()<<','<<q->GetDest()<<','<<q->sport<<','<<r<<','<<rail<<','
+                <<policy->chunk_estimate[{q->GetSrc(),rail}].bps<<','
+                <<policy->Rate(q->GetSrc(),q->GetDest(),rail,now)<<','
+                <<(w?w->GetDest():0)<<','<<(w?w->sport:0)<<','<<(w?w->GetInitialSize():0)<<','
+                <<(w?w->m_firstTxTimestampNs:0)<<','<<(w?now-w->m_firstTxTimestampNs:0)<<','
+                <<(w?policy->age_cap[{q->GetSrc(),rail}]:0)<<'\n';
+          }
+          ages.flush();
+        }
+        feedback<<now<<','<<policy->name<<','<<q->GetSrc()<<','<<q->GetDest()<<','
+            <<q->sport<<','<<r<<','<<q->GetInitialSize()<<','<<q->m_firstTxTimestampNs
+            <<','<<now<<','<<elapsed<<','<<q->GetInitialSize()*8e9/elapsed<<','
+            <<policy->Rate(q->GetSrc(),q->GetDest(),r,now)<<','
+            <<policy->chunk_estimate[{q->GetSrc(),r}].samples<<','<<++audit_seq<<'\n';
+        feedback.flush();
+      }
+      policy->Complete(q->GetSrc(),q->GetDest(),r,q->GetInitialSize());
+      Record(q,r,"ACK_COMPLETE",ns3::Simulator::Now().GetNanoSeconds());
+      metadata.erase(key);
+      bindings.erase(it);
+      if(policy->name=="B9" || policy->Adaptive() || policy->Censored()) live_chunks[q->GetSrc()].erase(key);
+      if(policy->Adaptive() || policy->Censored()) {--inflight_rail[{q->GetSrc(),r}];launch_load.erase(key);}
+      if(policy->Censored()) {
+        if(exploratory.at(key)) policy->CensoredProbeComplete(q->GetSrc());
+        exploratory.erase(key);model_ids.erase(key);model_seen.erase(key);
+      }
+      NS_ABORT_MSG_IF(!active[q->GetSrc()],"split active counter underflow");
+      --active[q->GetSrc()];
+      if(policy->Censored()) RecordQueue(q->GetSrc(),"COMPLETE",0);
+    }
+    // QpComplete must finish removing this QP before another chunk starts.
+    ns3::Simulator::ScheduleWithContext(q->GetSrc(),ns3::TimeStep(0),
+        &SplitRuntime::Resume,q->GetSrc());
+  }
+  void Progress(ns3::Ptr<ns3::RdmaQueuePair> q,uint64_t bytes) {
+    if (!Enabled()) return;
+    std::lock_guard<std::mutex> lock(mu);
+    auto it=bindings.find({q->GetSrc(),q->GetDest(),q->sport});
+    if(it!=bindings.end()) acked[{q->GetSrc(),it->second}]+=bytes;
+  }
+  void ObserveSwitch(unsigned node,unsigned port,uint64_t queue) {
+    if (!Enabled()) return;
+    std::lock_guard<std::mutex> lock(mu);
+    auto it=switch_dest.find({node,port});
+    if(it!=switch_dest.end()) policy->destination_queue[it->second]=queue;
+  }
+  void Observe(unsigned src,unsigned port,uint64_t now,double rate,
+               uint64_t queue,uint64_t outstanding,bool up) {
+    if (!Enabled() || src>=16 || port<2 || port>3) return;
+    std::lock_guard<std::mutex> lock(mu);
+    (void)rate; // Wire TX is not unique delivered payload; use ACK progress.
+    auto key=std::make_pair(src,port-2);
+    uint64_t dt=now-last_sample_ns[key];
+    double goodput=dt ? (acked[key]-last_acked[key])*8e9/dt : 0;
+    // A conservative, explicit demand heuristic, not a claim of saturation.
+    bool demand=queue>0 || outstanding>=65536;
+    bool informative=dt && previous_demand[key] && demand;
+    policy->Observe(src,port-2,now,goodput,queue,informative,up);
+    samples<<now<<','<<src<<','<<port-2<<','<<acked[key]<<','<<goodput<<','
+        <<policy->state[key].ewma<<','<<queue<<','<<outstanding<<','<<informative<<'\n';
+    samples.flush();
+    last_sample_ns[key]=now; last_acked[key]=acked[key];previous_demand[key]=demand;
+  }
+ private:
+  struct Sensor {
+    unsigned node,port,dst,rail;
+    ns3::Ptr<ns3::QbbNetDevice> dev;
+    SparseEgressSignal state;
+  };
+  struct SignalMessage {
+    uint64_t sampled,tx,queue;
+    unsigned node,port,dst,rail;
+    double wire,reference,factor;
+    bool demand;
+  };
+  static void SwitchTick(std::shared_ptr<Sensor> sensor) {
+    auto& rt=Get();
+    uint64_t now=ns3::Simulator::Now().GetNanoSeconds();
+    double wire;bool demand;
+    uint64_t tx=sensor->dev->m_limerTxBytes,queue=sensor->dev->GetLimerQueueBytes();
+    bool send=sensor->state.Sample(now,tx,queue,sensor->dev->GetLimerLinkUp(),
+        rt.signal_heartbeat_ns,wire,demand);
+    {std::lock_guard<std::mutex> lock(rt.mu);
+      rt.signal_samples<<now<<','<<sensor->node<<','<<sensor->port<<','<<sensor->dst<<','<<sensor->rail
+          <<','<<tx<<','<<queue<<','<<wire<<','<<sensor->state.reference_bps<<','<<demand
+          <<','<<sensor->state.factor<<','<<send<<','<<sensor->dev->GetLimerLinkUp()<<','<<++rt.audit_seq<<'\n';}
+    if(send) {
+      SignalMessage msg{now,tx,queue,sensor->node,sensor->port,sensor->dst,sensor->rail,
+          wire,sensor->state.reference_bps,sensor->state.factor,demand};
+      {std::lock_guard<std::mutex> lock(rt.mu);rt.RecordSignal("EMIT",now,16,msg);}
+      // Fixed topology subscriptions, not cross-LP inspection of host demand.
+      // Logical control messages use fixed modeled delivery latency; they do
+      // not consume data-plane links. Export fanout bytes for overhead accounting.
+      for(unsigned src=0;src<16;++src) if(src/4!=sensor->dst/4)
+        ns3::Simulator::ScheduleWithContext(src,ns3::NanoSeconds(rt.signal_delay_ns),
+            &SplitRuntime::ReceiveSignal,src,msg);
+    }
+    ns3::Simulator::ScheduleWithContext(sensor->node,ns3::NanoSeconds(rt.signal_sample_ns),
+        &SplitRuntime::SwitchTick,sensor);
+  }
+  static void ReceiveSignal(unsigned src,SignalMessage msg) {
+    auto& rt=Get();std::lock_guard<std::mutex> lock(rt.mu);
+    uint64_t now=ns3::Simulator::Now().GetNanoSeconds();
+    if(rt.signal_actuate) rt.policy->DeliverSignal(src,msg.dst,msg.rail,msg.sampled,now,msg.factor);
+    rt.RecordSignal("DELIVER",now,src,msg);
+  }
+  void RecordSignal(const char* event,uint64_t now,unsigned observer,const SignalMessage& msg) {
+    signal_log<<event<<','<<now<<','<<msg.sampled<<','<<msg.node<<','<<msg.port<<','<<observer
+        <<','<<msg.dst<<','<<msg.rail<<','<<msg.tx<<','<<msg.queue<<','<<msg.wire<<','
+        <<msg.reference<<','<<msg.demand<<','<<msg.factor<<",32,"<<++audit_seq<<'\n';
+  }
+  static void WaitTick(unsigned src) {
+    auto& rt=Get();
+    {std::lock_guard<std::mutex> lock(rt.mu);
+      if(rt.policy->Censored()) rt.UpdateCensored(src,ns3::Simulator::Now().GetNanoSeconds(),"TIMER");
+      else rt.UpdateWait(src,ns3::Simulator::Now().GetNanoSeconds(),"TIMER");}
+    ns3::Simulator::ScheduleWithContext(src,ns3::NanoSeconds(rt.wait_sample_ns),&SplitRuntime::WaitTick,src);
+  }
+  void RecordQueue(unsigned src,const char* event,uint64_t limit) {
+    censored_queue<<ns3::Simulator::Now().GetNanoSeconds()<<','<<src<<','<<event<<','<<pending[src].size()
+        <<','<<active[src]<<','<<limit<<','<<++audit_seq<<'\n';
+  }
+  void UpdateCensored(unsigned src,uint64_t now,const char* trigger) {
+    for(const auto& item:live_chunks[src]) {
+      auto q=item.second;
+      if(q->IsFinished() || !q->m_hasFirstTxTimestamp) continue;
+      ObserveCensored(q,item.first,bindings.at(item.first),now,false);
+    }
+    policy->RefreshCensored(src,now);
+    if(live_chunks[src].empty() && std::string(trigger)=="TIMER") return;
+    for(unsigned r=0;r<2;++r) {
+      const auto& e=policy->censored_evidence[{src,r}];
+      censored_intervals<<now<<','<<trigger<<','<<src<<','<<r<<','<<policy->chunk_estimate[{src,r}].bps
+          <<','<<e.identified_lower<<','<<e.identified_upper<<','<<e.lower<<','<<e.upper<<','<<e.radius
+          <<','<<e.count<<','<<e.completed<<','<<e.pending<<','<<e.last_completed_ns<<','<<e.ready
+          <<','<<policy->CensoredFactor(src,r)<<','<<++audit_seq<<'\n';
+    }
+  }
+  void ObserveCensored(ns3::Ptr<ns3::RdmaQueuePair> q,const std::tuple<unsigned,unsigned,unsigned>& key,
+                       unsigned rail,uint64_t now,bool completed) {
+    policy->censored_model.Upsert(q->GetSrc(),rail,model_ids.at(key),q->GetInitialSize(),
+        launch_load.at(key),q->m_firstTxTimestampNs,now,completed);
+    if(completed || !model_seen[key]) {
+      censored_observations<<now<<','<<q->GetSrc()<<','<<q->GetDest()<<','<<q->sport<<','<<rail
+          <<','<<model_ids.at(key)<<','<<q->GetInitialSize()<<','<<launch_load.at(key)
+          <<','<<q->m_firstTxTimestampNs<<','<<completed<<','<<++audit_seq<<'\n';
+      model_seen[key]=true;
+    }
+  }
+  void UpdateWait(unsigned src,uint64_t now,const char* trigger) {
+    std::array<ns3::Ptr<ns3::RdmaQueuePair>,2> witness;
+    std::array<WaitModel::Evidence,2> evidence;
+    for(unsigned r=0;r<2;++r) policy->wait_factor[{src,r}]=1;
+    for(const auto& item:live_chunks[src]) {
+      auto q=item.second;
+      if(q->IsFinished() || !q->m_hasFirstTxTimestamp || now<=q->m_firstTxTimestampNs) continue;
+      unsigned r=bindings.at(item.first);
+      auto ev=policy->wait_model.Evaluate(src,r,q->GetInitialSize(),launch_load.at(item.first),now-q->m_firstTxTimestampNs);
+      if(ev.factor<policy->wait_factor[{src,r}]) {
+        policy->wait_factor[{src,r}]=ev.factor;witness[r]=q;evidence[r]=ev;
+      }
+    }
+    if(live_chunks[src].empty()) return;
+    for(unsigned r=0;r<2;++r) {
+      auto w=witness[r];const auto& ev=evidence[r];
+      adaptive<<now<<','<<trigger<<','<<src<<','<<r<<','<<policy->chunk_estimate[{src,r}].bps
+          <<','<<policy->WaitFactor(src,r)<<','<<(w?w->GetDest():0)<<','<<(w?w->sport:0)
+          <<','<<(w?w->GetInitialSize():0)<<','<<(w?w->m_firstTxTimestampNs:0)
+          <<','<<(w?launch_load.at({src,w->GetDest(),w->sport}):0)
+          <<','<<(w?now-w->m_firstTxTimestampNs:0)<<','<<ev.threshold_ns<<','<<ev.samples<<','<<++audit_seq<<'\n';
+    }
+    adaptive.flush();
+  }
+  static uint64_t Number(const char* s) {
+    std::string value(s); size_t end=0; uint64_t n=std::stoull(value,&end);
+    NS_ABORT_MSG_IF(end!=value.size() || value.empty() || value[0]=='-',"invalid unsigned setting");
+    return n;
+  }
+  void Record(ns3::Ptr<ns3::RdmaQueuePair> q,unsigned r,const char* event,uint64_t now) {
+    const auto& m=metadata.at({q->GetSrc(),q->GetDest(),q->sport});
+    events<<now<<','<<policy->name<<','<<event<<','<<q->GetSrc()<<','<<q->GetDest()
+        <<','<<q->sport<<','<<r<<','<<q->GetInitialSize()<<','
+        <<policy->Rate(q->GetSrc(),q->GetDest(),r,now)<<','
+        <<policy->state[{q->GetSrc(),r}].reserved<<','<<m.flow<<','<<m.offset<<','<<m.total<<'\n';
+    events.flush();
+  }
+  uint64_t chunk_bytes=1048576,max_active=8;
+  uint64_t wait_sample_ns=10000,signal_sample_ns=10000,signal_delay_ns=10000,signal_heartbeat_ns=40000;
+  uint64_t audit_seq=0;
+  bool signal_enabled=true,signal_actuate=true;
+  std::unique_ptr<SplitPolicy> policy;
+  std::mutex mu;
+  std::ofstream events,samples,feedback,ages,adaptive,decisions,signal_log,signal_samples;
+  std::ofstream censored_intervals,censored_decisions,censored_queue,censored_observations;
+  std::map<std::tuple<unsigned,unsigned,unsigned>,uint64_t> model_ids;
+  std::map<std::tuple<unsigned,unsigned,unsigned>,bool> exploratory;
+  std::map<std::tuple<unsigned,unsigned,unsigned>,bool> model_seen;
+  std::map<unsigned,uint64_t> next_model_id;
+  std::map<std::tuple<unsigned,unsigned,unsigned>,unsigned> launch_load;
+  std::map<std::pair<unsigned,unsigned>,unsigned> inflight_rail;
+  std::map<unsigned,std::map<std::tuple<unsigned,unsigned,unsigned>,ns3::Ptr<ns3::RdmaQueuePair>>> live_chunks;
+  std::map<std::pair<unsigned,unsigned>,std::pair<unsigned,unsigned>> switch_dest;
+  std::map<std::pair<unsigned,unsigned>,uint64_t> acked,last_acked,last_sample_ns;
+  std::map<std::pair<unsigned,unsigned>,bool> previous_demand;
+  std::map<unsigned,std::deque<std::function<void()>>> pending;
+  std::map<unsigned,uint64_t> active;
+  std::map<std::tuple<unsigned,unsigned,unsigned>,unsigned> bindings;
+  struct Metadata { int flow; uint64_t offset,total; };
+  std::map<std::tuple<unsigned,unsigned,unsigned>,Metadata> metadata;
+};
+} // namespace limer
+#endif
