+  void Sample() {
+    if (!enabled_) return;
+    uint64_t now = ns3::Simulator::Now().GetNanoSeconds();
+#ifdef NS3_MTP
+    MtpInterface::explicitCriticalSection cs;
+#endif
+    for (uint32_t i = 0; i < nodes_->GetN(); ++i) {
+      ns3::Ptr<ns3::Node> node = nodes_->Get(i);
+      if (node->GetNodeType() == 1 || node->GetNodeType() == 2) {
+        SampleFabricNode(node, now);
+      } else if (node->GetNodeType() == 0) {
+        SampleHost(node, now);
+      }
+    }
+#ifdef NS3_MTP
+    cs.ExitSection();
+#endif
+    ns3::Simulator::Schedule(ns3::MicroSeconds(interval_us_),
+                              &TelemetryCollector::Sample, this);
+  }
