+  void RecordCollectiveStart(int flow_id, int sender_node, uint64_t msg_size) {
+    if (!enabled_) return;
+#ifdef NS3_MTP
+    MtpInterface::explicitCriticalSection cs;
+#endif
+    PendingFlow pf;
+    pf.sender_node = sender_node;
+    pf.msg_size = msg_size;
+    pf.start_ns = ns3::Simulator::Now().GetNanoSeconds();
+    pending_[flow_id] = pf;
+#ifdef NS3_MTP
+    cs.ExitSection();
+#endif
