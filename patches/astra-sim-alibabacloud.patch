+  void EmitAlarm(std::string alarm_id, std::string fault_id,
+                 std::string link_id, uint64_t physical_fault_ns,
+                 uint64_t observe_ns) {
+    uint64_t emit_ns = ns3::Simulator::Now().GetNanoSeconds();
+    ns3::Simulator::Schedule(ns3::NanoSeconds(alarm_transport_ns_),
+        &TelemetryCollector::DeliverAlarm, this, alarm_id, fault_id, link_id,
+        physical_fault_ns, observe_ns, emit_ns);
+  }
+
+  void DeliverAlarm(std::string alarm_id, std::string fault_id,
+                    std::string link_id, uint64_t physical_fault_ns,
+                    uint64_t observe_ns, uint64_t emit_ns) {
+    uint64_t deliver_ns = ns3::Simulator::Now().GetNanoSeconds();
+    // ns-3.36 MakeEvent supports at most six bound arguments.  Keep the
+    // complete immutable alarm envelope in one zero-argument event instead.
+    ns3::Simulator::Schedule(ns3::NanoSeconds(alarm_consume_ns_),
+        [this, alarm_id, fault_id, link_id, physical_fault_ns, observe_ns,
+         emit_ns, deliver_ns]() {
+          ConsumeAlarm(alarm_id, fault_id, link_id, physical_fault_ns,
+                       observe_ns, emit_ns, deliver_ns);
+        });
+  }
+
+  void ConsumeAlarm(std::string alarm_id, std::string fault_id,
+                    std::string link_id, uint64_t physical_fault_ns,
+                    uint64_t observe_ns, uint64_t emit_ns,
+                    uint64_t deliver_ns) {
+    uint64_t consume_ns = ns3::Simulator::Now().GetNanoSeconds();
+    std::string alarm_fault_type = "hard_disconnect";
+    auto fault_type_it = alarm_fault_type_.find(alarm_id);
+    if (fault_type_it != alarm_fault_type_.end())
+      alarm_fault_type = fault_type_it->second;
+    AppendRow(alarm_stream_, {
+        run_id_, alarm_id, fault_id, link_id, alarm_fault_type, "switch_carrier",
+        U(physical_fault_ns), U(observe_ns), U(emit_ns), U(deliver_ns),
+        U(consume_ns), U(emit_ns - physical_fault_ns),
+        U(deliver_ns - emit_ns), U(consume_ns - physical_fault_ns),
+        "delivered"});
+
+    if (!recovery_action_enabled_) {
+      AppendRow(recovery_stream_, {run_id_, fault_id, link_id, U(consume_ns),
+          Empty(), Empty(), Empty(), "0", "disabled_by_experiment"});
+      std::fprintf(stderr,
+          "LIMER-RECOVERY: alarm %s consumed at t=%lu ns; action disabled\n",
+          alarm_id.c_str(), (unsigned long)consume_ns);
+      return;
+    }
+
+    // Collective abort/redo is an actuator action, not part of observing a
+    // carrier transition.  It therefore begins only after the alarm reaches
+    // the consumer and only in recovery-enabled experiments.
+    AbortInFlightCollectives();
+
+    uint32_t src_node = 0, src_port = 0, dst_node = 0, dst_port = 0;
+    if (!GetLinkEndpoints(link_id, &src_node, &src_port, &dst_node, &dst_port)) {
+      AppendRow(recovery_stream_, {run_id_, fault_id, link_id, U(consume_ns),
+          Empty(), Empty(), Empty(), "0", "unresolved_link"});
+      return;
+    }
+
+    // Recovery is downstream of alarm delivery.  Recompute FIBs from the
+    // surviving physical graph, then activate pre-established backup QPs on
+    // a failed host endpoint.  RedistributeQp() is called after failover so
+    // the queue groups and the QP's explicit active NIC agree.
+    RecomputeRoutesAfterLinkStateChange(*nodes_);
+    uint64_t route_ns = ns3::Simulator::Now().GetNanoSeconds();
+    uint32_t affected = 0;
+    for (uint32_t i = 0; i < nodes_->GetN(); ++i) {
+      ns3::Ptr<ns3::Node> node = nodes_->Get(i);
+      if (node->GetNodeType() != 0) continue;
+      ns3::Ptr<ns3::RdmaDriver> drv = node->GetObject<ns3::RdmaDriver>();
+      if (!drv || !drv->m_rdma) continue;
+      uint32_t failed_port = 0;
+      if (node->GetId() == src_node) failed_port = src_port;
+      if (node->GetId() == dst_node) failed_port = dst_port;
+      if (failed_port != 0)
+        affected += drv->m_rdma->FailoverQpsFromNic(failed_port);
+      affected += drv->m_rdma->FailoverUnavailableQps();
+      drv->m_rdma->RedistributeQp();
+    }
+    uint64_t activate_ns = ns3::Simulator::Now().GetNanoSeconds();
+    AppendRow(recovery_stream_, {run_id_, fault_id, link_id, U(consume_ns),
+        U(route_ns), U(consume_ns), U(activate_ns), U(affected),
+        affected ? "backup_active" : "routes_rebuilt_no_active_qp"});
+    std::fprintf(stderr,
+        "LIMER-RECOVERY: alarm %s consumed at t=%lu ns, %u QPs moved to backup\n",
+        alarm_id.c_str(), (unsigned long)consume_ns, affected);
+  }
+
+  struct LinkEntry {
+    std::string link_id;
+    uint32_t src_node, dst_node;
+    std::string src_type, dst_type;
+    uint32_t src_port, dst_port;
+    std::string link_class;
+    uint64_t bandwidth_bps;
+    uint64_t delay_ns;
+  };
+
+  static std::string NodeTypeName(ns3::Ptr<ns3::Node> node) {
+    switch (node->GetNodeType()) {
+      case 0: return "HOST";
+      case 1: return "SWITCH";
+      case 2: return "NVSWITCH";
+      default: return "OTHER";
+    }
+  }
+
+  static std::string ClassifyLink(const std::string& a, const std::string& b) {
+    if ((a == "HOST" && b == "NVSWITCH") || (a == "NVSWITCH" && b == "HOST"))
+      return "INTRA_NODE";
+    if ((a == "HOST" && b == "SWITCH") || (a == "SWITCH" && b == "HOST"))
+      return "ACCESS";
+    if (a == "SWITCH" && b == "SWITCH")
+      return "INTER_SWITCH";
+    return "OTHER";
+  }
+
+  // Builds the link table from nbr2if (extern global from common.h,
+  // populated by SetupNetwork() from the topology file). One entry per
+  // unordered node pair, plus lookup indices by (node_id, port) so the
+  // periodic sampler can attach a link_id to each switch port / NIC.
+  void BuildLinkMap() {
+    for (uint32_t i = 0; i < nodes_->GetN(); ++i) {
+      ns3::Ptr<ns3::Node> a = nodes_->Get(i);
+      auto itA = nbr2if.find(a);
+      if (itA == nbr2if.end()) continue;
+      for (auto& kv : itA->second) {
+        ns3::Ptr<ns3::Node> b = kv.first;
+        if (b->GetId() < a->GetId()) continue; // dedupe unordered pair
+        const Interface& ifc = kv.second;
+        LinkEntry e;
+        char idbuf[64];
+        std::snprintf(idbuf, sizeof(idbuf), "L%u-%u", a->GetId(), b->GetId());
+        e.link_id = idbuf;
+        e.src_node = a->GetId();
+        e.dst_node = b->GetId();
+        e.src_type = NodeTypeName(a);
+        e.dst_type = NodeTypeName(b);
+        e.src_port = ifc.idx;
+        auto itB = nbr2if.find(b);
+        e.dst_port = (itB != nbr2if.end() && itB->second.count(a)) ? itB->second[a].idx : 0;
+        e.link_class = ClassifyLink(e.src_type, e.dst_type);
+        e.bandwidth_bps = ifc.bw;
+        e.delay_ns = ifc.delay;
+        links_.push_back(e);
+        link_id_by_node_port_[{e.src_node, e.src_port}] = e.link_id;
+        link_id_by_node_port_[{e.dst_node, e.dst_port}] = e.link_id;
+        peer_by_node_port_[{e.src_node, e.src_port}] = e.dst_node;
+        peer_by_node_port_[{e.dst_node, e.dst_port}] = e.src_node;
+      }
+    }
+    // nbr2if is keyed by Ptr<Node>; its iteration order is an allocation
+    // detail, not part of the physical topology contract.  Canonicalize the
+    // emitted link map so its byte hash is stable across rebuilds/runs.
+    std::sort(links_.begin(), links_.end(),
+        [](const LinkEntry& lhs, const LinkEntry& rhs) {
+          if (lhs.src_node != rhs.src_node)
+            return lhs.src_node < rhs.src_node;
+          if (lhs.src_port != rhs.src_port)
+            return lhs.src_port > rhs.src_port;
+          if (lhs.dst_node != rhs.dst_node)
+            return lhs.dst_node < rhs.dst_node;
+          return lhs.dst_port < rhs.dst_port;
+        });
+  }
+
+  void WriteLinkMapCsv() {
+    std::string path = dir_ + "/link_map.csv";
+    FILE* f = OpenCsv(path,
+        "link_id,src_node,dst_node,src_type,dst_type,src_port,dst_port,"
+        "link_class,bandwidth_bps,delay_ns\n");
+    for (auto& e : links_) {
+      AppendRow(f, {e.link_id, U(e.src_node), U(e.dst_node), e.src_type,
+          e.dst_type, U(e.src_port), U(e.dst_port), e.link_class,
+          U(e.bandwidth_bps), U(e.delay_ns)});
+    }
+    FlushCsv(f, path);
+    CloseCsv(f, path);
+  }
+
+  std::string LinkIdFor(uint32_t node, uint32_t port) {
+    auto it = link_id_by_node_port_.find({node, port});
+    return it == link_id_by_node_port_.end() ? "" : it->second;
+  }
+  uint32_t PeerFor(uint32_t node, uint32_t port) {
+    auto it = peer_by_node_port_.find({node, port});
+    return it == peer_by_node_port_.end() ? 0 : it->second;
+  }
+
+  static constexpr size_t kCsvBufferBytes = 64 * 1024;
+
+  [[noreturn]] static void CsvFailure(const char* operation,
+                                      const std::string& path) {
+    std::fprintf(stderr, "LIMER: telemetry %s failed for %s\n",
+                 operation, path.c_str());
+    std::exit(2);
+  }
+
+  static FILE* OpenCsv(const std::string& path, const char* header) {
+    FILE* out = std::fopen(path.c_str(), "w");
+    if (!out)
+      CsvFailure("open", path);
+    if (std::setvbuf(out, nullptr, _IOFBF, kCsvBufferBytes) != 0) {
+      std::fclose(out);
+      CsvFailure("buffer setup", path);
+    }
+    size_t bytes = std::strlen(header);
+    if (bytes != 0 && std::fwrite(header, 1, bytes, out) != bytes) {
+      std::fclose(out);
+      CsvFailure("header write", path);
+    }
+    // Make even a subsequently interrupted run self-describing.  Data rows
+    // remain bounded-buffered; successful runs Flush/Close every stream.
+    if (std::fflush(out) != 0) {
+      std::fclose(out);
+      CsvFailure("header flush", path);
+    }
+    return out;
+  }
+
+  // Construct one bounded row locally and submit it with one fwrite.  Calls
+  // are serialized by the same MTP guards that protected the former strings,
+  // preserving exact row order while avoiding horizon-sized heap retention.
+  static void AppendRow(FILE* out, const std::vector<std::string>& fields) {
+    if (!out)
+      CsvFailure("append on closed stream", "<unknown>");
+    std::string row;
+    for (size_t i = 0; i < fields.size(); ++i) {
+      if (i) row.push_back(',');
+      row.append(fields[i]);
+    }
+    row.push_back('\n');
+    if (std::fwrite(row.data(), 1, row.size(), out) != row.size())
+      CsvFailure("row write", "<active stream>");
+  }
+
+  static void FlushCsv(FILE* out, const std::string& path) {
+    if (!out || std::fflush(out) != 0)
+      CsvFailure("flush", path);
+  }
+
+  static void CloseCsv(FILE*& out, const std::string& path) {
+    if (!out)
+      CsvFailure("close", path);
+    FILE* closing = out;
+    out = nullptr;
+    if (std::fclose(closing) != 0)
+      CsvFailure("close", path);
+  }
+  static std::string U(unsigned long v) { return std::to_string(v); }
+  static std::string NZ(unsigned long v) {
+    return v == 0 ? std::string() : std::to_string(v);
+  }
+  static std::string D(double v) { return std::to_string(v); }
+  static const std::string& Empty() {
+    static const std::string e;
+    return e;
+  }
+
+  struct EndpointSampleState {
+    uint64_t last_tx_bytes = 0;
+    uint64_t last_rx_bytes = 0;
+    uint64_t last_timestamp_ns = 0;
+  };
+
+  double RateBps(uint64_t bytes, uint64_t last_bytes, uint64_t now,
+                 uint64_t last_timestamp) const {
+    uint64_t dt = now - last_timestamp;
+    if (dt == 0 || bytes < last_bytes) return 0.0;
+    return static_cast<double>(bytes - last_bytes) * 8.0e9 /
+           static_cast<double>(dt);
+  }
+
+  void SampleFabricNode(ns3::Ptr<ns3::Node> node, uint64_t now) {
+    uint32_t nDev = node->GetNDevices();
+    uint32_t nodeId = node->GetId();
+    std::string nodeType = NodeTypeName(node);
+    ns3::Ptr<ns3::SwitchNode> sw = ns3::DynamicCast<ns3::SwitchNode>(node);
+    ns3::Ptr<ns3::NVSwitchNode> nvsw = ns3::DynamicCast<ns3::NVSwitchNode>(node);
+    for (uint32_t p = 1; p < nDev; ++p) {
+      std::string linkId = LinkIdFor(nodeId, p);
+      if (linkId.empty()) continue;
+      ns3::Ptr<ns3::QbbNetDevice> dev =
+          ns3::DynamicCast<ns3::QbbNetDevice>(node->GetDevice(p));
+      if (!dev) continue;
+      uint64_t admissionDropPkts = 0, admissionDropBytes = 0;
+      uint64_t ecn = 0, pfc = 0;
+      if (sw) {
+        admissionDropPkts = sw->m_limerDropPkts[p];
+        admissionDropBytes = sw->m_limerDropBytes[p];
+        ecn = sw->m_limerEcnMarks[p];
+        pfc = sw->m_limerPfcEvents[p];
+      } else if (nvsw) {
+        admissionDropPkts = nvsw->m_limerDropPkts[p];
+        admissionDropBytes = nvsw->m_limerDropBytes[p];
+      }
+      uint64_t bw = dev->GetDataRate().GetBitRate();
+      auto key = std::make_pair(nodeId, p);
+      EndpointSampleState& state = endpoint_state_[key];
+      double txRate = RateBps(dev->m_limerTxBytes, state.last_tx_bytes,
+                              now, state.last_timestamp_ns);
+      double utilization = bw ? txRate / static_cast<double>(bw) : 0.0;
+      std::string linkState = dev->GetLimerLinkUp() ? "up" : "down";
+
+      if (limer_split_observe_switch)
+        limer_split_observe_switch(nodeId,p,dev->GetLimerQueueBytes());
+      AppendRow(switch_stream_, {
+          run_id_, U(now), U(nodeId), U(p), linkId, U(PeerFor(nodeId, p)), "tx",
+          U(dev->m_limerTxPackets), U(dev->m_limerTxBytes),
+          Empty(), Empty(),
+          U(admissionDropPkts + dev->m_limerTxDrops),
+          U(admissionDropBytes + dev->m_limerTxDropBytes),
+          U(dev->GetLimerQueuePackets()), U(dev->GetLimerQueueBytes()),
+          U(dev->m_limerMaxQueuePackets), U(dev->m_limerMaxQueueBytes),
+          U(ecn), U(pfc), U(dev->m_limerLinkErrors), Empty(), Empty(), U(bw),
+          D(txRate), D(utilization), nodeType, linkState,
+          U(dev->m_limerMaxQueueTimestampNs), U(dev->m_limerLinkFlaps),
+          U(dev->m_limerLastLinkDownNs), U(dev->m_limerLastLinkUpNs),
+          U(dev->GetLimerCumulativeDownNs())});
+      AppendRow(switch_stream_, {
+          run_id_, U(now), U(nodeId), U(p), linkId, U(PeerFor(nodeId, p)), "rx",
+          Empty(), Empty(),
+          U(dev->m_limerRxPackets), U(dev->m_limerRxBytes),
+          U(dev->m_limerRxDrops), U(dev->m_limerRxDropBytes),
+          Empty(), Empty(), Empty(), Empty(),
+          Empty(), Empty(),
+          U(dev->m_limerLinkErrors), U(dev->m_limerRecoveredPackets),
+          U(dev->m_limerRecoveredBytes), U(bw), Empty(), Empty(),
+          nodeType, linkState, Empty(), U(dev->m_limerLinkFlaps),
+          U(dev->m_limerLastLinkDownNs), U(dev->m_limerLastLinkUpNs),
+          U(dev->GetLimerCumulativeDownNs())});
+      state.last_tx_bytes = dev->m_limerTxBytes;
+      state.last_rx_bytes = dev->m_limerRxBytes;
+      state.last_timestamp_ns = now;
+      dev->ResetLimerQueuePeaks();
+    }
+  }
+
+  void SampleHost(ns3::Ptr<ns3::Node> node, uint64_t now) {
+    ns3::Ptr<ns3::RdmaDriver> drv = node->GetObject<ns3::RdmaDriver>();
+    if (!drv || !drv->m_rdma) return;
+    ns3::Ptr<ns3::RdmaHw> hw = drv->m_rdma;
+    uint32_t nodeId = node->GetId();
+    std::map<uint32_t, uint64_t> outstandingByPort;
+    for (auto& kv : hw->m_qpMap) {
+      uint32_t port = hw->GetNicIdxOfQp(kv.second);
+      outstandingByPort[port] += kv.second->GetOnTheFly();
+    }
+    for (uint32_t port = 1; port < hw->m_nic.size(); ++port) {
+      ns3::Ptr<ns3::QbbNetDevice> dev = hw->m_nic[port].dev;
+      if (!dev) continue;
+      std::string linkId = LinkIdFor(nodeId, port);
+      if (linkId.empty()) continue;
+      uint64_t bw = dev->GetDataRate().GetBitRate();
+      auto key = std::make_pair(nodeId, port);
+      EndpointSampleState& state = endpoint_state_[key];
+      double txRate = RateBps(dev->m_limerTxBytes, state.last_tx_bytes,
+                              now, state.last_timestamp_ns);
+      double utilization = bw ? txRate / static_cast<double>(bw) : 0.0;
+      uint64_t nacks = port < hw->m_limerNacksByPort.size()
+                           ? hw->m_limerNacksByPort[port] : 0;
+      std::string linkState = dev->GetLimerLinkUp() ? "up" : "down";
+      if (limer_split_observe_nic) {
+        limer_split_observe_nic(nodeId,port,now,txRate,
+            dev->GetLimerQueueBytes(),outstandingByPort[port],dev->GetLimerLinkUp());
+      }
+      AppendRow(nic_stream_, {
+          run_id_, U(now), U(nodeId), U(nodeId), U(port), linkId,
+          U(dev->m_limerTxPackets), U(dev->m_limerTxBytes),
+          U(dev->m_limerRxPackets), U(dev->m_limerRxBytes),
+          U(dev->m_limerTxDrops), U(dev->m_limerTxDropBytes),
+          U(dev->m_limerRxDrops), U(dev->m_limerRxDropBytes),
+          U(dev->m_limerLinkErrors), U(dev->m_limerRecoveredPackets),
+          U(dev->m_limerRecoveredBytes),
+          U(nacks), U(nacks), Empty(), U(outstandingByPort[port]),
+          D(txRate), Empty(), Empty(), U(dev->GetLimerQueuePackets()),
+          U(dev->GetLimerQueueBytes()), U(dev->m_limerMaxQueuePackets),
+          U(dev->m_limerMaxQueueBytes), U(dev->m_limerMaxQueueTimestampNs),
+          U(bw), linkState, D(utilization), U(dev->m_limerLinkFlaps),
+          U(dev->m_limerLastLinkDownNs), U(dev->m_limerLastLinkUpNs),
+          U(dev->GetLimerCumulativeDownNs())});
+      state.last_tx_bytes = dev->m_limerTxBytes;
+      state.last_rx_bytes = dev->m_limerRxBytes;
+      state.last_timestamp_ns = now;
+      dev->ResetLimerQueuePeaks();
+    }
+  }
