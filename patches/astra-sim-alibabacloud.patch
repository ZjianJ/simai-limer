+  bool GetLinkEndpoints(const std::string& link_id, uint32_t* src_node,
+                        uint32_t* src_port, uint32_t* dst_node,
+                        uint32_t* dst_port) const {
+    for (const auto& e : links_) {
+      if (e.link_id != link_id) continue;
+      if (src_node) *src_node = e.src_node;
+      if (src_port) *src_port = e.src_port;
+      if (dst_node) *dst_node = e.dst_node;
+      if (dst_port) *dst_port = e.dst_port;
+      return true;
+    }
+    return false;
+  }
+
+  // Event-driven switch carrier detector.  The fault injector changes only
+  // the physical link; this method models the independent switch-local
+  // observation, alarm processing, out-of-band delivery, and consumer queue.
+  void ObserveHardDisconnect(const std::string& fault_id,
+                             const std::string& link_id,
+                             uint64_t physical_fault_ns,
+                             const std::string& fault_type) {
+    if (!enabled_ || !hard_event_detector_enabled_ ||
+        alarmed_fault_ids_.count(fault_id)) return;
+    // Deduplicate one physical event, not the port forever.  A later flap on
+    // the same port is a new carrier epoch and must produce a new alarm.
+    alarmed_fault_ids_.insert(fault_id);
+    uint64_t observed = ns3::Simulator::Now().GetNanoSeconds();
+    std::string alarm_id = "alarm-" + fault_id;
+    alarm_fault_type_[alarm_id] = fault_type;
+    ns3::Simulator::Schedule(ns3::NanoSeconds(alarm_processing_ns_),
+        &TelemetryCollector::EmitAlarm, this, alarm_id, fault_id, link_id,
+        physical_fault_ns, observed);
+  }
+
+  // Called from DataSet's weak hook at the true per-rank collective boundary.
+  // Returning true transfers ownership of the notifier to this all-rank
+  // commit gate; no workload rank may advance until all 16 local results are
+  // ready.  A transport failover increments the attempt epoch, while the
+  // deterministic rank/input digest remains invariant across the replay.
+  bool CollectiveLocalComplete(AstraSim::DataSet* dataset) {
+    if (!dataset || dataset->owner_rank < 0 ||
+        static_cast<uint32_t>(dataset->owner_rank) >= true_gpu_count_ ||
+        true_gpu_count_ == 0) {
+      return false;
+    }
+    bool schedule_commit_release = false;
+    uint64_t commit_release_delay_ns = 0;
+#ifdef NS3_MTP
+    MtpInterface::explicitCriticalSection cs;
+#endif
+    CollectiveState& state = collective_states_[dataset->collective_seq];
+    if (state.started.empty()) {
+      state.attempt = collective_transport_epoch_;
+      state.message_size = dataset->message_size;
+      state.layer_num = dataset->layer_num;
+      state.max_ready_timestamp_ns = 0;
+    }
+    dataset->attempt_epoch = state.attempt;
+    auto started = state.started.find(dataset->owner_rank);
+    if (started == state.started.end() || started->second != dataset ||
+        state.ranks.count(dataset->owner_rank) != 0) {
+      std::fprintf(stderr,
+          "LIMER-COMMIT: invalid or duplicate READY for sequence %lu rank %d\n",
+          static_cast<unsigned long>(dataset->collective_seq),
+          dataset->owner_rank);
+      std::exit(2);
+    }
+    state.ranks.emplace(dataset->owner_rank, dataset);
+    // Capture this LP's clock exactly once.  Another rank can already have a
+    // larger local timestamp even though this callback acquires the global
+    // MTP critical section last.
+    const uint64_t ready_timestamp_ns =
+        ns3::Simulator::Now().GetNanoSeconds();
+    state.max_ready_timestamp_ns = CollectiveReadyMaximum(
+        state.max_ready_timestamp_ns, ready_timestamp_ns);
+    AppendCollectiveTxAt(ready_timestamp_ns, dataset->collective_seq,
+        state.attempt, "LOCAL_READY", dataset->owner_rank, state.ranks.size(),
+        "", "ready");
+    if (!state.commit_scheduled && state.ranks.size() == true_gpu_count_) {
+      state.commit_scheduled = true;
+      state.digest = CollectiveDigest(dataset->collective_seq, state);
+      if (state.started.size() != true_gpu_count_) {
+        std::fprintf(stderr,
+            "LIMER-COMMIT: sequence %lu reached READY without all START ranks\n",
+            static_cast<unsigned long>(dataset->collective_seq));
+        std::exit(2);
+      }
+      const uint64_t commit_timestamp_ns = CollectiveCommitTimestamp(
+          ready_timestamp_ns, state.max_ready_timestamp_ns);
+      commit_release_delay_ns = CollectiveCommitDelay(
+          ready_timestamp_ns, commit_timestamp_ns);
+      schedule_commit_release = true;
+    }
+#ifdef NS3_MTP
+    cs.ExitSection();
+#endif
+    if (schedule_commit_release) {
+      ns3::Simulator::Schedule(ns3::NanoSeconds(commit_release_delay_ns),
+          &TelemetryCollector::ReleaseCollective, this,
+          dataset->collective_seq, dataset->attempt_epoch);
+    }
+    return true;
+  }
+
+  void CollectiveStarted(AstraSim::DataSet* dataset) {
+    if (!dataset || dataset->owner_rank < 0 ||
+        static_cast<uint32_t>(dataset->owner_rank) >= true_gpu_count_ ||
+        true_gpu_count_ == 0) return;
+#ifdef NS3_MTP
+    MtpInterface::explicitCriticalSection cs;
+#endif
+    CollectiveState& state = collective_states_[dataset->collective_seq];
+    if (state.started.empty()) {
+      state.attempt = collective_transport_epoch_;
+      state.message_size = dataset->message_size;
+      state.layer_num = dataset->layer_num;
+      state.max_ready_timestamp_ns = 0;
+    }
+    if (state.started.count(dataset->owner_rank) != 0) {
+      std::fprintf(stderr,
+          "LIMER-COMMIT: duplicate START for sequence %lu rank %d\n",
+          static_cast<unsigned long>(dataset->collective_seq),
+          dataset->owner_rank);
+      std::exit(2);
+    }
+    state.started.emplace(dataset->owner_rank, dataset);
+    dataset->attempt_epoch = state.attempt;
+    AppendCollectiveTx(dataset->collective_seq, state.attempt, "START",
+        dataset->owner_rank, state.started.size(), "", "in_flight");
+#ifdef NS3_MTP
+    cs.ExitSection();
+#endif
+  }
+
+  void OnRdmaEvent(uint32_t event_type, ns3::Ptr<ns3::RdmaQueuePair> qp,
+                   uint64_t timestamp_ns, uint64_t detail) {
+    if (!enabled_) return;
+    // ACK_INTERVAL=1 can generate millions of progress callbacks.  Persist
+    // only the first useful ACK on the backup; normal progress remains in the
+    // sampled NIC counters and the terminal SUCCESS WC.
+    if (event_type == ns3::LIMER_RDMA_EVENT_ACK_PROGRESS &&
+        (!qp || qp->m_limerState != ns3::LIMER_RDMA_QP_ACTIVE_BACKUP ||
+         qp->m_backupFirstAckTimestampNs != timestamp_ns)) {
+      return;
+    }
+#ifdef NS3_MTP
+    // QPs are created and completed concurrently by the MTP logical
+    // processes.  std::string append is not thread-safe; without this guard,
+    // simultaneous QP_CREATED/BACKUP_READY rows would interleave a CSV row.
+    MtpInterface::explicitCriticalSection cs;
+#endif
+    std::string event = RdmaEventName(event_type);
+    std::string wc = qp ? RdmaWcName(qp->m_lastWcStatus) : "NONE";
+    uint32_t node_id = qp ? qp->m_src : 0;
+    std::string logical_id;
+    if (qp) {
+      logical_id = std::to_string(qp->m_src) + "-" +
+          std::to_string(qp->m_dest) + "-" + std::to_string(qp->sport) +
+          "-" + std::to_string(qp->m_pg);
+    }
+    AppendRow(rdma_stream_, {
+        run_id_, U(timestamp_ns), qp ? U(node_id) : Empty(),
+        qp ? U(node_id) : Empty(), logical_id, qp ? U(qp->m_epoch) : Empty(),
+        qp ? (qp->GetLimerTrafficClass() == ns3::LIMER_RDMA_TRAFFIC_BACKGROUND
+                  ? "BACKGROUND" : "TRAINING")
+           : "CONTROL",
+        event, U(detail), wc, qp ? U(qp->m_src) : Empty(),
+        qp ? U(qp->m_dest) : Empty(), qp ? U(qp->sport) : Empty(),
+        qp ? U(qp->m_primaryNicIdx) : Empty(),
+        qp ? U(qp->m_backupNicIdx) : Empty(),
+        qp ? U(qp->m_activeNicIdx) : U(detail),
+        qp ? NZ(qp->m_backupReadyTimestampNs) : Empty(),
+        qp ? NZ(qp->m_failoverTimestampNs) : Empty(),
+        qp ? NZ(qp->m_backupFirstTxTimestampNs) : Empty(),
+        qp ? NZ(qp->m_backupFirstAckTimestampNs) : Empty(),
+        qp ? "0" : Empty(), qp ? U(qp->snd_una) : Empty(),
+        qp ? U(qp->snd_nxt) : Empty(), qp ? U(qp->m_retryCount) : Empty(),
+        qp ? U(qp->m_retryLimit) : Empty(), qp ? U(qp->m_rtoUs) : Empty()});
+#ifdef NS3_MTP
+    cs.ExitSection();
+#endif
+  }
+
+ private:
+  struct CollectiveState {
+    std::map<int, AstraSim::DataSet*> started;
+    std::map<int, AstraSim::DataSet*> ranks;
+    uint64_t attempt = 0;
+    uint64_t message_size = 0;
+    // Attempt-scoped.  It is reset both at first START and when recovery
+    // advances the attempt, so an old attempt cannot push a later COMMIT.
+    uint64_t max_ready_timestamp_ns = 0;
+    int layer_num = -1;
+    bool commit_scheduled = false;
+    bool commit_released = false;
+    std::string digest;
+  };
+
+  // Run COMMIT evidence and application release in one simulator callback.
+  // The first scheduling delay aligns this LP with the greatest READY clock;
+  // the guard below is fail-safe for any backend that invokes us earlier.
+  void ReleaseCollective(uint64_t sequence, uint64_t scheduled_attempt) {
+    std::vector<AstraSim::DataSet*> to_commit;
+    uint64_t retry_delay_ns = 0;
+#ifdef NS3_MTP
+    MtpInterface::explicitCriticalSection cs;
+#endif
+    auto found = collective_states_.find(sequence);
+    if (found == collective_states_.end() || !found->second.commit_scheduled ||
+        found->second.commit_released ||
+        found->second.attempt != scheduled_attempt ||
+        found->second.started.size() != true_gpu_count_ ||
+        found->second.ranks.size() != true_gpu_count_) {
+      std::fprintf(stderr,
+          "LIMER-COMMIT: invalid scheduled release for sequence %lu\n",
+          static_cast<unsigned long>(sequence));
+      std::exit(2);
+    }
+    CollectiveState& state = found->second;
+    const uint64_t now_ns = ns3::Simulator::Now().GetNanoSeconds();
+    if (now_ns < state.max_ready_timestamp_ns) {
+      retry_delay_ns = state.max_ready_timestamp_ns - now_ns;
+    } else {
+      state.commit_released = true;
+      AppendCollectiveTxAt(now_ns, sequence, state.attempt, "COMMIT", -1,
+          state.ranks.size(), state.digest, "exactly_once");
+      for (const auto& participant : state.ranks) {
+        to_commit.push_back(participant.second);
+      }
+    }
+#ifdef NS3_MTP
+    cs.ExitSection();
+#endif
+    if (retry_delay_ns != 0) {
+      ns3::Simulator::Schedule(ns3::NanoSeconds(retry_delay_ns),
+          &TelemetryCollector::ReleaseCollective, this, sequence,
+          scheduled_attempt);
+      return;
+    }
+    for (auto* ready : to_commit) {
+      ns3::Simulator::ScheduleNow(
+          &AstraSim::DataSet::commit_after_barrier, ready);
+    }
+  }
+
+  void AbortInFlightCollectives() {
+#ifdef NS3_MTP
+    MtpInterface::explicitCriticalSection cs;
+#endif
+    uint64_t old_attempt = collective_transport_epoch_;
+    ++collective_transport_epoch_;
+    for (auto& kv : collective_states_) {
+      CollectiveState& state = kv.second;
+      if (state.commit_scheduled || state.started.empty()) continue;
+      AppendCollectiveTx(kv.first, old_attempt, "ABORT", -1,
+          state.ranks.size(), "", "fault_before_commit");
+      state.attempt = collective_transport_epoch_;
+      state.max_ready_timestamp_ns = 0;
+      for (auto& participant : state.started)
+        participant.second->attempt_epoch = state.attempt;
+      AppendCollectiveTx(kv.first, state.attempt, "REDO_START", -1,
+          state.ranks.size(), "", "safe_replay_from_cumulative_ack");
+    }
+#ifdef NS3_MTP
+    cs.ExitSection();
+#endif
+  }
+
+  void StopAtObservationHorizon() {
+    if (!enabled_) return;
+#ifdef NS3_MTP
+    MtpInterface::explicitCriticalSection cs;
+#endif
+    AppendRow(lifecycle_stream_, {
+        run_id_, "observation_horizon", U(observation_stop_ns_),
+        U(ns3::Simulator::Now().GetNanoSeconds()), U(finished_rank_count_),
+        U(finish_world_size_ ? finish_world_size_ : true_gpu_count_),
+        workload_completed_ ? "OBSERVATION_WINDOW_COMPLETE_AFTER_WORKLOAD"
+                            : "OBSERVATION_WINDOW_COMPLETE_WORKLOAD_INCOMPLETE"});
+#ifdef NS3_MTP
+    cs.ExitSection();
+#endif
+    ns3::Simulator::Stop();
+  }
+
+  static uint64_t FnvMix(uint64_t hash, uint64_t value) {
+    for (unsigned i = 0; i < 8; ++i) {
+      hash ^= (value >> (i * 8)) & 0xff;
+      hash *= 1099511628211ULL;
+    }
+    return hash;
+  }
+
+  std::string CollectiveDigest(uint64_t sequence,
+                               const CollectiveState& state) const {
+    uint64_t hash = 1469598103934665603ULL;
+    hash = FnvMix(hash, sequence);
+    hash = FnvMix(hash, state.message_size);
+    hash = FnvMix(hash, static_cast<uint64_t>(state.layer_num));
+    for (const auto& kv : state.ranks) {
+      hash = FnvMix(hash, static_cast<uint64_t>(kv.first));
+      hash = FnvMix(hash, kv.second->message_size);
+      hash = FnvMix(hash, static_cast<uint64_t>(kv.second->collective_type));
+    }
+    std::ostringstream out;
+    out << std::hex << hash;
+    return out.str();
+  }
+
+  void AppendCollectiveTx(uint64_t sequence, uint64_t attempt,
+                          const std::string& event, int rank,
+                          size_t ready, const std::string& digest,
+                          const std::string& status) {
+    AppendCollectiveTxAt(ns3::Simulator::Now().GetNanoSeconds(), sequence,
+                         attempt, event, rank, ready, digest, status);
+  }
+
+  void AppendCollectiveTxAt(uint64_t timestamp_ns, uint64_t sequence,
+                            uint64_t attempt, const std::string& event,
+                            int rank, size_t ready,
+                            const std::string& digest,
+                            const std::string& status) {
+    auto state = collective_states_.find(sequence);
+    std::string layer_num = Empty();
+    std::string message_size = Empty();
+    if (state != collective_states_.end()) {
+      layer_num = std::to_string(state->second.layer_num);
+      message_size = U(state->second.message_size);
+    }
+    AppendRow(collective_tx_stream_, {
+        run_id_, U(timestamp_ns), U(sequence),
+        U(attempt), layer_num, message_size, event,
+        rank < 0 ? Empty() : std::to_string(rank), U(true_gpu_count_),
+        U(ready), digest, status});
+  }
+
+  static uint64_t EnvUs(const char* name, uint64_t fallback) {
+    const char* value = std::getenv(name);
+    return value ? std::strtoull(value, nullptr, 10) : fallback;
+  }
+
+  static bool EnvEnabled(const char* name, bool fallback) {
+    const char* value = std::getenv(name);
+    if (!value) return fallback;
+    const std::string text(value);
+    if (text == "1" || text == "true" || text == "TRUE" ||
+        text == "yes" || text == "YES") return true;
+    if (text == "0" || text == "false" || text == "FALSE" ||
+        text == "no" || text == "NO") return false;
+    std::fprintf(stderr,
+        "LIMER: invalid boolean %s=%s (expected 0/1/false/true)\n",
+        name, value);
+    std::exit(2);
+  }
