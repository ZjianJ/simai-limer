diff --git a/astra-sim-alibabacloud/astra-sim/network_frontend/ns3/limer_wait_model.h b/astra-sim-alibabacloud/astra-sim/network_frontend/ns3/limer_wait_model.h
new file mode 100644
index 0000000..4114871
--- /dev/null
+++ b/astra-sim-alibabacloud/astra-sim/network_frontend/ns3/limer_wait_model.h
@@ -0,0 +1,159 @@
+#ifndef LIMER_WAIT_MODEL_H
+#define LIMER_WAIT_MODEL_H
+
+// Endpoint-only, transport-independent conditional waiting-time model.
+// Time is measured from first TX through chunk ACK completion, in ns. The
+// launch_active condition must be captured once at launch and reused unchanged
+// for both completion observations and unfinished-chunk queries. It should
+// count this source's in-flight chunks on the selected rail, including itself.
+//
+// This is an online robust log-duration heuristic, NOT a calibrated survival
+// distribution or fault probability. It needs no fault schedule, oracle
+// capacity, switch queue, offline training, or GP. The caller decides when to
+// query it (ACK callbacks and/or a separately modelled host timer).
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <map>
+#include <stdexcept>
+#include <tuple>
+
+namespace limer {
+class WaitModel {
+ public:
+  struct Evidence {
+    double factor = 1.0;
+    double threshold_ns = 0.0;
+    uint64_t samples = 0;   // Accepted normal-history observations.
+    uint64_t rejected = 0;  // Mature positive outliers excluded from learning.
+    bool ready = false;
+    unsigned size_bucket = 0;
+    unsigned load_bucket = 0;
+  };
+
+  // Allocation is bounded even for arbitrary source IDs or changing workloads.
+  // New conditions after the cap remain cold rather than evicting healthy
+  // references or sharing another source/rail's history.
+  explicit WaitModel(size_t max_contexts = 4096) : max_contexts_(max_contexts) {
+    if (!max_contexts_) throw std::invalid_argument("wait model needs contexts");
+  }
+
+  static unsigned MinimumSamples() { return 8; }
+  static double MinimumFactor() { return 0.1; }
+  size_t ContextCount() const { return history_.size(); }
+  uint64_t DroppedObservations() const { return dropped_observations_; }
+
+  void Observe(unsigned src, unsigned rail, uint64_t bytes,
+               unsigned launch_active, uint64_t elapsed_ns) {
+    const Key key = MakeKey(src, rail, bytes, launch_active);
+    if (!elapsed_ns) throw std::invalid_argument("zero chunk completion time");
+    auto it = history_.find(key);
+    if (it == history_.end()) {
+      if (history_.size() == max_contexts_) {
+        Increment(dropped_observations_);
+        return;
+      }
+      it = history_.emplace(key, Statistics{}).first;
+    }
+    auto& s = it->second;
+    const double x = std::log(static_cast<double>(elapsed_ns));
+    if (!s.samples) {
+      s.mean_log = x;
+      s.samples = 1;
+      return;
+    }
+    if (s.samples < MinimumSamples()) {
+      // A bounded warm-up obtains a conditional reference without assuming
+      // a fixed network rate. Faults during warm-up can contaminate it.
+      const double delta = x - s.mean_log;
+      const double next_mean = s.mean_log + delta / (s.samples + 1);
+      s.variance_log = ((s.samples - 1) * s.variance_log +
+                        delta * (x - next_mean)) / s.samples;
+      s.mean_log = next_mean;
+      Increment(s.samples);
+      return;
+    }
+    const double sigma = Sigma(s);
+    // Do not immediately relearn a sustained large slowdown as normal.
+    // A legitimate permanent regime change may also be rejected: this is an
+    // explicit limitation, not a fault label or an automatic recovery rule.
+    if (x > s.mean_log + 3.0 * sigma) {
+      Increment(s.rejected);
+      return;
+    }
+    const double residual = std::max(-2.0 * sigma,
+                                    std::min(2.0 * sigma, x - s.mean_log));
+    const double alpha = 1.0 / 32.0;
+    s.mean_log += alpha * residual;
+    s.variance_log = (1.0 - alpha) *
+        (s.variance_log + alpha * residual * residual);
+    Increment(s.samples);
+  }
+
+  Evidence Evaluate(unsigned src, unsigned rail, uint64_t bytes,
+                    unsigned launch_active, uint64_t age_ns) const {
+    const Key key = MakeKey(src, rail, bytes, launch_active);
+    Evidence e;
+    e.size_bucket = std::get<2>(key);
+    e.load_bucket = std::get<3>(key);
+    const auto it = history_.find(key);
+    if (it == history_.end()) return e;
+    const auto& s = it->second;
+    e.samples = s.samples;
+    e.rejected = s.rejected;
+    if (s.samples < MinimumSamples()) return e;
+    e.ready = true;
+    const double log_max_time =
+        std::log(static_cast<double>(std::numeric_limits<uint64_t>::max()));
+    e.threshold_ns = std::exp(std::min(log_max_time,
+                                      s.mean_log + 3.0 * Sigma(s)));
+    if (age_ns) {
+      e.factor = std::max(MinimumFactor(), std::min(1.0,
+          e.threshold_ns / static_cast<double>(age_ns)));
+    }
+    return e;
+  }
+
+  double Penalty(unsigned src, unsigned rail, uint64_t bytes,
+                 unsigned launch_active, uint64_t age_ns) const {
+    return Evaluate(src, rail, bytes, launch_active, age_ns).factor;
+  }
+
+ private:
+  using Key = std::tuple<unsigned, unsigned, unsigned, unsigned>;
+  struct Statistics {
+    double mean_log = 0.0;
+    double variance_log = 0.0;
+    uint64_t samples = 0;
+    uint64_t rejected = 0;
+  };
+  static unsigned Bucket(uint64_t value) {
+    // ceil(log2(value)); integer arithmetic handles UINT64_MAX safely.
+    unsigned bucket = 0;
+    for (--value; value; value >>= 1) ++bucket;
+    return bucket;
+  }
+  static Key MakeKey(unsigned src, unsigned rail, uint64_t bytes,
+                     unsigned launch_active) {
+    if (rail > 1 || !bytes || !launch_active)
+      throw std::invalid_argument("invalid conditional wait sample");
+    return {src, rail, Bucket(bytes), Bucket(launch_active)};
+  }
+  static double Sigma(const Statistics& s) {
+    // Normal queue/completion variation needs tolerance even if the first
+    // eight samples happen to be identical. 3*sigma gives a minimum 1.953x
+    // threshold above geometric mean; constants are not seed-tuned.
+    return std::max(std::log(1.25),
+                    std::sqrt(std::max(0.0, s.variance_log)));
+  }
+  static void Increment(uint64_t& value) {
+    if (value != std::numeric_limits<uint64_t>::max()) ++value;
+  }
+  size_t max_contexts_;
+  uint64_t dropped_observations_ = 0;
+  std::map<Key, Statistics> history_;
+};
+}  // namespace limer
+#endif
