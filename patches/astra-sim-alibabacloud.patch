+// LIMER env-compat patch: upstream hardcoded "/etc/astra-sim/", which is not
+// writable on non-root HPC accounts. Resolve from ASTRA_SIM_LOG_DIR (set by
+// limer/scripts/*) or fall back to $HOME/.astra-sim/. Log destination only;
+// no effect on simulation/collective semantics.
+inline std::string LimerResolveAstraSimLogDir() {
+  if (const char* envDir = std::getenv("ASTRA_SIM_LOG_DIR")) {
+    return std::string(envDir) + "/";
+  }
+  const char* home = std::getenv("HOME");
+  return (home ? std::string(home) : std::string(".")) + "/.astra-sim/";
+}
+#define LOG_PATH LimerResolveAstraSimLogDir()
 
