+  Interface& b_to_a = b_entry->second.find(a)->second;
+  NS_ABORT_MSG_IF(a_to_b.up != b_to_a.up,
+                  "PhysicalLinkDown found asymmetric nbr2if state");
+  if (!a_to_b.up)
+    return false;
+  Ptr<QbbNetDevice> a_dev =
+      DynamicCast<QbbNetDevice>(a->GetDevice(a_to_b.idx));
+  Ptr<QbbNetDevice> b_dev =
+      DynamicCast<QbbNetDevice>(b->GetDevice(b_to_a.idx));
+  NS_ABORT_MSG_IF(a_dev == 0 || b_dev == 0,
+                  "PhysicalLinkDown requires QbbNetDevice endpoints");
+  Ptr<QbbChannel> a_channel = DynamicCast<QbbChannel>(a_dev->GetChannel());
+  Ptr<QbbChannel> b_channel = DynamicCast<QbbChannel>(b_dev->GetChannel());
+  NS_ABORT_MSG_IF(a_channel == 0 || a_channel != b_channel,
