+      std::lock_guard<std::mutex> lock(mu);
+      uint64_t limit=policy->ChunkFeedback() && !policy->HasChunkFeedback(src) ? 2:max_active;
+      while (active[src]<limit && !pending[src].empty()) {
+        batch.push_back(std::move(pending[src].front()));
+        pending[src].pop_front(); ++active[src];
+        if(policy->Censored()) RecordQueue(src,"POP",limit);
+      }
