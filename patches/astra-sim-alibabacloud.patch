+  static int EventOrder(const std::string& event) {
+    if (event == "SCHEDULED") return 0;
+    if (event == "START") return 1;
+    if (event == "COMPLETE") return 2;
+    return 3;
+  }
+
+  static bool EventLess(const EventRecord& left, const EventRecord& right) {
+    const uint64_t left_time =
+        left.has_actual ? left.actual_ns : left.scheduled_start_ns;
+    const uint64_t right_time =
+        right.has_actual ? right.actual_ns : right.scheduled_start_ns;
+    const int left_order = EventOrder(left.event);
+    const int right_order = EventOrder(right.event);
+    return std::tie(left_time, left.scheduled_start_ns, left.flow_id,
+                    left_order) <
+           std::tie(right_time, right.scheduled_start_ns, right.flow_id,
+                    right_order);
+  }
+
+  static bool RouteEventLess(const RouteEventRecord& left,
+                             const RouteEventRecord& right) {
+    return std::tie(left.timestamp_ns, left.flow_id, left.direction,
+                    left.packet_type, left.node_id, left.packet_sip,
+                    left.packet_dip, left.packet_sport, left.packet_dport,
+                    left.egress_port_id) <
+           std::tie(right.timestamp_ns, right.flow_id, right.direction,
+                    right.packet_type, right.node_id, right.packet_sip,
+                    right.packet_dip, right.packet_sport, right.packet_dport,
+                    right.egress_port_id);
+  }
+
+  static bool CongestionEventLess(const CongestionEventRecord& left,
+                                  const CongestionEventRecord& right) {
+    return std::tie(left.timestamp_ns, left.event_type, left.node_id,
+                    left.port_id, left.flow_id, left.pg) <
+           std::tie(right.timestamp_ns, right.event_type, right.node_id,
+                    right.port_id, right.flow_id, right.pg);
+  }
+
+  static std::string Csv(const std::string& value) {
+    if (value.find_first_of(",\"\r\n") == std::string::npos) return value;
+    std::string escaped = "\"";
+    for (char c : value) {
+      if (c == '\"') escaped += '\"';
+      escaped += c;
+    }
+    escaped += "\"";
+    return escaped;
+  }
+
+  void WriteEvent(std::ofstream& output, const EventRecord& event) const {
+    output << Csv(run_id_) << ',' << event.event_id << ',' << event.flow_id
+           << ',' << event.scenario << ',' << event.event << ','
+           << event.scheduled_start_ns << ',';
+    if (event.has_actual) output << event.actual_ns;
+    output << ',';
+    if (event.has_first_tx) output << event.first_tx_ns;
+    output << ',';
+    if (event.has_first_ack) output << event.first_ack_ns;
+    output << ',' << event.src_rank << ',' << event.dst_rank << ','
+           << event.bytes << ',' << event.pg << ',' << event.sport << ','
+           << event.dport << ',' << event.status << '\n';
+  }
+
+  void WriteRouteEvent(std::ofstream& output,
+                       const RouteEventRecord& event) const {
+    output << Csv(run_id_) << ',' << event.event_id << ',' << event.flow_id
+           << ',' << event.scenario << ',' << event.direction << ','
+           << event.packet_type << ',' << event.timestamp_ns << ','
+           << event.flow_src_rank << ',' << event.flow_dst_rank << ','
+           << event.flow_sport << ',' << event.flow_dport << ','
+           << event.node_id << ',' << event.node_type << ','
+           << event.packet_sip << ',' << event.packet_dip << ','
+           << event.packet_sport << ',' << event.packet_dport << ','
+           << event.pg << ',' << event.l3_protocol << ',' << event.ecmp_seed
+           << ',' << event.ecmp_hash << ',' << event.candidate_count << ','
+           << event.bucket << ',' << event.egress_port_id << ','
+           << event.next_hop_node_id << ',' << event.link_id << ','
+           << event.status << '\n';
+  }
+
+  void WriteCongestionEvent(std::ofstream& output,
+                            const CongestionEventRecord& event) const {
+    output << Csv(run_id_) << ',' << event.event_id << ',' << event.flow_id
+           << ',' << event.scenario << ',' << event.event_type << ','
+           << event.timestamp_ns << ',' << event.node_id << ','
+           << event.node_type << ',' << event.port_id << ',' << event.link_id
+           << ',';
+    if (event.has_trigger_out_port) output << event.trigger_out_port;
+    output << ',' << event.trigger_link_id << ',' << event.pg << ',';
+    if (event.has_flow) {
+      output << event.flow_src << ',' << event.flow_dst << ','
+             << event.flow_sport << ',' << event.flow_dport;
+    } else {
+      output << ",,,";
+    }
+    output << ',';
+    if (event.has_packet) {
+      output << event.packet_sip << ',' << event.packet_dip << ','
+             << event.packet_sport << ',' << event.packet_dport;
+    } else {
+      output << ",,,";
+    }
+    output << ',';
+    if (event.has_queue) output << event.queue_bytes;
+    output << ',';
+    if (event.has_shared) output << event.shared_used_bytes;
+    output << ',';
+    if (event.has_thresholds) output << event.threshold_low_bytes;
+    output << ',';
+    if (event.has_thresholds) output << event.threshold_high_bytes;
+    output << ',';
+    if (event.has_headroom) output << event.headroom_bytes;
+    output << ',' << event.signal_before << ',' << event.signal_after << ','
+           << event.pause_time << ',';
+    if (event.has_rate) {
+      output << event.old_rate_bps << ',' << event.new_rate_bps;
+    } else {
+      output << ',';
+    }
+    output << ',' << event.cc_mode << ',' << event.status << '\n';
+  }
+
+  void WriteCongestionSummary(const char* status) const {
+    std::ofstream output(congestion_summary_path_.c_str(),
+                         std::ios::out | std::ios::trunc);
+    if (!output.is_open()) Fail("cannot open output: " + congestion_summary_path_);
+    output << CongestionSummaryHeader() << '\n' << Csv(run_id_) << ','
+           << congestion_window_start_ns_ << ',' << congestion_window_end_ns_
+           << ',' << congestion_max_events_ << ',' << congestion_seen_ << ','
+           << congestion_events_.size() << ',' << congestion_unbound_ << ','
+           << congestion_filtered_ << ',' << congestion_overflow_ << ','
+           << status << '\n';
+    output.close();
+    if (output.fail()) Fail("failed writing output: " + congestion_summary_path_);
+  }
+
+  void WriteRouteSummary(const char* status) const {
+    const ns3::LimerRouteChoiceCounters counters =
+        ns3::GetLimerRouteChoiceCounters();
+    std::ofstream output(route_summary_path_.c_str(),
+                         std::ios::out | std::ios::trunc);
+    if (!output.is_open()) Fail("cannot open output: " + route_summary_path_);
+    output << RouteSummaryHeader() << '\n' << Csv(run_id_) << ','
+           << counters.max_events << ',' << counters.seen << ','
+           << counters.recorded << ',' << counters.deduplicated << ','
+           << counters.overflow << ',' << status << '\n';
+    output.close();
+    if (output.fail()) Fail("failed writing output: " + route_summary_path_);
+  }
+
+  bool initialized_ = false;
+  bool enabled_ = false;
+  bool closed_ = false;
+  bool route_sink_registered_ = false;
+  bool congestion_sink_registered_ = false;
+  std::string schedule_path_;
+  std::string output_path_;
+  std::string route_output_path_;
+  std::string route_summary_path_;
+  std::string congestion_output_path_;
+  std::string congestion_summary_path_;
+  std::string run_id_;
+  std::vector<FlowSpec> flows_;
+  std::map<QpKey, std::size_t> states_;
+  std::vector<EventRecord> events_;
+  std::vector<RouteEventRecord> route_events_;
+  std::vector<CongestionEventRecord> congestion_events_;
+  uint64_t congestion_window_start_ns_ = 0;
+  uint64_t congestion_window_end_ns_ = 0;
+  uint64_t congestion_max_events_ = 1000000;
+  uint64_t route_max_events_ = 1000000;
+  uint64_t congestion_seen_ = 0;
+  uint64_t congestion_unbound_ = 0;
+  uint64_t congestion_filtered_ = 0;
+  uint64_t congestion_overflow_ = 0;
+  std::mutex mu_;
+};
+
+}  // namespace limer
+
+#endif  // LIMER_BACKGROUND_FLOW_H
diff --git a/astra-sim-alibabacloud/astra-sim/network_frontend/ns3/limer_censored_model.h b/astra-sim-alibabacloud/astra-sim/network_frontend/ns3/limer_censored_model.h
new file mode 100644
index 0000000..527ca39
--- /dev/null
+++ b/astra-sim-alibabacloud/astra-sim/network_frontend/ns3/limer_censored_model.h
@@ -0,0 +1,221 @@
+#ifndef LIMER_CENSORED_MODEL_H
+#define LIMER_CENSORED_MODEL_H
+
+// Bounded endpoint evidence for right-censored chunk completion feedback.
+//
+// The target is a CLIPPED, launch-load-normalized chunk-rate utility, not link
+// capacity, aggregate goodput, or the unbounded mean chunk rate. For record i:
+//   scale_i = nominal_bps / ceil_pow2(launch_active_i)
+//   X_i = min(1, bytes_i * 8e9 / (completion_age_ns_i * scale_i)).
+// An unfinished chunk with current age a only establishes
+//   0 <= X_i <= min(1, bytes_i * 8e9 / (a * scale_i)).
+// This partial-identification interval is deterministic for the selected
+// records. A Hoeffding-shaped expansion is a WORKING uncertainty band only:
+// adaptive scheduling, shared queues, varying launch loads, selected history,
+// and faults violate the fixed iid/stationary assumptions needed to interpret
+// delta as a coverage guarantee. It is not a calibrated survival model or GP.
+//
+// IDs must uniquely identify chunks within each (source, rail), with their
+// numeric order equal to assignment order. Admit only true-first-TX records;
+// repeated timer observations update one record, and completion replaces it.
+// Membership is the highest `window` admitted IDs, plus any older live pending
+// records. Completed samples older than horizon (measured from first TX) are
+// omitted on query; pending samples never age out. This deliberately uses a
+// nonstationary, live-pending-aware history rather than claiming an unbiased
+// population sample. include_pending=false changes evidence, not membership.
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <set>
+#include <stdexcept>
+#include <utility>
+
+namespace limer {
+class CensoredModel {
+ public:
+  struct Evidence {
+    double identified_lower = 0.0;
+    double identified_upper = 1.0;
+    double lower = 0.0;
+    double upper = 1.0;
+    double radius = 1.0;
+    uint64_t count = 0;
+    uint64_t completed = 0;
+    uint64_t pending = 0;
+    uint64_t last_completed_ns = 0;
+    bool ready = false;
+  };
+
+  explicit CensoredModel(size_t window = 64, uint64_t horizon_ns = 250000,
+                         double delta = 0.05, size_t max_contexts = 4096,
+                         size_t max_pending = 8)
+      : window_(window), horizon_ns_(horizon_ns), delta_(delta),
+        max_contexts_(max_contexts), max_pending_(max_pending) {
+    if (!window_ || !horizon_ns_ || !(delta_ > 0.0 && delta_ < 1.0) ||
+        !max_contexts_ || !max_pending_)
+      throw std::invalid_argument("invalid censored model configuration");
+  }
+
+  static unsigned MinimumSamples() { return 8; }
+  static double UtilityScaleBps(unsigned launch_active) {
+    if (!launch_active)
+      throw std::invalid_argument("zero censored launch load");
+    uint64_t bucket = 1;
+    while (bucket < launch_active) bucket <<= 1;
+    return 100e9 / static_cast<double>(bucket);
+  }
+  size_t ContextCount() const { return history_.size(); }
+  size_t RecordCount() const {
+    size_t n = 0;
+    for (const auto& item : history_) n += item.second.records.size();
+    return n;
+  }
+  uint64_t DroppedObservations() const { return dropped_observations_; }
+
+  // Returns false for a new context beyond the allocation cap or a completed
+  // old record outside the assignment window. Repeated complete observations
+  // are idempotent, but conflicting immutable metadata/time is an error.
+  bool Upsert(unsigned src, unsigned rail, uint64_t id, uint64_t bytes,
+              unsigned launch_active, uint64_t first_tx_ns, uint64_t now_ns,
+              bool completed) {
+    ValidateRail(rail);
+    if (!bytes || !launch_active || now_ns < first_tx_ns ||
+        (completed && now_ns == first_tx_ns))
+      throw std::invalid_argument("invalid censored observation");
+    const Key key{src, rail};
+    auto group = history_.find(key);
+    if (group == history_.end()) {
+      if (history_.size() == max_contexts_) {
+        ++dropped_observations_;
+        return false;
+      }
+      group = history_.emplace(key, Context{}).first;
+    }
+    auto& context = group->second;
+    auto known = context.records.find(id);
+    if (known != context.records.end()) {
+      auto& record = known->second;
+      if (record.bytes != bytes || record.launch_active != launch_active ||
+          record.first_tx_ns != first_tx_ns)
+        throw std::invalid_argument("censored record identity changed");
+      if (now_ns < record.last_observed_ns)
+        throw std::invalid_argument("censored observation moved backwards");
+      if (record.completed) {
+        if (completed && record.completion_ns != now_ns)
+          throw std::invalid_argument("censored completion changed");
+        return true;  // Never turn a completed sample back into pending.
+      }
+      record.last_observed_ns = now_ns;
+      if (completed) {
+        record.completed = true;
+        record.completion_ns = now_ns;
+        if (!context.recent_ids.count(id)) context.records.erase(known);
+      }
+      return true;
+    }
+
+    const bool outside_window = context.recent_ids.size() == window_ &&
+                                id < *context.recent_ids.begin();
+    if (completed && outside_window) return false;
+    if (!completed) {
+      size_t active = 0;
+      for (const auto& item : context.records)
+        if (!item.second.completed) ++active;
+      if (active == max_pending_)
+        throw std::length_error("too many live censored records");
+    }
+    Record record;
+    record.bytes = bytes;
+    record.launch_active = launch_active;
+    record.first_tx_ns = first_tx_ns;
+    record.last_observed_ns = now_ns;
+    record.completed = completed;
+    record.completion_ns = completed ? now_ns : 0;
+    context.records.emplace(id, record);
+    context.recent_ids.insert(id);
+    if (context.recent_ids.size() > window_) {
+      const uint64_t evicted_id = *context.recent_ids.begin();
+      context.recent_ids.erase(context.recent_ids.begin());
+      const auto evicted = context.records.find(evicted_id);
+      if (evicted != context.records.end() && evicted->second.completed)
+        context.records.erase(evicted);
+    }
+    return true;
+  }
+
+  Evidence Evaluate(unsigned src, unsigned rail, uint64_t now_ns,
+                    bool include_pending = true) const {
+    ValidateRail(rail);
+    Evidence evidence;
+    const auto group = history_.find(Key{src, rail});
+    if (group == history_.end()) return evidence;
+    double lower_sum = 0.0;
+    double upper_sum = 0.0;
+    for (const auto& item : group->second.records) {
+      const auto& record = item.second;
+      if (now_ns < record.last_observed_ns)
+        throw std::invalid_argument("censored query uses future evidence");
+      if (record.completed) {
+        if (now_ns - record.first_tx_ns > horizon_ns_) continue;
+        const double utility = Utility(record,
+            record.completion_ns - record.first_tx_ns);
+        lower_sum += utility;
+        upper_sum += utility;
+        ++evidence.completed;
+        evidence.last_completed_ns = std::max(evidence.last_completed_ns,
+                                              record.completion_ns);
+      } else {
+        if (!include_pending) continue;
+        upper_sum += Utility(record, now_ns - record.first_tx_ns);
+        ++evidence.pending;
+      }
+    }
+    evidence.count = evidence.completed + evidence.pending;
+    if (!evidence.count) return evidence;
+    const double n = static_cast<double>(evidence.count);
+    evidence.identified_lower = lower_sum / n;
+    evidence.identified_upper = upper_sum / n;
+    evidence.radius = std::sqrt(std::log(2.0 / delta_) / (2.0 * n));
+    evidence.lower = std::max(0.0,
+        evidence.identified_lower - evidence.radius);
+    evidence.upper = std::min(1.0,
+        evidence.identified_upper + evidence.radius);
+    evidence.ready = evidence.count >= MinimumSamples();
+    return evidence;
+  }
+
+ private:
+  using Key = std::pair<unsigned, unsigned>;
+  struct Record {
+    uint64_t bytes = 0;
+    unsigned launch_active = 0;
+    uint64_t first_tx_ns = 0;
+    uint64_t last_observed_ns = 0;
+    uint64_t completion_ns = 0;
+    bool completed = false;
+  };
+  struct Context {
+    std::set<uint64_t> recent_ids;
+    std::map<uint64_t, Record> records;
+  };
+  static void ValidateRail(unsigned rail) {
+    if (rail > 1) throw std::invalid_argument("invalid censored rail");
+  }
+  static double Utility(const Record& record, uint64_t age_ns) {
+    if (!age_ns) return 1.0;
+    return std::min(1.0, static_cast<double>(record.bytes) * 8e9 /
+        (static_cast<double>(age_ns) * UtilityScaleBps(record.launch_active)));
+  }
+  size_t window_;
+  uint64_t horizon_ns_;
+  double delta_;
+  size_t max_contexts_;
+  size_t max_pending_;
+  uint64_t dropped_observations_ = 0;
+  std::map<Key, Context> history_;
+};
+}  // namespace limer
+#endif
diff --git a/astra-sim-alibabacloud/astra-sim/network_frontend/ns3/limer_sparse_signal.h b/astra-sim-alibabacloud/astra-sim/network_frontend/ns3/limer_sparse_signal.h
new file mode 100644
index 0000000..c3eec3e
--- /dev/null
+++ b/astra-sim-alibabacloud/astra-sim/network_frontend/ns3/limer_sparse_signal.h
@@ -0,0 +1,48 @@
+#ifndef LIMER_SPARSE_SIGNAL_H
+#define LIMER_SPARSE_SIGNAL_H
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <stdexcept>
+namespace limer {
+// Algorithm state per switch ACCESS egress port, excluding existing hardware
+// counters, timer/runtime plumbing and exported audit logs. No fault inputs.
+struct SparseEgressSignal {
+  uint64_t last_ns=0,last_bytes=0,last_sent_ns=0;
+  double reference_bps=0;
+  uint32_t last_queue=0;
+  float factor=1,last_sent_factor=1;
+  uint16_t low_windows=0;
+  uint8_t initialized=0;
+  bool Sample(uint64_t now,uint64_t tx_bytes,uint64_t queue,bool up,
+              uint64_t heartbeat_ns,double& observed_bps,bool& demand) {
+    observed_bps=0;demand=false;
+    if(initialized && (now<=last_ns || tx_bytes<last_bytes))
+      throw std::invalid_argument("noncausal switch sample");
+    if(initialized) {
+      observed_bps=(tx_bytes-last_bytes)*8e9/(now-last_ns);
+      // This is demand evidence, not proof of continuous saturation. TX counts
+      // bytes at serialization start and must not be called delivered goodput.
+      demand=last_queue>0 && queue>0;
+      if(!up) { factor=0.1f;low_windows=0; }
+      else if(demand) {
+        reference_bps=std::max(reference_bps,observed_bps);
+        double ratio=reference_bps>0 ? observed_bps/reference_bps:1;
+        if(ratio<0.7) low_windows=std::min<unsigned>(low_windows+1,65535);
+        else low_windows=0;
+        factor=low_windows>=2 ? std::max(0.1,std::min(1.,ratio)):1;
+      } else { factor=1;low_windows=0; }
+    }
+    if(!up) {factor=0.1f;low_windows=0;}
+    last_ns=now;last_bytes=tx_bytes;
+    last_queue=static_cast<uint32_t>(std::min<uint64_t>(queue,UINT32_MAX));
+    bool send=!initialized || std::abs(factor-last_sent_factor)>=0.1f ||
+        now-last_sent_ns>=heartbeat_ns;
+    initialized=1;
+    if(send) {last_sent_ns=now;last_sent_factor=factor;}
+    return send;
+  }
+};
+static_assert(sizeof(SparseEgressSignal)<=48,"switch algorithm state exceeds 48 bytes");
+} // namespace limer
+#endif
diff --git a/astra-sim-alibabacloud/astra-sim/network_frontend/ns3/limer_split_policy.h b/astra-sim-alibabacloud/astra-sim/network_frontend/ns3/limer_split_policy.h
new file mode 100644
index 0000000..65befbe
--- /dev/null
+++ b/astra-sim-alibabacloud/astra-sim/network_frontend/ns3/limer_split_policy.h
@@ -0,0 +1,269 @@
+#ifndef LIMER_SPLIT_POLICY_H
+#define LIMER_SPLIT_POLICY_H
+
+// Transport-independent baseline policies. Rates are useful bits/s, time ns,
+// and reservations unique payload bytes (never added to their own queue copy).
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <limits>
+#include <map>
+#include <stdexcept>
+#include <string>
+#include <tuple>
+#include <vector>
+#include "limer_wait_model.h"
+#include "limer_censored_model.h"
+
+namespace limer {
+struct CapacityPoint { uint64_t ns; double bps; };
+using CapacityKey = std::tuple<unsigned, unsigned, unsigned>;
+class SplitPolicy {
+ public:
+  explicit SplitPolicy(std::string name) : name(name) {
+    if (name != "B0" && name != "B1" && name != "B2" && name != "B3" &&
+        name != "B4" && name != "B6" && name != "B7" && name != "B8" && name != "B9" &&
+        name != "B10" && name != "B11" && name != "B12" && name != "B13" && name != "B14")
+      throw std::invalid_argument("runtime policy must be B0/B1/B2/B3/B4/B6/B7/B8/B9/B10/B11/B12/B13/B14; B5 is an offline bound");
+  }
+  std::string name;
+  double alpha = .2, initial_bps = 100e9;
+  uint64_t probe_ns = 5000000;
+  unsigned single_rail = 1;
+  bool Adaptive() const { return name=="B10" || name=="B11" || name=="B12"; }
+  bool Censored() const { return name=="B13" || name=="B14"; }
+  bool ChunkFeedback() const { return name=="B7" || name=="B8" || name=="B9" || Adaptive() || Censored(); }
+  CensoredModel censored_model;
+  bool censored_include_pending=true,censored_actuate=true;
+  std::map<std::pair<unsigned,unsigned>,CensoredModel::Evidence> censored_evidence;
+  std::map<std::pair<unsigned,unsigned>,uint64_t> censored_last_ack;
+  struct Exploration {
+    uint64_t total_bytes=0,probe_bytes=0,last_probe_ns=0;
+    unsigned inflight=0;
+  };
+  struct CensoredChoice { bool probe=false; int base=-1; uint64_t queued=0; };
+  std::map<unsigned,Exploration> exploration;
+  std::map<unsigned,CensoredChoice> censored_choice;
+  uint64_t censored_probe_period_ns=50000,censored_probe_divisor=16,censored_tail_chunks=8;
+  void RefreshCensored(unsigned src,uint64_t now) {
+    for(unsigned r=0;r<2;++r)
+      censored_evidence[{src,r}]=censored_model.Evaluate(src,r,now,censored_include_pending);
+  }
+  double CensoredFactor(unsigned src,unsigned rail) const {
+    auto a=censored_evidence.find({src,rail}),b=censored_evidence.find({src,1-rail});
+    if(!censored_actuate || a==censored_evidence.end() || b==censored_evidence.end() ||
+        !a->second.ready || !b->second.ready || a->second.upper>=b->second.lower) return 1;
+    return std::max(.1,a->second.upper/b->second.lower);
+  }
+  void CensoredAssigned(unsigned src,uint64_t bytes,uint64_t now) {
+    auto& e=exploration[src]; e.total_bytes+=bytes;
+    if(censored_choice[src].probe) {e.probe_bytes+=bytes;e.last_probe_ns=now;++e.inflight;}
+  }
+  void CensoredProbeComplete(unsigned src) {
+    auto& e=exploration[src];
+    if(!e.inflight) throw std::runtime_error("probe completion underflow");
+    --e.inflight;
+  }
+  WaitModel wait_model;
+  std::map<std::pair<unsigned,unsigned>,double> wait_factor;
+  struct Signal { uint64_t sampled=0,arrived=0; double factor=1; };
+  // Each observer has a separate causally delivered view. A destination ACCESS
+  // egress observation says nothing directly about the source uplink direction.
+  std::map<CapacityKey,Signal> signals;
+  uint64_t signal_ttl_ns=50000;
+  void DeliverSignal(unsigned observer,unsigned dst,unsigned rail,uint64_t sampled,
+                     uint64_t arrived,double factor) {
+    if(sampled>arrived || !std::isfinite(factor) || factor<0 || factor>1)
+      throw std::invalid_argument("invalid switch signal");
+    auto key=std::make_tuple(observer,dst,rail);
+    auto it=signals.find(key);
+    if(it==signals.end() || sampled>it->second.sampled) signals[key]={sampled,arrived,factor};
+  }
+  double SignalFactor(unsigned src,unsigned dst,unsigned rail,uint64_t now) const {
+    auto it=signals.find({src,dst,rail});
+    if(name!="B12" || it==signals.end() || now<it->second.arrived ||
+        now<it->second.sampled || now-it->second.sampled>signal_ttl_ns) return 1;
+    return it->second.factor;
+  }
+  double WaitFactor(unsigned src,unsigned rail) const {
+    auto it=wait_factor.find({src,rail});
+    return it==wait_factor.end()?1:it->second;
+  }
+  // B9 snapshots bounds ONLY at completion ACKs. Idle/unstarted chunks provide
+  // no bound. This is a censored chunk-duration heuristic, not link capacity.
+  std::map<std::pair<unsigned,unsigned>,double> age_cap;
+  void ResetAgeCaps(unsigned src) {
+    if(name!="B9") return;
+    for(unsigned r=0;r<2;++r) age_cap[{src,r}]=std::numeric_limits<double>::infinity();
+  }
+  void AgeSample(unsigned src,unsigned rail,uint64_t bytes,uint64_t age_ns) {
+    if(name!="B9" || !age_ns) return;
+    if(!bytes || rail>1) throw std::invalid_argument("invalid age sample");
+    auto key=std::make_pair(src,rail);
+    double bound=bytes*8e9/age_ns;
+    auto it=age_cap.find(key);
+    if(it==age_cap.end()) age_cap[key]=bound;
+    else it->second=std::min(it->second,bound);
+  }
+  struct ChunkEstimate { double bps=0; uint64_t samples=0, launched=0; };
+  std::map<std::pair<unsigned,unsigned>,ChunkEstimate> chunk_estimate;
+  std::map<std::pair<unsigned,unsigned>,std::array<double,2>> chunk_credit;
+  bool HasChunkFeedback(unsigned src) {
+    return chunk_estimate[{src,0}].samples || chunk_estimate[{src,1}].samples;
+  }
+  void ChunkComplete(unsigned src,unsigned rail,uint64_t bytes,uint64_t elapsed_ns) {
+    if(!ChunkFeedback()) return;
+    if(!elapsed_ns || !bytes) throw std::invalid_argument("invalid chunk timing");
+    auto& e=chunk_estimate[{src,rail}];
+    if(name!="B7" || !e.samples) e.bps=bytes*8e9/elapsed_ns;
+    ++e.samples;
+  }
+  std::map<CapacityKey, std::vector<CapacityPoint>> capacity;
+  struct State {
+    double ewma = 0;
+    uint64_t reserved = 0, assigned = 0, queue = 0, last_sample = 0;
+    uint64_t last_probe = 0;
+    bool up = true;
+    bool estimate_valid = false;
+  };
+  std::map<std::pair<unsigned, unsigned>, State> state;
+  std::map<CapacityKey, uint64_t> assigned;
+  std::map<std::pair<unsigned,unsigned>,uint64_t> destination_queue;
+  std::map<std::pair<unsigned,unsigned>,uint64_t> destination_reserved;
+  std::map<std::pair<unsigned,unsigned>, std::array<double,2>> last_rates;
+
+  void ValidateCapacity() const {
+    for (const auto& item : capacity) {
+      const auto& points = item.second;
+      if (std::get<2>(item.first) > 1 || points.empty() || points.front().ns != 0)
+        throw std::invalid_argument("capacity requires rail 0/1 and a t=0 initial value");
+      for (size_t i = 0; i < points.size(); ++i)
+        if (!std::isfinite(points[i].bps) || points[i].bps < 0 ||
+            (i && points[i].ns <= points[i-1].ns))
+          throw std::invalid_argument("capacity must be finite, nonnegative and strictly time-ordered");
+    }
+  }
+  double Rate(unsigned src, unsigned dst, unsigned rail, uint64_t now) {
+    auto& s = state[{src, rail}];
+    if(ChunkFeedback()) {
+      double rate=chunk_estimate[{src,rail}].bps;
+      if(Censored()) return rate*CensoredFactor(src,rail);
+      auto it=age_cap.find({src,rail});
+      if(Adaptive()) return rate*std::min(WaitFactor(src,rail),SignalFactor(src,dst,rail,now));
+      return name=="B9" && it!=age_cap.end() ? std::min(rate,it->second):rate;
+    }
+    if (name == "B6") return s.estimate_valid ? s.ewma : initial_bps;
+    if (name == "B0" || name == "B1") return initial_bps;
+    const auto it = capacity.find({src, dst, rail});
+    if (it == capacity.end()) throw std::runtime_error("missing directed pair/rail capacity calibration");
+    const auto& p = it->second;
+    if (name == "B2") return p.front().bps;
+    auto upper = std::upper_bound(p.begin(), p.end(), now,
+        [](uint64_t t, const CapacityPoint& v) { return t < v.ns; });
+    return (upper - 1)->bps;
+  }
+  void Observe(unsigned src, unsigned rail, uint64_t now, double rate,
+               uint64_t queue, bool informative, bool up) {
+    auto& s = state[{src, rail}];
+    if (now < s.last_sample || !std::isfinite(rate) || rate < 0)
+      throw std::runtime_error("invalid/noncausal telemetry");
+    s.queue = queue; s.up = up; s.last_sample = now;
+    if (informative) {
+      s.ewma = !s.estimate_valid ? rate : alpha*rate+(1-alpha)*s.ewma;
+      s.estimate_valid=true;
+    }
+  }
+  int Select(unsigned src, unsigned dst, uint64_t bytes, uint64_t now,uint64_t local_queued=0) {
+    if (!bytes) throw std::invalid_argument("zero-sized chunk");
+    if(Censored()) censored_choice[src]={false,-1,local_queued};
+    if(ChunkFeedback()) {
+      for(unsigned r=0;r<2;++r)
+        if(!chunk_estimate[{src,r}].launched) return r;
+      std::array<double,2> rates{{Rate(src,dst,0,now),Rate(src,dst,1,now)}};
+      for(unsigned r=0;r<2;++r) if(!state[{src,r}].up) rates[r]=0;
+      double sum=rates[0]+rates[1];
+      if(sum<=0) return -1;
+      if(name=="B11" || name=="B12") {
+        // Endpoint-local unfinished payload only: no instantaneous switch
+        // queue, global receiver reservation or Oracle capacity is consulted.
+        // A completion-cost proxy, not an exact parallel-QP service model.
+        std::array<double,2> cost;
+        for(unsigned r=0;r<2;++r)
+          cost[r]=rates[r]>0 ? (double(state[{src,r}].reserved)+bytes)*8/rates[r]
+              :std::numeric_limits<double>::infinity();
+        return cost[0]<=cost[1]?0:1;
+      }
+      auto& credit=chunk_credit[{src,dst}];
+      for(unsigned r=0;r<2;++r) credit[r]+=bytes*rates[r]/sum;
+      unsigned r=rates[0]<=0 ? 1 : rates[1]<=0 ? 0 : credit[0]>=credit[1] ? 0:1;
+      if(Censored()) {
+        auto& choice=censored_choice[src];choice.base=r;
+        auto& e=exploration[src];
+        unsigned other=1-r;
+        const auto& optimistic=censored_evidence[{src,other}];
+        const auto& incumbent=censored_evidence[{src,r}];
+        // UCB is used only for a bounded, useful-data probe, never for all
+        // traffic. No extra bytes, remote switch state or fault truth are used.
+        // Idle-target + source-wide outstanding guard prevents probe buildup.
+        if(name=="B14" && censored_actuate && !e.inflight &&
+            local_queued>=censored_tail_chunks && state[{src,other}].up &&
+            !state[{src,other}].reserved && now>=e.last_probe_ns+censored_probe_period_ns &&
+            now>=censored_last_ack[{src,other}]+censored_probe_period_ns &&
+            (e.probe_bytes+bytes)*censored_probe_divisor<=e.total_bytes+bytes &&
+            optimistic.upper>=incumbent.lower) {
+          r=other;choice.probe=true;
+        }
+      }
+      credit[r]-=bytes;
+      return r;
+    }
+    // B0/B1/B2 intentionally retain their fixed policy even on a dead rail.
+    if (name == "B0") return single_rail;
+    if (name == "B1") return assigned[{src,dst,0}] <= assigned[{src,dst,1}] ? 0 : 1;
+    if (name == "B3") {
+      std::array<double,2> rates{{Rate(src,dst,0,now),Rate(src,dst,1,now)}};
+      if (rates != last_rates[{src,dst}]) {
+        assigned[{src,dst,0}]=assigned[{src,dst,1}]=0;
+        last_rates[{src,dst}]=rates;
+      }
+    }
+    std::array<double,2> score;
+    for (unsigned r=0; r<2; ++r) {
+      auto& s = state[{src,r}];
+      double c = Rate(src,dst,r,now);
+      if ((name == "B3" || name == "B4" || name == "B6" || ChunkFeedback()) && !s.up) c=0;
+      uint64_t backlog = assigned[{src,dst,r}];
+      if (name == "B4" || name == "B6")
+        backlog = std::max(std::max(s.reserved,s.queue),
+            std::max(destination_queue[{dst,r}],destination_reserved[{dst,r}]));
+      score[r] = c > 0 ? 8.0*(double(backlog)+bytes)/c : std::numeric_limits<double>::infinity();
+    }
+    if (name == "B6") {
+      // One bounded exploration chunk when a usable rail has gone idle.
+      for (unsigned r=0; r<2; ++r) {
+        auto& s=state[{src,r}];
+        if (s.up && !s.reserved && now-s.last_probe >= probe_ns) {
+          s.last_probe=now; return r;
+        }
+      }
+    }
+    if (!std::isfinite(score[0]) && !std::isfinite(score[1])) return -1;
+    return score[0] <= score[1] ? 0 : 1;
+  }
+  void Reserve(unsigned src,unsigned dst,unsigned rail,uint64_t bytes) {
+    if(ChunkFeedback()) ++chunk_estimate[{src,rail}].launched;
+    auto& s=state[{src,rail}]; s.reserved+=bytes; s.assigned+=bytes;
+    assigned[{src,dst,rail}]+=bytes;
+    destination_reserved[{dst,rail}]+=bytes;
+  }
+  void Complete(unsigned src,unsigned dst,unsigned rail,uint64_t bytes) {
+    auto& s=state[{src,rail}];
+    if (bytes>s.reserved || bytes>destination_reserved[{dst,rail}])
+      throw std::runtime_error("duplicate completion/reservation underflow");
+    s.reserved-=bytes;
+    destination_reserved[{dst,rail}]-=bytes;
+  }
+};
+} // namespace limer
