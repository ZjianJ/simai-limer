+      << (snapshot.has_allocated_port ? snapshot.max_allocated_port : 0) << ','
+      << (pass ? "PASS" : "FAIL") << '\n';
+  output.flush();
+  NS_ABORT_MSG_IF(!output.good(),
+                  "failed writing training source-port evidence: " +
+                      output_path);
