+/*
+ * LIMER Phase M1 telemetry collector.
+ *
+ * Bystander instrumentation: reads counters already incremented in
+ * ns-3-alibabacloud's SwitchNode/RdmaHw (see limer/docs/code_map.md), never
+ * participates in packet forwarding, admission control, congestion control,
+ * or collective scheduling decisions. Included from entry.h, after
+ * common.h, so it can see common.h's globals directly (n, nbr2if, node_num,
+ * switch_num, nvswitch_num, gpus_per_server) rather than re-deriving them.
+ *
+ * Env config: LIMER_TELEMETRY_ENABLE (default 1), LIMER_TELEMETRY_INTERVAL_US
+ * (default 1000), LIMER_TELEMETRY_DIR (required if enabled), LIMER_RUN_ID
+ * (default: generated).
+ */
+#ifndef LIMER_TELEMETRY_H
+#define LIMER_TELEMETRY_H
+
+#include "ns3/switch-node.h"
+#include "ns3/nvswitch-node.h"
+#include "ns3/rdma-hw.h"
+#include "ns3/rdma-driver.h"
+#include "ns3/simulator.h"
+#include "ns3/qbb-net-device.h"
+#include "ns3/error-model.h"
+#include "ns3/data-rate.h"
+#include "ns3/double.h"
+#include "ns3/string.h"
+#include "astra-sim/system/DataSet.hh"
+#include "collective_causal_time.h"
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <fstream>
+#include <map>
+#include <sstream>
+#include <set>
+#include <string>
+#include <vector>
+#ifdef NS3_MTP
+#include "ns3/mtp-interface.h"
+#endif
+
+extern "C" void limer_split_observe_nic(uint32_t node, uint32_t port,
+    uint64_t now, double rate, uint64_t queue, uint64_t outstanding,
+    bool up) __attribute__((weak));
+extern "C" void limer_split_observe_switch(uint32_t node,uint32_t port,
+    uint64_t queue) __attribute__((weak));
+
+namespace limer {
+
+struct PendingFlow {
+  int sender_node;
+  uint64_t msg_size;
+  uint64_t start_ns;
+};
+
+class TelemetryCollector {
+ public:
+  static TelemetryCollector& Get() {
+    static TelemetryCollector inst;
+    return inst;
+  }
+
+  // Call once, after SetupNetwork() has populated n / nbr2if / node_num /
+  // switch_num / nvswitch_num, and before Simulator::Run().
+  void Init(ns3::NodeContainer* nodes) {
+    nodes_ = nodes;
+    const char* enableEnv = std::getenv("LIMER_TELEMETRY_ENABLE");
+    enabled_ = !(enableEnv && std::string(enableEnv) == "0");
+    // Detection and actuation are separate experiment controls.  Detection
+    // stays enabled for the established P1 alarm baseline.  Recovery is
+    // deliberately opt-in: P2 corpus runs must observe the unimproved data
+    // path, and an injected fault must not silently migrate QPs or redo a
+    // collective before the recovery stages explicitly request it.
+    hard_event_detector_enabled_ = EnvEnabled(
+        "LIMER_HARD_EVENT_DETECTOR_ENABLE", true);
+    recovery_action_enabled_ = EnvEnabled(
+        "LIMER_RECOVERY_ACTION_ENABLE", false);
+    const char* intervalEnv = std::getenv("LIMER_TELEMETRY_INTERVAL_US");
+    requested_interval_us_ = intervalEnv ? std::strtoul(intervalEnv, nullptr, 10) : 1000;
+    // Every no-context event placed on MTP's public logical process becomes
+    // a global synchronization boundary. The 16-GPU parity test showed that
+    // boundaries below 1ms alter packet-event ordering (100us shifted the
+    // completion tick by 2517ns). Keep the proven non-perturbing cadence and
+    // use event-updated queue high-water marks for sub-ms transients.
+    interval_us_ = requested_interval_us_ < 1000 ? 1000 : requested_interval_us_;
+    if (requested_interval_us_ < 1000) {
+      std::fprintf(stderr,
+          "LIMER: requested interval %u us raised to safe MTP minimum 1000 us; "
+          "sub-ms queue peaks remain event-accurate via high-water marks\n",
+          requested_interval_us_);
+    }
+    const char* dirEnv = std::getenv("LIMER_TELEMETRY_DIR");
+    dir_ = dirEnv ? std::string(dirEnv) : std::string(".");
+    const char* runIdEnv = std::getenv("LIMER_RUN_ID");
+    if (runIdEnv) {
+      run_id_ = runIdEnv;
+    } else {
+      char buf[64];
+      std::snprintf(buf, sizeof(buf), "run-%ld", (long)std::time(nullptr));
+      run_id_ = buf;
+    }
+
+    BuildLinkMap();
+    true_gpu_count_ = node_num - switch_num - nvswitch_num;
+
+    if (!enabled_) return;
+
+    switch_path_ = dir_ + "/switch_telemetry.csv";
+    nic_path_ = dir_ + "/nic_telemetry.csv";
+    coll_path_ = dir_ + "/collective_telemetry.csv";
+    alarm_path_ = dir_ + "/alarm_telemetry.csv";
+    recovery_path_ = dir_ + "/recovery_telemetry.csv";
+    rdma_path_ = dir_ + "/rdma_wc_telemetry.csv";
+    collective_tx_path_ = dir_ + "/collective_transaction.csv";
+    fault_application_path_ = dir_ + "/fault_application_telemetry.csv";
+    lifecycle_path_ = dir_ + "/run_lifecycle.csv";
+    // Keep only a bounded libc buffer per CSV.  The former process-wide
+    // strings retained every row until Close(), consuming memory linearly
+    // with the observation horizon and losing all evidence on SIGKILL.
+    // AppendRow is called under the collector's existing MTP serialization,
+    // so streaming preserves the exact callback/CSV order.
+    switch_stream_ = OpenCsv(switch_path_,
+        "run_id,timestamp_ns,switch_id,port_id,link_id,peer_node_id,direction,"
+        "tx_packets,tx_bytes,rx_packets,rx_bytes,dropped_packets,drop_bytes,"
+        "queue_packets,queue_bytes,max_queue_packets,max_queue_bytes,"
+        "ecn_marks,pfc_events,link_errors,recovered_packets,recovered_bytes,"
+        "configured_bandwidth_bps,"
+        "observed_throughput_bps,utilization,node_type,link_state,"
+        "max_queue_timestamp_ns,flap_count,last_link_down_ns,"
+        "last_link_up_ns,cumulative_link_down_ns\n");
+    nic_stream_ = OpenCsv(nic_path_,
+        "run_id,timestamp_ns,node_id,rank_id,nic_id,link_id,tx_packets,"
+        "tx_bytes,rx_packets,rx_bytes,tx_dropped_packets,tx_drop_bytes,"
+        "rx_dropped_packets,rx_drop_bytes,link_errors,recovered_packets,"
+        "recovered_bytes,retransmissions,nacks,"
+        "outstanding_packets,outstanding_bytes,effective_throughput_bps,"
+        "completion_delay_ns,rtt_proxy_ns,queue_packets,queue_bytes,"
+        "max_queue_packets,max_queue_bytes,max_queue_timestamp_ns,"
+        "configured_bandwidth_bps,link_state,utilization,flap_count,"
+        "last_link_down_ns,last_link_up_ns,cumulative_link_down_ns\n");
+    coll_stream_ = OpenCsv(coll_path_,
+        "run_id,collective_id,iteration_id,layer_id,collective_type,"
+        "algorithm,rank_id,world_size,message_size_bytes,start_time_ns,"
+        "finish_time_ns,duration_ns,status\n");
+    alarm_stream_ = OpenCsv(alarm_path_,
+        "run_id,alarm_id,fault_id,link_id,fault_type,detector,physical_fault_ns,"
+        "observe_ns,emit_ns,deliver_ns,consume_ns,detection_latency_ns,"
+        "delivery_latency_ns,end_to_end_alarm_ns,status\n");
+    recovery_stream_ = OpenCsv(recovery_path_,
+        "run_id,fault_id,link_id,alarm_consume_ns,route_rebuild_ns,"
+        "primary_quiesce_ns,backup_activate_ns,affected_qps,status\n");
+    rdma_stream_ = OpenCsv(rdma_path_,
+        "run_id,timestamp_ns,node_id,rank_id,logical_qp_id,transport_epoch,"
+        "traffic_class,event,event_detail,wc_status,src_rank,dst_rank,sport,primary_nic,"
+        "backup_nic,active_nic,backup_ready_ns,failover_ns,"
+        "backup_first_tx_ns,backup_first_ack_ns,standby_tx_bytes,"
+        "snd_una,snd_nxt,retry_count,retry_limit,rto_us\n");
+    collective_tx_stream_ = OpenCsv(collective_tx_path_,
+        "run_id,timestamp_ns,collective_seq,attempt,layer_num,"
+        "message_size_bytes,event,rank_id,world_size,ready_ranks,"
+        "result_digest,status\n");
+    fault_application_stream_ = OpenCsv(fault_application_path_,
+        "run_id,fault_id,fault_type,target_link_id,transition,"
+        "scheduled_ns,actual_ns,parameter_before,parameter_after,"
+        "mechanism,rng_stream,status\n");
+    lifecycle_stream_ = OpenCsv(lifecycle_path_,
+        "run_id,event,scheduled_ns,actual_ns,finished_ranks,world_size,status\n");
+
+    alarm_processing_ns_ = EnvUs("LIMER_ALARM_PROCESSING_US", 5) * 1000;
+    alarm_transport_ns_ = EnvUs("LIMER_ALARM_TRANSPORT_US", 50) * 1000;
+    alarm_consume_ns_ = EnvUs("LIMER_ALARM_CONSUME_US", 5) * 1000;
+
+    for (uint32_t i = 0; i < nodes_->GetN(); ++i) {
+      ns3::Ptr<ns3::Node> node = nodes_->Get(i);
+      if (node->GetNodeType() != 0) continue;
+      ns3::Ptr<ns3::RdmaDriver> drv = node->GetObject<ns3::RdmaDriver>();
+      if (drv && drv->m_rdma) {
+        drv->m_rdma->SetLimerEventCallback(ns3::MakeCallback(
+            &TelemetryCollector::OnRdmaEvent, this));
+      }
+    }
+
+    WriteLinkMapCsv();
+  }
