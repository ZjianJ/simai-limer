+bool PhysicalLinkDown(Ptr<Node> a, Ptr<Node> b) {
+  auto a_entry = nbr2if.find(a);
+  auto b_entry = nbr2if.find(b);
+  NS_ABORT_MSG_IF(a_entry == nbr2if.end() || b_entry == nbr2if.end() ||
+                      a_entry->second.find(b) == a_entry->second.end() ||
+                      b_entry->second.find(a) == b_entry->second.end(),
+                  "PhysicalLinkDown requires an existing bidirectional link");
