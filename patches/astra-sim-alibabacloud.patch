+// SimAI historically exits as soon as the first rank calls sim_finish().
+// That truncates in-flight flows and makes a process exit look like a global
+// collective commit.  The true-16 harness stops ns-3 only after every GPU
+// rank (NVSwitch pseudo-ranks are intentionally excluded) has arrived.
+class FinishBarrier {
+ public:
+  static FinishBarrier& Get() {
+    static FinishBarrier barrier;
+    return barrier;
+  }
+  void Init(uint32_t world_size) {
+    world_size_ = world_size;
+    arrivals_.clear();
+  }
+  void Arrive(int rank) {
+    if (rank < 0 || static_cast<uint32_t>(rank) >= world_size_) return;
+#ifdef NS3_MTP
+    MtpInterface::explicitCriticalSection cs;
+#endif
+    arrivals_.insert(rank);
+    uint32_t arrived = arrivals_.size();
+    bool complete = world_size_ != 0 && arrived == world_size_;
+#ifdef NS3_MTP
+    cs.ExitSection();
+#endif
+    TelemetryCollector::Get().RecordFinishBarrierProgress(
+        arrived, world_size_, complete);
+    if (complete) {
+      std::fprintf(stderr,
+          "LIMER-COMMIT: all %u GPU ranks reached the finish barrier at t=%lu ns\n",
+          world_size_,
+          (unsigned long)ns3::Simulator::Now().GetNanoSeconds());
+      ns3::Simulator::Stop();
+    }
+  }
+  uint32_t Arrived() const { return arrivals_.size(); }
+  uint32_t WorldSize() const { return world_size_; }
+
+ private:
+  uint32_t world_size_ = 0;
+  std::set<int> arrivals_;
+};
+
+// LIMER dynamic fault injector: reads a fault schedule (CSV, same schema
+// as fault_events.csv - fault_id,fault_type,target_link_id,start_time_ns,
+// end_time_ns,severity,parameter_before,parameter_after) generated ahead
+// of time by limer/tools/generate_fault_schedule.py, and schedules an apply
+// callback at start_time_ns plus a reversible callback at end_time_ns. MTP
+// uses its fault-only pre-private barrier; other builds use Simulator::Schedule.
+// All randomness lives in the Python generator -
+// this class just plays back a fixed, already-decided schedule, so a
+// given schedule file always produces the same fault timeline regardless
+// of anything about the C++/ns-3 side (this build has no exposed RNG
+// anyway, see docs/monitoring_design.md).
+//
+// Fault effects use QbbNetDevice's existing data-rate/error-model controls.
+// New P2 fault names have strict semantics: random_loss/burst_loss really
+// discard corrupt packets, while the legacy packet_loss name retains its
+// historical delayed-delivery proxy behavior. service_degradation slows the
+// egress service process without changing carrier or configured DataRate.
+// Unknown non-BLOCKED fault names are rejected before Simulator::Run().
+struct FaultScheduleEntry {
+  std::string fault_id;
+  std::string fault_type;
+  std::string target_link_id;
+  uint64_t start_ns;
+  uint64_t end_ns;
+  std::string parameter_before;
+  std::string parameter_after;
+  uint64_t recovery_delay_ns = 50000;
+};
+
+class FaultInjector {
+ public:
+  static FaultInjector& Get() {
+    static FaultInjector inst;
+    return inst;
+  }
+
+  void Init() {
+    const char* path = std::getenv("LIMER_FAULT_SCHEDULE");
+    if (!path) return;
+    std::ifstream f(path);
+    if (!f.is_open()) {
+      std::fprintf(stderr, "LIMER: could not open LIMER_FAULT_SCHEDULE=%s\n", path);
+      return;
+    }
+    std::string line;
+    std::getline(f, line); // header
+    while (std::getline(f, line)) {
+      if (line.empty()) continue;
+      std::vector<std::string> cols = SplitCsv(line);
+      if (cols.size() < 8) continue;
+      if (cols[1].rfind("BLOCKED", 0) == 0) continue; // skip pre-marked-blocked rows
+      FaultScheduleEntry e;
+      e.fault_id = cols[0];
+      e.fault_type = cols[1];
+      e.target_link_id = cols[2];
+      e.start_ns = std::strtoull(cols[3].c_str(), nullptr, 10);
+      e.end_ns = std::strtoull(cols[4].c_str(), nullptr, 10);
+      e.parameter_before = cols[6];
+      e.parameter_after = cols[7];
+      if (cols.size() >= 9 && !cols[8].empty()) {
+        e.recovery_delay_ns = std::strtoull(cols[8].c_str(), nullptr, 10);
+      }
+      if (!IsSupportedFaultType(e.fault_type)) {
+        std::fprintf(stderr,
+            "LIMER: unsupported fault_type=%s in %s (fault_id=%s)\n",
+            e.fault_type.c_str(), path, e.fault_id.c_str());
+        std::exit(2);
+      }
+      if (e.fault_id.empty() || !loaded_fault_ids_.insert(e.fault_id).second) {
+        std::fprintf(stderr,
+            "LIMER: empty or duplicate fault_id=%s in %s\n",
+            e.fault_id.c_str(), path);
+        std::exit(2);
+      }
+      if (e.fault_type == "carrier_flap" && e.end_ns <= e.start_ns) {
+        std::fprintf(stderr,
+            "LIMER: carrier_flap %s must have end_ns > start_ns in %s\n",
+            e.fault_id.c_str(), path);
+        std::exit(2);
+      }
+      entries_.push_back(e);
+    }
+    for (auto& e : entries_) {
+#ifdef NS3_MTP
+      // Fault transitions are the only public events allowed to use MTP's
+      // pre-private barrier.  At a shared timestamp T the physical/model
+      // mutation must be visible before any node LP consumes its T events.
+      ns3::MtpInterface::ScheduleFaultBarrier(
+          ns3::NanoSeconds(e.start_ns), &FaultInjector::Apply, this, e);
+#else
+      ns3::Simulator::Schedule(ns3::NanoSeconds(e.start_ns), &FaultInjector::Apply, this, e);
+#endif
+      if (e.end_ns > e.start_ns && e.fault_type != "hard_disconnect" &&
+          e.fault_type != "hard_link_failure") {
+#ifdef NS3_MTP
+        ns3::MtpInterface::ScheduleFaultBarrier(
+            ns3::NanoSeconds(e.end_ns), &FaultInjector::Revert, this, e);
+#else
+        ns3::Simulator::Schedule(ns3::NanoSeconds(e.end_ns), &FaultInjector::Revert, this, e);
+#endif
+      }
+    }
+    std::fprintf(stderr, "LIMER: loaded %zu fault schedule entries from %s\n", entries_.size(), path);
+  }
+
+ private:
+  static bool IsSupportedFaultType(const std::string& fault_type) {
+    return fault_type == "hard_disconnect" ||
+           fault_type == "hard_link_failure" ||
+           fault_type == "carrier_flap" ||
+           fault_type == "bandwidth_degradation" ||
+           fault_type == "packet_loss" ||
+           fault_type == "random_loss" ||
+           fault_type == "burst_loss" ||
+           fault_type == "service_degradation" ||
+           fault_type == "link_flap";
+  }
+
+  static std::vector<std::string> SplitCsv(const std::string& line) {
+    std::vector<std::string> out;
+    std::string cur;
+    for (char c : line) {
+      if (c == ',') { out.push_back(cur); cur.clear(); }
+      else cur += c;
+    }
+    out.push_back(cur);
+    // Defensive trim: strips a trailing '\r' (CRLF-written CSVs - the
+    // generator now writes LF-only, but a hand-edited or foreign CSV could
+    // still have it) so e.g. ns3::DataRate("40Gbps\r") never silently
+    // fails to parse.
+    for (auto& s : out) {
+      while (!s.empty() && (s.back() == '\r' || s.back() == '\n' || s.back() == ' ')) {
+        s.pop_back();
+      }
+    }
+    return out;
+  }
+
+  void Apply(FaultScheduleEntry e) {
+    auto devs = TelemetryCollector::Get().GetBothDevicesForLink(e.target_link_id);
+    if (!devs.first || !devs.second) {
+      TelemetryCollector::Get().RecordFaultTransition(
+          e.fault_id, e.fault_type, e.target_link_id, "apply", e.start_ns,
+          e.parameter_before, e.parameter_after, "unresolved", "",
+          "FAILED_UNRESOLVED_LINK");
+      std::fprintf(stderr, "LIMER: fault %s could not resolve both ends of link %s\n", e.fault_id.c_str(), e.target_link_id.c_str());
+      return;
+    }
+    if (e.fault_type == "hard_disconnect" ||
+        e.fault_type == "hard_link_failure" ||
+        e.fault_type == "carrier_flap") {
+      uint32_t src = 0, src_port = 0, dst = 0, dst_port = 0;
+      if (!TelemetryCollector::Get().GetLinkEndpoints(
+              e.target_link_id, &src, &src_port, &dst, &dst_port)) {
+        std::fprintf(stderr, "LIMER: hard fault %s cannot resolve %s\n",
+            e.fault_id.c_str(), e.target_link_id.c_str());
+        return;
+      }
+      const std::string mechanism = e.fault_type == "carrier_flap"
+          ? "physical_carrier_down_channel_epoch" : "physical_link_down";
+      std::set<std::string>& owners = active_carrier_owners_[e.target_link_id];
+      if (owners.count(e.fault_id)) {
+        TelemetryCollector::Get().RecordFaultTransition(
+            e.fault_id, e.fault_type, e.target_link_id, "apply", e.start_ns,
+            e.parameter_before, e.parameter_after, mechanism, "",
+            "FAILED_DUPLICATE_ACTIVE_FAULT_ID");
+        return;
+      }
+      const bool first_owner = owners.empty();
+      if (first_owner && !PhysicalLinkDown(n.Get(src), n.Get(dst))) {
+        active_carrier_owners_.erase(e.target_link_id);
+        TelemetryCollector::Get().RecordFaultTransition(
+            e.fault_id, e.fault_type, e.target_link_id, "apply", e.start_ns,
+            e.parameter_before, e.parameter_after, mechanism, "",
+            "FAILED_INCONSISTENT_ALREADY_DOWN");
+        return;
+      }
+      owners.insert(e.fault_id);
+      uint64_t now = ns3::Simulator::Now().GetNanoSeconds();
+      if (first_owner) {
+        TelemetryCollector::Get().ObserveHardDisconnect(
+            e.fault_id, e.target_link_id, now, e.fault_type);
+      }
+      TelemetryCollector::Get().RecordFaultTransition(
+          e.fault_id, e.fault_type, e.target_link_id, "apply", e.start_ns,
+          e.parameter_before, e.parameter_after, mechanism, "",
+          first_owner ? "APPLIED" : "APPLIED_OVERLAP_CARRIER_REMAINS_DOWN");
+      std::fprintf(stderr,
+          "LIMER-FAULT: physical carrier %s %s (%s) on %s at t=%lu ns\n",
+          first_owner ? "down for" : "remains down for overlapping",
+          e.fault_id.c_str(), e.fault_type.c_str(), e.target_link_id.c_str(),
+          (unsigned long)now);
+      return;
+    }
+
+    // Both ends of the physical link, not just one - see
+    // GetBothDevicesForLink()'s comment for why one-sided desyncs the
+    // two traffic directions.
+    uint32_t endpoint = 0;
+    int64_t base_stream = StableStream(e.fault_id + ":" + e.target_link_id);
+    std::string mechanism;
+    for (auto dev : {devs.first, devs.second}) {
+      if (e.fault_type == "bandwidth_degradation") {
+        dev->SetDataRate(ns3::DataRate(e.parameter_after));
+        mechanism = "dual_endpoint_data_rate";
+      } else if (e.fault_type == "packet_loss") {
+        dev->SetLimerRecoverRxErrors(true, e.recovery_delay_ns);
+        ApplyErrorRate(dev, ParseProbability(e.parameter_after),
+                       base_stream + endpoint);
+        mechanism = "legacy_recoverable_error_proxy";
+      } else if (e.fault_type == "random_loss" ||
+                 e.fault_type == "burst_loss") {
+        dev->SetLimerRecoverRxErrors(false, 0);
+        ApplyErrorRate(dev, ParseProbability(e.parameter_after),
+                       base_stream + endpoint);
+        mechanism = "rate_error_model_true_drop";
+      } else if (e.fault_type == "service_degradation") {
+        dev->SetLimerServiceFraction(ParseServiceFraction(e.parameter_after));
+        mechanism = "carrier_up_service_rate";
+      } else if (e.fault_type == "link_flap") {
+        dev->SetLimerForcedLinkDown(true);
+        dev->SetDataRate(ns3::DataRate("1Gbps"));
+        mechanism = "legacy_forced_state_rate_proxy";
+      }
+      ++endpoint;
+    }
+    std::string rng_stream =
+        (e.fault_type == "packet_loss" || e.fault_type == "random_loss" ||
+         e.fault_type == "burst_loss")
+        ? std::to_string(base_stream) + ":" + std::to_string(base_stream + 1)
+        : "";
+    TelemetryCollector::Get().RecordFaultTransition(
+        e.fault_id, e.fault_type, e.target_link_id, "apply", e.start_ns,
+        e.parameter_before, e.parameter_after, mechanism, rng_stream,
+        "APPLIED");
+    std::fprintf(stderr, "LIMER-FAULT: applied %s (%s) on %s at t=%lu ns\n",
+        e.fault_id.c_str(), e.fault_type.c_str(), e.target_link_id.c_str(), (unsigned long)ns3::Simulator::Now().GetNanoSeconds());
+  }
+
+  void Revert(FaultScheduleEntry e) {
+    auto devs = TelemetryCollector::Get().GetBothDevicesForLink(e.target_link_id);
+    if (!devs.first || !devs.second) {
+      TelemetryCollector::Get().RecordFaultTransition(
+          e.fault_id, e.fault_type, e.target_link_id, "revert", e.end_ns,
+          e.parameter_before, e.parameter_after, "unresolved", "",
+          "FAILED_UNRESOLVED_LINK");
+      return;
+    }
+    if (e.fault_type == "carrier_flap") {
+      uint32_t src = 0, src_port = 0, dst = 0, dst_port = 0;
+      if (!TelemetryCollector::Get().GetLinkEndpoints(
+              e.target_link_id, &src, &src_port, &dst, &dst_port)) {
+        TelemetryCollector::Get().RecordFaultTransition(
+            e.fault_id, e.fault_type, e.target_link_id, "revert", e.end_ns,
+            e.parameter_before, e.parameter_after, "unresolved", "",
+            "FAILED_UNRESOLVED_LINK");
+        return;
+      }
+      auto owners_it = active_carrier_owners_.find(e.target_link_id);
+      if (owners_it == active_carrier_owners_.end() ||
+          owners_it->second.erase(e.fault_id) == 0) {
+        TelemetryCollector::Get().RecordFaultTransition(
+            e.fault_id, e.fault_type, e.target_link_id, "revert", e.end_ns,
+            e.parameter_before, e.parameter_after,
+            "physical_carrier_up_no_fib_or_qp_change", "",
+            "FAILED_NO_ACTIVE_CARRIER_OWNER");
+        return;
+      }
+      if (!owners_it->second.empty()) {
+        TelemetryCollector::Get().RecordFaultTransition(
+            e.fault_id, e.fault_type, e.target_link_id, "revert", e.end_ns,
+            e.parameter_before, e.parameter_after,
+            "physical_carrier_up_deferred_active_fault", "",
+            "REVERTED_CARRIER_REMAINS_DOWN");
+        return;
+      }
+      active_carrier_owners_.erase(owners_it);
+      if (!PhysicalLinkUp(n.Get(src), n.Get(dst))) {
+        TelemetryCollector::Get().RecordFaultTransition(
+            e.fault_id, e.fault_type, e.target_link_id, "revert", e.end_ns,
+            e.parameter_before, e.parameter_after,
+            "physical_carrier_up_no_fib_or_qp_change", "",
+            "FAILED_INCONSISTENT_ALREADY_UP");
+        return;
+      }
+      TelemetryCollector::Get().RecordFaultTransition(
+          e.fault_id, e.fault_type, e.target_link_id, "revert", e.end_ns,
+          e.parameter_before, e.parameter_after,
+          "physical_carrier_up_no_fib_or_qp_change", "", "REVERTED");
+      std::fprintf(stderr,
+          "LIMER-FAULT: physical carrier up %s on %s at t=%lu ns "
+          "(no FIB repair or QP failback)\n",
+          e.fault_id.c_str(), e.target_link_id.c_str(),
+          (unsigned long)ns3::Simulator::Now().GetNanoSeconds());
+      return;
+    }
+    for (auto dev : {devs.first, devs.second}) {
+      if (e.fault_type == "bandwidth_degradation") {
+        dev->SetDataRate(ns3::DataRate(e.parameter_before));
+      } else if (e.fault_type == "packet_loss") {
+        ApplyErrorRate(dev, 0.0);
+        dev->SetLimerRecoverRxErrors(false, 0);
+      } else if (e.fault_type == "random_loss" ||
+                 e.fault_type == "burst_loss") {
+        ApplyErrorRate(dev, 0.0, 1);
+        dev->SetLimerRecoverRxErrors(false, 0);
+      } else if (e.fault_type == "service_degradation") {
+        dev->SetLimerServiceFraction(1.0);
+      } else if (e.fault_type == "link_flap") {
+        uint64_t original = TelemetryCollector::Get().GetConfiguredBandwidthBps(
+            e.target_link_id);
+        if (original) dev->SetDataRate(ns3::DataRate(original));
+        dev->SetLimerForcedLinkDown(false);
+      }
+    }
+    TelemetryCollector::Get().RecordFaultTransition(
+        e.fault_id, e.fault_type, e.target_link_id, "revert", e.end_ns,
+        e.parameter_before, e.parameter_after, "restore_baseline", "",
+        "REVERTED");
+    std::fprintf(stderr, "LIMER-FAULT: reverted %s (%s) on %s at t=%lu ns\n",
+        e.fault_id.c_str(), e.fault_type.c_str(), e.target_link_id.c_str(), (unsigned long)ns3::Simulator::Now().GetNanoSeconds());
+  }
+
+  static double ParseProbability(const std::string& value) {
+    char* end = nullptr;
+    double rate = std::strtod(value.c_str(), &end);
+    if (!end || end == value.c_str() || *end != '\0' ||
+        rate < 0.0 || rate > 1.0) {
+      std::fprintf(stderr, "LIMER: invalid packet-error probability %s\n",
+          value.c_str());
+      std::exit(2);
+    }
+    return rate;
+  }
+
+  static double ParseServiceFraction(const std::string& value) {
+    char* end = nullptr;
+    double fraction = std::strtod(value.c_str(), &end);
+    if (!end || end == value.c_str() || *end != '\0' ||
+        fraction <= 0.0 || fraction > 1.0) {
+      std::fprintf(stderr, "LIMER: invalid service fraction %s\n",
+          value.c_str());
+      std::exit(2);
+    }
+    return fraction;
+  }
+
+  static int64_t StableStream(const std::string& identity) {
+    uint64_t hash = 1469598103934665603ULL;
+    for (unsigned char value : identity) {
+      hash ^= value;
+      hash *= 1099511628211ULL;
+    }
+    return static_cast<int64_t>(1 + hash % 2147483000ULL);
+  }
+
+  static void ApplyErrorRate(ns3::Ptr<ns3::QbbNetDevice> dev, double rate,
+                             int64_t stream = 1) {
+    ns3::Ptr<ns3::RateErrorModel> rem = ns3::CreateObject<ns3::RateErrorModel>();
+    ns3::Ptr<ns3::UniformRandomVariable> uv = ns3::CreateObject<ns3::UniformRandomVariable>();
+    uv->SetStream(stream);
+    rem->SetRandomVariable(uv);
+    rem->SetAttribute("ErrorRate", ns3::DoubleValue(rate));
+    rem->SetAttribute("ErrorUnit", ns3::StringValue("ERROR_UNIT_PACKET"));
+    dev->SetReceiveErrorModel(rem);
+  }
+
+  std::vector<FaultScheduleEntry> entries_;
+  std::set<std::string> loaded_fault_ids_;
+  // A hard failure is a permanent owner; a transient carrier_flap removes
+  // only its own owner at end_ns.  The link comes up only on the 1 -> 0
+  // transition, so overlapping flaps cannot recover each other or revive a
+  // permanent hard-disconnect.
+  std::map<std::string, std::set<std::string> > active_carrier_owners_;
+};
+
+} // namespace limer
