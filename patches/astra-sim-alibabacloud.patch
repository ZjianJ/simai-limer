+  void StartPeriodicSampling() {
+    if (!enabled_) return;
+    ns3::Simulator::Schedule(ns3::MicroSeconds(interval_us_),
+                              &TelemetryCollector::Sample, this);
+    const char* stop_env = std::getenv("LIMER_OBSERVATION_STOP_NS");
+    if (stop_env && *stop_env) {
+      char* end = nullptr;
+      uint64_t stop_ns = std::strtoull(stop_env, &end, 10);
+      if (!end || end == stop_env || *end != '\0' || stop_ns == 0) {
+        std::fprintf(stderr,
+            "LIMER: invalid LIMER_OBSERVATION_STOP_NS=%s "
+            "(expected a positive integer)\n", stop_env);
+        std::exit(2);
+      }
+      observation_stop_ns_ = stop_ns;
+      ns3::Simulator::Schedule(ns3::NanoSeconds(stop_ns),
+          &TelemetryCollector::StopAtObservationHorizon, this);
+    }
+  }
