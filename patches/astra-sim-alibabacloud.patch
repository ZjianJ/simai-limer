+  void PrepareOutput() const {
+    std::ofstream output(output_path_.c_str(),
+                         std::ios::out | std::ios::trunc);
+    if (!output.is_open()) {
+      Fail("cannot create output: " + output_path_);
+    }
+    output << Header() << '\n';
+    output.flush();
+    if (!output.good()) {
+      Fail("cannot write output header: " + output_path_);
+    }
+    output.close();
+    if (output.fail()) {
+      Fail("cannot close output header: " + output_path_);
+    }
+
+    std::ofstream route_output(route_output_path_.c_str(),
+                               std::ios::out | std::ios::trunc);
+    if (!route_output.is_open()) {
+      Fail("cannot create output: " + route_output_path_);
+    }
+    route_output << RouteHeader() << '\n';
+    route_output.flush();
+    if (!route_output.good()) {
+      Fail("cannot write output header: " + route_output_path_);
+    }
+    route_output.close();
+    if (route_output.fail()) {
+      Fail("cannot close output header: " + route_output_path_);
+    }
+
+    std::ofstream route_summary(route_summary_path_.c_str(),
+                                std::ios::out | std::ios::trunc);
+    if (!route_summary.is_open()) {
+      Fail("cannot create output: " + route_summary_path_);
+    }
+    route_summary << RouteSummaryHeader() << '\n';
+    route_summary.close();
+    if (route_summary.fail()) {
+      Fail("cannot close output header: " + route_summary_path_);
+    }
+
+    std::ofstream congestion_output(congestion_output_path_.c_str(),
+                                    std::ios::out | std::ios::trunc);
+    if (!congestion_output.is_open()) {
+      Fail("cannot create output: " + congestion_output_path_);
+    }
+    congestion_output << CongestionHeader() << '\n';
+    congestion_output.flush();
+    if (!congestion_output.good()) {
+      Fail("cannot write output header: " + congestion_output_path_);
+    }
+    congestion_output.close();
+    if (congestion_output.fail()) {
+      Fail("cannot close output header: " + congestion_output_path_);
+    }
+
+    std::ofstream summary_output(congestion_summary_path_.c_str(),
+                                 std::ios::out | std::ios::trunc);
+    if (!summary_output.is_open()) {
+      Fail("cannot create output: " + congestion_summary_path_);
