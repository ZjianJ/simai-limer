+  static const char* CongestionEventName(uint8_t type) {
+    switch (type) {
+      case ns3::LIMER_SIGNAL_ECN_MARK: return "ECN_MARK";
+      case ns3::LIMER_SIGNAL_CNP_ACK_EMIT: return "CNP_ACK_EMIT";
+      case ns3::LIMER_SIGNAL_CNP_ACK_RX: return "CNP_ACK_RX";
+      case ns3::LIMER_SIGNAL_QP_RATE_DECREASE: return "QP_RATE_DECREASE";
+      case ns3::LIMER_SIGNAL_PFC_PAUSE_SEND: return "PFC_PAUSE_SEND";
+      case ns3::LIMER_SIGNAL_PFC_PAUSE_RECEIVE: return "PFC_PAUSE_RECEIVE";
+      case ns3::LIMER_SIGNAL_PFC_RESUME_SEND: return "PFC_RESUME_SEND";
+      case ns3::LIMER_SIGNAL_PFC_RESUME_RECEIVE: return "PFC_RESUME_RECEIVE";
+      default: Fail("unknown live congestion-signal event type");
+    }
+  }
+
+  std::string ResolveSignalLink(uint32_t node_id, uint32_t port_id) const {
+    if (node_id >= n.GetN() || n.Get(node_id)->GetId() != node_id) {
+      Fail("congestion signal references an unknown node");
+    }
+    ns3::Ptr<ns3::Node> node = n.Get(node_id);
+    auto found = nbr2if.find(node);
+    if (found == nbr2if.end()) {
+      Fail("congestion signal node is absent from nbr2if");
+    }
+    ns3::Ptr<ns3::Node> peer;
+    for (const auto& neighbor : found->second) {
+      if (neighbor.second.idx != port_id) continue;
+      if (peer != nullptr) {
+        Fail("congestion signal port maps to multiple physical links");
+      }
+      peer = neighbor.first;
+    }
+    if (peer == nullptr) {
+      Fail("congestion signal port has no physical-link identity");
+    }
+    std::ostringstream link;
+    link << 'L' << std::min(node_id, peer->GetId()) << '-'
+         << std::max(node_id, peer->GetId());
+    return link.str();
+  }
+
+  void RecordCongestionSignal(const ns3::LimerCongestionSignalEvent& event) {
+    std::lock_guard<std::mutex> guard(mu_);
+    RequireEnabled("CONGESTION_SIGNAL");
+    ++congestion_seen_;
+    if (event.pg > 7 || event.node_id >= n.GetN() ||
+        n.Get(event.node_id)->GetNodeType() != event.node_type) {
+      Fail("live congestion signal has invalid node/PG identity");
+    }
+    const std::string link_id = ResolveSignalLink(event.node_id, event.port_id);
+    const std::string trigger_link = event.has_trigger_out_port
+        ? ResolveSignalLink(event.node_id, event.trigger_out_port) : "";
+    std::string event_id;
+    std::string flow_id;
+    std::string scenario;
+    std::string status = "OBSERVED_REAL_MECHANISM_UNBOUND";
+    bool bound = false;
+    if (event.has_flow &&
+        event.flow_sport >= ns3::LIMER_BACKGROUND_SPORT_MIN) {
+      QpKey key{event.flow_src, event.flow_dst, event.flow_sport, event.pg};
+      auto found = states_.find(key);
+      if (found == states_.end() ||
+          flows_[found->second].dport != event.flow_dport) {
+        Fail("background congestion signal does not match the schedule");
+      }
+      const FlowSpec& flow = flows_[found->second];
+      event_id = flow.event_id;
+      flow_id = flow.flow_id;
+      scenario = flow.scenario;
+      status = "OBSERVED_REAL_MECHANISM_BACKGROUND_BOUND";
+      bound = true;
+    }
+    const bool receive_candidate =
+        event.event_type == ns3::LIMER_SIGNAL_PFC_PAUSE_RECEIVE ||
+        event.event_type == ns3::LIMER_SIGNAL_PFC_RESUME_RECEIVE;
+    if (event.timestamp_ns < congestion_window_start_ns_ ||
+        event.timestamp_ns > congestion_window_end_ns_ ||
+        (!bound && !receive_candidate)) {
+      ++congestion_filtered_;
+      return;
+    }
+    if (congestion_events_.size() >= congestion_max_events_) {
+      ++congestion_overflow_;
+      WriteCongestionSummary("FATAL_OVERFLOW");
+      Fail("congestion evidence exceeded LIMER_CONGESTION_MAX_EVENTS");
+    }
+    if (!bound) ++congestion_unbound_;
+    const char* node_type = event.node_type == 0 ? "HOST" :
+                            event.node_type == 1 ? "SWITCH" :
+                            event.node_type == 2 ? "NVSWITCH" : "OTHER";
+    congestion_events_.push_back(CongestionEventRecord{
+        event_id, flow_id, scenario, CongestionEventName(event.event_type),
+        event.timestamp_ns, event.node_id, node_type, event.port_id, link_id,
+        event.has_trigger_out_port, event.trigger_out_port, trigger_link,
+        event.pg, event.has_flow, event.flow_src, event.flow_dst,
+        event.flow_sport, event.flow_dport, event.has_packet_tuple, event.packet_sip,
+        event.packet_dip, event.packet_sport, event.packet_dport,
+        event.has_queue_state, event.queue_bytes, event.has_threshold_state,
+        event.has_shared_state, event.has_headroom_state,
+        event.shared_used_bytes, event.threshold_low_bytes,
+        event.threshold_high_bytes, event.headroom_bytes,
+        event.signal_before, event.signal_after, event.pause_time,
+        event.has_rate, event.old_rate_bps, event.new_rate_bps,
+        event.cc_mode, status});
+  }
+
+  void RecordRouteChoice(const ns3::LimerRouteChoiceEvent& event) {
+    std::lock_guard<std::mutex> guard(mu_);
+    RequireEnabled("ROUTE_CHOICE");
+    if (event.evidence_overflow) {
+      WriteRouteSummary("FATAL_OVERFLOW");
+      Fail("route-choice evidence exceeded LIMER_ROUTE_CHOICE_MAX_EVENTS");
+    }
+    QpKey key{event.flow_src, event.flow_dst, event.flow_sport, event.pg};
+    auto found = states_.find(key);
+    if (found == states_.end()) {
+      Fail("live background route choice did not match a scheduled QP");
+    }
+    const FlowSpec& flow = flows_[found->second];
+    if (event.flow_dport != flow.dport ||
+        event.timestamp_ns < flow.scheduled_start_ns) {
+      Fail("live route choice tuple/time differs from schedule for flow_id=" +
+           flow.flow_id);
+    }
+
+    const bool forward = event.direction == ns3::LIMER_ROUTE_DATA;
+    const bool reverse = event.direction == ns3::LIMER_ROUTE_ACK ||
+                         event.direction == ns3::LIMER_ROUTE_NACK;
+    if ((!forward && !reverse) ||
+        (forward && event.l3_protocol != 0x11) ||
+        (event.direction == ns3::LIMER_ROUTE_ACK &&
+         event.l3_protocol != 0xFC) ||
+        (event.direction == ns3::LIMER_ROUTE_NACK &&
+         event.l3_protocol != 0xFD)) {
+      Fail("live route choice has an invalid RDMA packet direction/type");
+    }
+    const uint32_t expected_sip =
+        forward ? serverAddress[flow.src_rank].Get()
+                : serverAddress[flow.dst_rank].Get();
+    const uint32_t expected_dip =
+        forward ? serverAddress[flow.dst_rank].Get()
+                : serverAddress[flow.src_rank].Get();
+    const uint16_t expected_sport = forward ? flow.sport : flow.dport;
+    const uint16_t expected_dport = forward ? flow.dport : flow.sport;
+    if (event.packet_sip != expected_sip ||
+        event.packet_dip != expected_dip ||
+        event.packet_sport != expected_sport ||
+        event.packet_dport != expected_dport) {
+      Fail("live route choice wire tuple differs from schedule for flow_id=" +
+           flow.flow_id);
+    }
+    if (event.candidate_count == 0 ||
+        event.bucket >= event.candidate_count ||
+        event.bucket != event.ecmp_hash % event.candidate_count) {
+      Fail("live route choice has an invalid ECMP hash/bucket relation");
+    }
+    if (event.node_id >= n.GetN()) {
+      Fail("live route choice references an unknown forwarding node");
+    }
+    ns3::Ptr<ns3::Node> node = n.Get(event.node_id);
+    if (node->GetId() != event.node_id ||
+        node->GetNodeType() != event.node_type ||
+        (event.node_type != 1 && event.node_type != 2) ||
+        event.egress_port >= node->GetNDevices()) {
+      Fail("live route choice node/egress identity is invalid");
+    }
+
+    auto node_entry = nbr2if.find(node);
+    if (node_entry == nbr2if.end()) {
+      Fail("live route choice node is absent from the physical link map");
+    }
+    ns3::Ptr<ns3::Node> next_hop;
+    for (const auto& neighbor : node_entry->second) {
+      if (neighbor.second.idx != event.egress_port) continue;
+      if (next_hop != nullptr) {
+        Fail("live route choice egress maps to multiple physical neighbors");
+      }
+      next_hop = neighbor.first;
+    }
+    if (next_hop == nullptr) {
+      Fail("live route choice egress has no physical-link identity");
+    }
+    const uint32_t wire_destination =
+        ns3::LimerNodeIdFromIpv4(event.packet_dip);
+    if (next_hop->GetNodeType() == 0 &&
+        next_hop->GetId() != wire_destination) {
+      Fail("HOST transit is forbidden in a background ECMP route");
+    }
+
+    const uint32_t link_left =
+        std::min(event.node_id, next_hop->GetId());
+    const uint32_t link_right =
+        std::max(event.node_id, next_hop->GetId());
+    std::ostringstream link;
+    link << 'L' << link_left << '-' << link_right;
+    const char* packet_type =
+        event.direction == ns3::LIMER_ROUTE_DATA
+            ? "DATA"
+            : (event.direction == ns3::LIMER_ROUTE_ACK ? "ACK" : "NACK");
+    const char* node_type = event.node_type == 1 ? "SWITCH" : "NVSWITCH";
+    route_events_.push_back(RouteEventRecord{
+        flow.event_id, flow.flow_id, flow.scenario,
+        forward ? "FORWARD" : "REVERSE", packet_type, event.timestamp_ns,
+        flow.src_rank, flow.dst_rank, flow.sport, flow.dport, event.node_id,
+        node_type, event.packet_sip, event.packet_dip, event.packet_sport,
+        event.packet_dport, event.pg, event.l3_protocol, event.ecmp_seed,
+        event.ecmp_hash, event.candidate_count, event.bucket,
+        event.egress_port, next_hop->GetId(), link.str(),
+        // GetOutDev proves the selected ECMP egress.  It deliberately does
+        // not claim enqueue/transmit success and is a B1 static-FIB,
+        // fault-free, per-flow route-selection observation only.
+        "OBSERVED_ACTUAL_ROUTE_SELECTION"});
+  }
+
+  void Install(const FlowSpec& flow) {
+    ns3::RdmaClientHelper helper(
+        flow.pg, serverAddress[flow.src_rank], serverAddress[flow.dst_rank],
+        flow.sport, flow.dport, flow.bytes, flow.window, flow.base_rtt,
+        &BackgroundFlowExecutor::Noop, nullptr, 0,
+        static_cast<int>(flow.src_rank), static_cast<int>(flow.dst_rank));
+    helper.SetAttribute(
+        "LimerTrafficClass",
+        ns3::UintegerValue(ns3::LIMER_RDMA_TRAFFIC_BACKGROUND));
+    ns3::ApplicationContainer app = helper.Install(n.Get(flow.src_rank));
+    app.Start(ns3::NanoSeconds(flow.scheduled_start_ns));
+  }
