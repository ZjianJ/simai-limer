+static uint16_t allocate_training_source_port(
+    int src, int dst, uint16_t pg, const AstraSim::ncclFlowTag& flow_tag) {
+  MockNcclLog* NcclLog = MockNcclLog::getInstance();
+  if (src < 0 || dst < 0 || static_cast<uint32_t>(src) >= node_num ||
+      static_cast<uint32_t>(dst) >= node_num) {
+    training_source_ports.RecordInvariantError();
+    std::ostringstream message;
+    message << "training source-port allocator received invalid rank address: "
+            << "src=" << src << " dst=" << dst << " node_num=" << node_num;
+    NcclLog->writeLog(NcclLogLevel::ERROR, "%s", message.str().c_str());
+    std::fprintf(stderr, "LIMER-TRAINING-SPORT ERROR: %s\n",
+                 message.str().c_str());
+    std::fflush(stderr);
+    NS_ABORT_MSG(message.str());
+  }
+  #ifdef NS3_MTP
+  MtpInterface::explicitCriticalSection cs;
+  #endif
+  const limer::TrainingSourcePortAllocator::Allocation allocation =
+      training_source_ports.Reserve(
+          static_cast<uint32_t>(src), static_cast<uint32_t>(dst), pg,
+          [src, dst](uint16_t candidate) {
+            return sender_src_port_map.count(
+                       make_pair(static_cast<int>(candidate),
+                                 make_pair(src, dst))) != 0;
+          });
+  if (!allocation.ok) {
+    NcclLog->writeLog(NcclLogLevel::ERROR, "%s", allocation.error.c_str());
+    std::fprintf(stderr, "LIMER-TRAINING-SPORT ERROR: %s\n",
