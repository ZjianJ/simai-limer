+    FlushCsv(coll_stream_, coll_path_);
+    FlushCsv(alarm_stream_, alarm_path_);
+    FlushCsv(recovery_stream_, recovery_path_);
+    FlushCsv(rdma_stream_, rdma_path_);
+    FlushCsv(collective_tx_stream_, collective_tx_path_);
+    FlushCsv(fault_application_stream_, fault_application_path_);
+    FlushCsv(lifecycle_stream_, lifecycle_path_);
