+/*
+ * LIMER independent background RDMA flow executor.
+ *
+ * This intentionally does not reuse SendFlow(): that function creates Astra
+ * flowTag state and collective completion obligations.  Every row accepted
+ * here becomes one finite, ACK-completed RdmaClient/QP installed before the
+ * simulator starts and activated at its absolute scheduled_start_ns.
+ */
+#ifndef LIMER_BACKGROUND_FLOW_H
+#define LIMER_BACKGROUND_FLOW_H
+
+#include "common.h"
+#include "ns3/limer-congestion-signal.h"
+#include "ns3/limer-route-choice.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdio>
+#include <cstdint>
+#include <cstdlib>
+#include <fstream>
+#include <cmath>
+#include <limits>
+#include <map>
+#include <mutex>
+#include <set>
+#include <sstream>
+#include <string>
+#include <tuple>
+#include <vector>
+
+namespace limer {
+
+class BackgroundFlowExecutor {
+ public:
+  static BackgroundFlowExecutor& Get() {
+    static BackgroundFlowExecutor executor;
+    return executor;
+  }
+
+  // No-op when LIMER_BACKGROUND_FLOW_SCHEDULE is absent.  When it is set,
+  // every parse, topology, port-reservation, and output error terminates the
+  // run before Simulator::Run(), so a congestion run cannot silently degrade
+  // into a healthy run.
+  void Init(const std::string& run_id) {
+    if (initialized_) {
+      Fail("Init called more than once");
+    }
+    initialized_ = true;
+    const char* schedule_env = std::getenv("LIMER_BACKGROUND_FLOW_SCHEDULE");
+    if (schedule_env == nullptr) {
+      return;
+    }
+    if (*schedule_env == '\0') {
+      Fail("LIMER_BACKGROUND_FLOW_SCHEDULE is set but empty");
+    }
+
+    schedule_path_ = schedule_env;
+    run_id_ = run_id;
+    ParseSchedule();
+    ValidateNetworkContext();
+
+    const char* dir_env = std::getenv("LIMER_TELEMETRY_DIR");
+    output_path_ = std::string(dir_env ? dir_env : ".") +
+                   "/background_flow_application.csv";
+    route_output_path_ = std::string(dir_env ? dir_env : ".") +
+                         "/background_route_choices.csv";
+    route_summary_path_ = std::string(dir_env ? dir_env : ".") +
+                          "/background_route_choice_summary.csv";
+    congestion_output_path_ = std::string(dir_env ? dir_env : ".") +
+                              "/congestion_signal_events.csv";
+    congestion_summary_path_ = std::string(dir_env ? dir_env : ".") +
+                               "/congestion_signal_summary.csv";
+    const char* max_events_env = std::getenv("LIMER_CONGESTION_MAX_EVENTS");
+    if (max_events_env != nullptr) {
+      if (*max_events_env == '\0') Fail("LIMER_CONGESTION_MAX_EVENTS is empty");
+      char* end = nullptr;
+      const unsigned long long parsed = std::strtoull(max_events_env, &end, 10);
+      if (end == max_events_env || *end != '\0' || parsed == 0 ||
+          parsed > 10000000ULL) {
+        Fail("LIMER_CONGESTION_MAX_EVENTS must be an integer in [1,10000000]");
+      }
+      congestion_max_events_ = static_cast<uint64_t>(parsed);
+    }
+    const char* route_max_events_env =
+        std::getenv("LIMER_ROUTE_CHOICE_MAX_EVENTS");
+    if (route_max_events_env != nullptr) {
+      if (*route_max_events_env == '\0') {
+        Fail("LIMER_ROUTE_CHOICE_MAX_EVENTS is empty");
+      }
+      uint64_t parsed = 0;
+      for (const char* cursor = route_max_events_env; *cursor != '\0';
+           ++cursor) {
+        if (*cursor < '0' || *cursor > '9') {
+          Fail("LIMER_ROUTE_CHOICE_MAX_EVENTS must be an integer in "
+               "[1,10000000]");
+        }
+        const uint64_t digit = static_cast<uint64_t>(*cursor - '0');
+        if (parsed > (10000000ULL - digit) / 10) {
+          Fail("LIMER_ROUTE_CHOICE_MAX_EVENTS must be an integer in "
+               "[1,10000000]");
+        }
+        parsed = parsed * 10 + digit;
+      }
+      if (parsed == 0 || parsed > 10000000ULL) {
+        Fail("LIMER_ROUTE_CHOICE_MAX_EVENTS must be an integer in "
+             "[1,10000000]");
+      }
+      route_max_events_ = parsed;
+    }
+    if (output_path_ == schedule_path_) {
+      Fail("schedule path and background_flow_application.csv are identical");
+    }
+    if (route_output_path_ == schedule_path_ ||
+        route_output_path_ == output_path_) {
+      Fail("background route-choice output path aliases another artifact");
+    }
+    if (route_summary_path_ == schedule_path_ ||
+        route_summary_path_ == output_path_ ||
+        route_summary_path_ == route_output_path_) {
+      Fail("background route-choice summary path aliases another artifact");
+    }
+    PrepareOutput();
+
+    enabled_ = true;
+    for (std::size_t index = 0; index < flows_.size(); ++index) {
+      states_[MakeKey(flows_[index])] = index;
+      AppendEvent(flows_[index], "SCHEDULED", false, 0, false, 0, false, 0,
+                  "INSTALLED");
+    }
+    if (!ns3::RegisterLimerRouteChoiceSink(
+            &BackgroundFlowExecutor::RouteChoiceThunk, this,
+            route_max_events_)) {
+      Fail("could not register the live route-choice sink");
+    }
+    route_sink_registered_ = true;
+    if (!ns3::RegisterLimerCongestionSignalSink(
+            &BackgroundFlowExecutor::CongestionSignalThunk, this)) {
+      ns3::ClearLimerRouteChoiceSink(
+          &BackgroundFlowExecutor::RouteChoiceThunk, this);
+      route_sink_registered_ = false;
+      Fail("could not register the live congestion-signal sink");
+    }
+    congestion_sink_registered_ = true;
+    // Install only after the complete file has parsed and every row has been
+    // validated.  There is therefore no partial schedule on a recoverable
+    // input error.
+    for (const FlowSpec& flow : flows_) {
+      Install(flow);
+    }
+    std::fprintf(stderr,
+                 "LIMER-BACKGROUND: installed %lu real RDMA flows from %s\n",
+                 static_cast<unsigned long>(flows_.size()),
+                 schedule_path_.c_str());
+  }
+
+  // Called by RdmaClient::StartApplication only after AddQueuePair succeeds.
+  // actual_ns is simulator time, not a value inferred from telemetry.
+  void RecordStarted(uint32_t src, uint32_t dst, uint16_t sport,
+                     uint16_t dport, uint16_t pg, uint64_t actual_ns) {
+    std::lock_guard<std::mutex> guard(mu_);
+    RequireEnabled("START");
+    QpKey key{src, dst, sport, pg};
+    auto found = states_.find(key);
+    if (found == states_.end()) {
+      Fail("BACKGROUND RdmaClient START did not match the declared schedule");
+    }
+    FlowSpec& flow = flows_[found->second];
+    if (flow.dport != dport) {
+      Fail("BACKGROUND RdmaClient START dport differs from schedule for " +
+           flow.flow_id);
+    }
+    if (flow.started || flow.completed) {
+      Fail("duplicate BACKGROUND RdmaClient START for flow_id=" +
+           flow.flow_id);
+    }
+    if (actual_ns < flow.scheduled_start_ns) {
+      Fail("BACKGROUND RdmaClient started before scheduled_start_ns for " +
+           flow.flow_id);
+    }
+    flow.started = true;
+    flow.actual_start_ns = actual_ns;
+    AppendEvent(flow, "START", true, actual_ns, false, 0, false, 0,
+                "QP_CREATED");
+  }
+
+  // qp_finish calls this only for an explicitly BACKGROUND QP.  QpComplete
+  // itself is reached from ReceiveAck after snd_una covers the finite size,
+  // hence COMPLETE means ACK-complete rather than merely serialized.
+  void RecordComplete(ns3::Ptr<ns3::RdmaQueuePair> qp) {
+    if (qp == nullptr ||
+        qp->GetLimerTrafficClass() != ns3::LIMER_RDMA_TRAFFIC_BACKGROUND) {
+      Fail("RecordComplete received a null or non-background QP");
+    }
+    const uint32_t src = qp->GetSrc();
+    const uint32_t dst = qp->GetDest();
+    const uint64_t actual_ns = ns3::Simulator::Now().GetNanoSeconds();
+    const uint64_t first_tx_ns = qp->m_firstTxTimestampNs;
+    const uint64_t first_ack_ns = qp->m_firstAckProgressTimestampNs;
+
+    std::lock_guard<std::mutex> guard(mu_);
+    RequireEnabled("COMPLETE");
+    QpKey key{src, dst, qp->sport, qp->m_pg};
+    auto found = states_.find(key);
+    if (found == states_.end()) {
+      Fail("BACKGROUND QP COMPLETE did not match the declared schedule");
+    }
+    FlowSpec& flow = flows_[found->second];
+    if (flow.dport != qp->dport) {
+      Fail("BACKGROUND QP COMPLETE dport differs from schedule for " +
+           flow.flow_id);
+    }
+    if (!flow.started || flow.completed) {
+      Fail("BACKGROUND QP COMPLETE has invalid lifecycle for flow_id=" +
+           flow.flow_id);
+    }
+    if (qp->GetInitialSize() != flow.bytes ||
+        actual_ns < flow.actual_start_ns) {
+      Fail("BACKGROUND QP COMPLETE does not match declared bytes/lifecycle for " +
+           flow.flow_id);
+    }
+    if (first_ack_ns == 0 || first_ack_ns < flow.actual_start_ns ||
+        first_ack_ns > actual_ns) {
+      Fail("BACKGROUND QP ACK provenance is invalid for flow_id=" +
+           flow.flow_id);
+    }
+    if (!qp->m_hasFirstTxTimestamp || first_tx_ns < flow.actual_start_ns ||
+        first_tx_ns > first_ack_ns) {
+      Fail("BACKGROUND QP first-TX provenance is invalid for flow_id=" +
+           flow.flow_id);
+    }
+    flow.completed = true;
+    AppendEvent(flow, "COMPLETE", true, actual_ns, true, first_tx_ns, true,
+                first_ack_ns, "ACK_COMPLETE");
+  }
+
+  // Called after Simulator::Run(), when MTP workers have quiesced.  Runtime
+  // callbacks only append in-memory rows, avoiding per-flow filesystem I/O
+  // in packet-processing threads.
+  void Close() {
+    std::lock_guard<std::mutex> guard(mu_);
+    if (!enabled_ || closed_) return;
+    const bool route_cleared = route_sink_registered_ &&
+        ns3::ClearLimerRouteChoiceSink(
+            &BackgroundFlowExecutor::RouteChoiceThunk, this);
+    const bool congestion_cleared = congestion_sink_registered_ &&
+        ns3::ClearLimerCongestionSignalSink(
+            &BackgroundFlowExecutor::CongestionSignalThunk, this);
+    if (!route_cleared || !congestion_cleared) {
+      Fail("live route/congestion sink ownership changed before Close");
+    }
+    route_sink_registered_ = false;
+    congestion_sink_registered_ = false;
+    const uint64_t stop_ns = ns3::Simulator::Now().GetNanoSeconds();
+    for (const FlowSpec& flow : flows_) {
+      if (!flow.completed) {
+        // A simulator stop is not a completion.  Emit an explicit terminal
+        // record so evidence validation can reject/censor the run instead of
+        // mistaking SCHEDULED/START rows for a realized congestion sample.
+        AppendEvent(flow, "CENSORED", true, stop_ns, false, 0, false, 0,
+                    flow.started ? "STARTED_NOT_ACK_COMPLETE_AT_STOP"
+                                 : "NOT_STARTED_AT_STOP");
+      }
+    }
+    std::sort(events_.begin(), events_.end(), EventLess);
+    std::ofstream output(output_path_.c_str(),
+                         std::ios::out | std::ios::trunc);
+    if (!output.is_open()) {
+      Fail("cannot open output: " + output_path_);
+    }
+    output << Header() << '\n';
+    for (const EventRecord& event : events_) {
+      WriteEvent(output, event);
+    }
+    output.flush();
+    if (!output.good()) {
+      Fail("failed while writing output: " + output_path_);
+    }
+    output.close();
+    if (output.fail()) {
+      Fail("failed while closing output: " + output_path_);
+    }
+
+    std::sort(route_events_.begin(), route_events_.end(), RouteEventLess);
+    std::ofstream route_output(route_output_path_.c_str(),
+                               std::ios::out | std::ios::trunc);
+    if (!route_output.is_open()) {
+      Fail("cannot open output: " + route_output_path_);
+    }
+    route_output << RouteHeader() << '\n';
+    for (const RouteEventRecord& event : route_events_) {
+      WriteRouteEvent(route_output, event);
+    }
+    route_output.flush();
+    if (!route_output.good()) {
+      Fail("failed while writing output: " + route_output_path_);
+    }
+    route_output.close();
+    if (route_output.fail()) {
+      Fail("failed while closing output: " + route_output_path_);
+    }
+    const ns3::LimerRouteChoiceCounters route_counters =
+        ns3::GetLimerRouteChoiceCounters();
+    if (route_counters.max_events != route_max_events_ ||
+        route_counters.recorded != route_events_.size() ||
+        route_counters.seen != route_counters.recorded +
+                                   route_counters.deduplicated +
+                                   route_counters.overflow ||
+        route_counters.overflow != 0) {
+      WriteRouteSummary("FATAL_COUNTER_MISMATCH");
+      Fail("route-choice evidence counters are inconsistent at Close");
+    }
+    WriteRouteSummary("PASS");
+
+    std::sort(congestion_events_.begin(), congestion_events_.end(),
+              CongestionEventLess);
+    std::ofstream congestion_output(congestion_output_path_.c_str(),
+                                    std::ios::out | std::ios::trunc);
+    if (!congestion_output.is_open()) {
+      Fail("cannot open output: " + congestion_output_path_);
+    }
+    congestion_output << CongestionHeader() << '\n';
+    for (const CongestionEventRecord& event : congestion_events_) {
+      WriteCongestionEvent(congestion_output, event);
+    }
+    congestion_output.flush();
+    if (!congestion_output.good()) {
+      Fail("failed while writing output: " + congestion_output_path_);
+    }
+    congestion_output.close();
+    if (congestion_output.fail()) {
+      Fail("failed while closing output: " + congestion_output_path_);
+    }
+    WriteCongestionSummary("PASS");
+    closed_ = true;
+  }
+
+  bool Enabled() const { return enabled_; }
+
+ private:
+  struct QpKey {
+    uint32_t src;
+    uint32_t dst;
+    uint16_t sport;
+    uint16_t pg;
+
+    bool operator<(const QpKey& other) const {
+      // Mirrors RdmaHw::GetQpKey(dip,sport,pg); src identifies the host HW.
+      // dport is metadata, not part of the sender/RX-QP map identity.
+      return std::tie(src, dst, sport, pg) <
+             std::tie(other.src, other.dst, other.sport, other.pg);
+    }
+  };
+
+  struct FlowSpec {
+    std::string event_id;
+    std::string flow_id;
+    std::string scenario;
+    uint64_t scheduled_start_ns = 0;
+    uint32_t src_rank = 0;
+    uint32_t dst_rank = 0;
+    uint64_t bytes = 0;
+    uint16_t pg = 0;
+    uint16_t sport = 0;
+    uint16_t dport = 0;
+    uint32_t window = 0;
+    uint64_t base_rtt = 0;
+    bool started = false;
+    bool completed = false;
+    uint64_t actual_start_ns = 0;
+  };
+
+  struct EventRecord {
+    std::string event_id;
+    std::string flow_id;
+    std::string scenario;
+    std::string event;
+    uint64_t scheduled_start_ns;
+    bool has_actual;
+    uint64_t actual_ns;
+    bool has_first_tx;
+    uint64_t first_tx_ns;
+    bool has_first_ack;
+    uint64_t first_ack_ns;
+    uint32_t src_rank;
+    uint32_t dst_rank;
+    uint64_t bytes;
+    uint16_t pg;
+    uint16_t sport;
+    uint16_t dport;
+    std::string status;
+  };
+
+  struct RouteEventRecord {
+    std::string event_id;
+    std::string flow_id;
+    std::string scenario;
+    std::string direction;
+    std::string packet_type;
+    uint64_t timestamp_ns;
+    uint32_t flow_src_rank;
+    uint32_t flow_dst_rank;
+    uint16_t flow_sport;
+    uint16_t flow_dport;
+    uint32_t node_id;
+    std::string node_type;
+    uint32_t packet_sip;
+    uint32_t packet_dip;
+    uint16_t packet_sport;
+    uint16_t packet_dport;
+    uint16_t pg;
+    uint32_t l3_protocol;
+    uint32_t ecmp_seed;
+    uint32_t ecmp_hash;
+    uint32_t candidate_count;
+    uint32_t bucket;
+    uint32_t egress_port_id;
+    uint32_t next_hop_node_id;
+    std::string link_id;
+    std::string status;
+  };
+
+  struct CongestionEventRecord {
+    std::string event_id;
+    std::string flow_id;
+    std::string scenario;
+    std::string event_type;
+    uint64_t timestamp_ns;
+    uint32_t node_id;
+    std::string node_type;
+    uint32_t port_id;
+    std::string link_id;
+    bool has_trigger_out_port;
+    uint32_t trigger_out_port;
+    std::string trigger_link_id;
+    uint16_t pg;
+    bool has_flow;
+    uint32_t flow_src;
+    uint32_t flow_dst;
+    uint16_t flow_sport;
+    uint16_t flow_dport;
+    bool has_packet;
+    uint32_t packet_sip;
+    uint32_t packet_dip;
+    uint16_t packet_sport;
+    uint16_t packet_dport;
+    bool has_queue;
+    uint64_t queue_bytes;
+    bool has_thresholds;
+    bool has_shared;
+    bool has_headroom;
+    uint64_t shared_used_bytes;
+    uint64_t threshold_low_bytes;
+    uint64_t threshold_high_bytes;
+    uint64_t headroom_bytes;
+    uint32_t signal_before;
+    uint32_t signal_after;
+    uint32_t pause_time;
+    bool has_rate;
+    uint64_t old_rate_bps;
+    uint64_t new_rate_bps;
+    uint32_t cc_mode;
+    std::string status;
+  };
+
+  BackgroundFlowExecutor() = default;
+  BackgroundFlowExecutor(const BackgroundFlowExecutor&) = delete;
+  BackgroundFlowExecutor& operator=(const BackgroundFlowExecutor&) = delete;
+
+  static const char* Header() {
+    return "run_id,event_id,flow_id,scenario,event,scheduled_start_ns,"
+           "actual_ns,first_tx_ns,first_ack_ns,src_rank,dst_rank,bytes,pg,"
+           "sport,dport,status";
+  }
+
+  static const char* RouteHeader() {
+    return "run_id,event_id,flow_id,scenario,direction,packet_type,"
+           "timestamp_ns,flow_src_rank,flow_dst_rank,flow_sport,flow_dport,"
+           "node_id,node_type,packet_sip,packet_dip,packet_sport,"
+           "packet_dport,pg,l3_protocol,ecmp_seed,ecmp_hash,candidate_count,"
+           "bucket,egress_port_id,next_hop_node_id,link_id,status";
+  }
+
+  static const char* CongestionHeader() {
+    return "run_id,event_id,flow_id,scenario,event_type,timestamp_ns,"
+           "node_id,node_type,port_id,link_id,trigger_out_port,"
+           "trigger_link_id,pg,flow_src_rank,flow_dst_rank,flow_sport,"
+           "flow_dport,packet_sip,packet_dip,packet_sport,packet_dport,"
+           "queue_bytes,shared_used_bytes,threshold_low_bytes,"
+           "threshold_high_bytes,headroom_bytes,signal_before,signal_after,"
+           "pause_time,old_rate_bps,new_rate_bps,cc_mode,status";
+  }
+
+  static const char* CongestionSummaryHeader() {
+    return "run_id,window_start_ns,window_end_ns,max_events,seen,recorded,"
+           "unbound,filtered,overflow,status";
+  }
+
+  static const char* RouteSummaryHeader() {
+    return "run_id,max_events,seen,recorded,deduplicated,overflow,status";
+  }
+
+  static QpKey MakeKey(const FlowSpec& flow) {
+    return QpKey{flow.src_rank, flow.dst_rank, flow.sport, flow.pg};
+  }
+
+  static void Fail(const std::string& reason) {
+    std::fprintf(stderr, "LIMER-BACKGROUND: fatal: %s\n", reason.c_str());
+    std::fflush(stderr);
+    std::exit(2);
+  }
+
+  void RequireEnabled(const char* event) const {
+    if (!enabled_) {
+      Fail(std::string("received ") + event +
+           " while no background schedule is enabled");
+    }
+  }
+
+  static bool ValidId(const std::string& value) {
+    if (value.empty() || value.size() > 128) return false;
+    for (char c : value) {
+      const unsigned char u = static_cast<unsigned char>(c);
+      if (!(std::isalnum(u) || c == '_' || c == '-' || c == '.' ||
+            c == ':')) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+  static bool ValidScenario(const std::string& value) {
+    // These names select corpus semantics only.  The background executor does
+    // not synthesize ECN marks or PFC pause frames from a label; pressure must
+    // arise from the real queues/MMU on the scheduled RDMA path.
+    return value == "incast" || value == "queue_buildup" ||
+           value == "ecmp_collision" || value == "ecn_pressure" ||
+           value == "pfc_pressure";
+  }
+
+  static std::vector<std::string> SplitCsv(const std::string& line) {
+    std::vector<std::string> fields;
+    std::size_t begin = 0;
+    while (true) {
+      const std::size_t comma = line.find(',', begin);
+      if (comma == std::string::npos) {
+        fields.push_back(line.substr(begin));
+        return fields;
+      }
+      fields.push_back(line.substr(begin, comma - begin));
+      begin = comma + 1;
+    }
+  }
+
+  static uint64_t ParseUnsigned(const std::string& text,
+                                const std::string& field, uint64_t maximum,
+                                uint64_t line_number) {
+    if (text.empty()) {
+      Fail("line " + U(line_number) + ": empty " + field);
+    }
+    uint64_t value = 0;
+    for (char c : text) {
+      if (c < '0' || c > '9') {
+        Fail("line " + U(line_number) + ": non-decimal " + field);
+      }
+      const uint64_t digit = static_cast<uint64_t>(c - '0');
+      if (digit > maximum || value > (maximum - digit) / 10) {
+        Fail("line " + U(line_number) + ": overflowing " + field);
+      }
+      value = value * 10 + digit;
+    }
+    return value;
+  }
+
+  static std::string U(uint64_t value) {
+    std::ostringstream stream;
+    stream << value;
+    return stream.str();
+  }
+
+  void ParseSchedule() {
+    std::ifstream input(schedule_path_.c_str());
+    if (!input.is_open()) {
+      Fail("cannot open schedule: " + schedule_path_);
+    }
+    std::string line;
+    if (!std::getline(input, line)) {
+      Fail("schedule is empty: " + schedule_path_);
+    }
+    if (!line.empty() && line.back() == '\r') line.pop_back();
+    const std::string expected =
+        "event_id,flow_id,scenario,scheduled_start_ns,src_rank,dst_rank,"
+        "bytes,pg,sport,dport";
+    if (line != expected) {
+      Fail("schedule header must be exactly: " + expected);
+    }
+
+    std::set<std::string> flow_ids;
+    std::set<QpKey> qp_keys;
+    uint64_t line_number = 1;
+    while (std::getline(input, line)) {
+      ++line_number;
+      if (!line.empty() && line.back() == '\r') line.pop_back();
+      if (line.empty()) {
+        Fail("line " + U(line_number) + ": blank rows are forbidden");
+      }
+      const std::vector<std::string> fields = SplitCsv(line);
+      if (fields.size() != 10) {
+        Fail("line " + U(line_number) + ": expected exactly 10 CSV fields");
+      }
+      FlowSpec flow;
+      flow.event_id = fields[0];
+      flow.flow_id = fields[1];
+      flow.scenario = fields[2];
+      if (!ValidId(flow.event_id) || !ValidId(flow.flow_id)) {
+        Fail("line " + U(line_number) +
+             ": event_id/flow_id contains unsupported characters");
+      }
+      if (!ValidScenario(flow.scenario)) {
+        Fail("line " + U(line_number) +
+             ": unsupported background RDMA scenario label");
+      }
+      flow.scheduled_start_ns = ParseUnsigned(
+          fields[3], "scheduled_start_ns",
+          static_cast<uint64_t>(std::numeric_limits<int64_t>::max()),
+          line_number);
+      flow.src_rank = static_cast<uint32_t>(ParseUnsigned(
+          fields[4], "src_rank", std::numeric_limits<uint32_t>::max(),
+          line_number));
+      flow.dst_rank = static_cast<uint32_t>(ParseUnsigned(
+          fields[5], "dst_rank", std::numeric_limits<uint32_t>::max(),
+          line_number));
+      flow.bytes = ParseUnsigned(fields[6], "bytes",
+                                 std::numeric_limits<uint64_t>::max(),
+                                 line_number);
+      flow.pg = static_cast<uint16_t>(ParseUnsigned(
+          fields[7], "pg", std::numeric_limits<uint16_t>::max(), line_number));
+      flow.sport = static_cast<uint16_t>(ParseUnsigned(
+          fields[8], "sport", std::numeric_limits<uint16_t>::max(),
+          line_number));
+      flow.dport = static_cast<uint16_t>(ParseUnsigned(
+          fields[9], "dport", std::numeric_limits<uint16_t>::max(),
+          line_number));
+
+      if (flow.bytes == 0) {
+        Fail("line " + U(line_number) + ": bytes must be non-zero");
+      }
+      if (flow.pg == 0 || flow.pg > 7) {
+        Fail("line " + U(line_number) + ": pg must be in [1,7]");
+      }
+      if (flow.sport < ns3::LIMER_BACKGROUND_SPORT_MIN ||
+          flow.sport > ns3::LIMER_BACKGROUND_SPORT_MAX) {
+        Fail("line " + U(line_number) +
+             ": sport is outside reserved background interval [49152,65535]");
+      }
+      if (flow.dport == 0) {
+        Fail("line " + U(line_number) + ": dport must be non-zero");
+      }
+      if (!flow_ids.insert(flow.flow_id).second) {
+        Fail("line " + U(line_number) + ": duplicate flow_id=" +
+             flow.flow_id);
+      }
+      if (!qp_keys.insert(MakeKey(flow)).second) {
+        Fail("line " + U(line_number) +
+             ": duplicate (src,dst,sport,pg) RDMA QP identity");
+      }
+      flows_.push_back(flow);
+      if (flows_.size() > 65536) {
+        Fail("schedule exceeds the 65536-flow safety limit");
+      }
+    }
+    if (input.bad()) {
+      Fail("I/O error while reading schedule: " + schedule_path_);
+    }
+    if (flows_.empty()) {
+      Fail("schedule contains no background flow rows");
+    }
+  }
+
+  void ValidateNetworkContext() {
+    if (gpus_per_server == 0) {
+      Fail("gpus_per_server is zero");
+    }
+    if (node_num < switch_num + nvswitch_num) {
+      Fail("node counts are inconsistent");
+    }
+    const uint32_t gpu_count = node_num - switch_num - nvswitch_num;
+    if (gpu_count == 0 || n.GetN() < gpu_count ||
+        serverAddress.size() < gpu_count) {
+      Fail("true GPU nodes/addresses are not initialized");
+    }
+    if (!std::isfinite(simulator_stop_time) || simulator_stop_time < 0.0 ||
+        simulator_stop_time >
+            static_cast<double>(std::numeric_limits<uint64_t>::max()) / 1e9) {
+      Fail("simulator_stop_time cannot define a congestion evidence window");
+    }
+    congestion_window_start_ns_ = flows_.front().scheduled_start_ns;
+    for (const FlowSpec& flow : flows_) {
+      congestion_window_start_ns_ =
+          std::min(congestion_window_start_ns_, flow.scheduled_start_ns);
+    }
+    congestion_window_end_ns_ =
+        static_cast<uint64_t>(simulator_stop_time * 1e9);
+    if (congestion_window_end_ns_ < congestion_window_start_ns_) {
+      Fail("background schedule starts after the configured simulator stop");
+    }
+    for (FlowSpec& flow : flows_) {
+      if (flow.src_rank >= gpu_count || flow.dst_rank >= gpu_count ||
+          flow.src_rank == flow.dst_rank) {
+        Fail("flow_id=" + flow.flow_id +
+             " has invalid source/destination GPU rank");
+      }
+      if (flow.src_rank > static_cast<uint32_t>(
+                              std::numeric_limits<int>::max()) ||
+          flow.dst_rank > static_cast<uint32_t>(
+                              std::numeric_limits<int>::max())) {
+        Fail("flow_id=" + flow.flow_id +
+             " rank cannot be represented by RdmaClientHelper");
+      }
+      if (flow.src_rank / gpus_per_server ==
+          flow.dst_rank / gpus_per_server) {
+        Fail("flow_id=" + flow.flow_id +
+             " is intra-server; congestion background must traverse the fabric");
+      }
+
+      uint64_t window = 0;
+      if (has_win) {
+        if (global_t == 1) {
+          window = maxBdp;
+        } else {
+          auto source = pairBdp.find(n.Get(flow.src_rank));
+          if (source == pairBdp.end()) {
+            Fail("missing pairBdp source for flow_id=" + flow.flow_id);
+          }
+          auto destination = source->second.find(n.Get(flow.dst_rank));
+          if (destination == source->second.end()) {
+            Fail("missing pairBdp destination for flow_id=" + flow.flow_id);
+          }
+          window = destination->second;
+        }
+        if (window > std::numeric_limits<uint32_t>::max()) {
+          Fail("RDMA window exceeds uint32 for flow_id=" + flow.flow_id);
+        }
+      }
+      flow.window = static_cast<uint32_t>(window);
+
+      if (global_t == 1) {
+        flow.base_rtt = maxRtt;
+      } else {
+        auto source = pairRtt.find(flow.src_rank);
+        if (source == pairRtt.end()) {
+          Fail("missing pairRtt source for flow_id=" + flow.flow_id);
+        }
+        auto destination = source->second.find(flow.dst_rank);
+        if (destination == source->second.end()) {
+          Fail("missing pairRtt destination for flow_id=" + flow.flow_id);
+        }
+        flow.base_rtt = destination->second;
+      }
+      if (flow.base_rtt == 0) {
+        Fail("base RTT is zero for flow_id=" + flow.flow_id);
+      }
+    }
+  }
